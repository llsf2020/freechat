@@ -580,6 +580,24 @@ impl Room {
         Ok(())
     }
 
+    /// FreeChat: erase events from this device only, without telling the
+    /// server (e.g. disappearing messages the server has already deleted).
+    ///
+    /// In the event cache, in memory and on disk, each event and its edits
+    /// and reactions keep only their ID, type, sender and time; timelines show
+    /// them like redacted events. Events the cache doesn't know are skipped.
+    pub async fn erase_events_locally(&self, event_ids: Vec<String>) -> Result<(), ClientError> {
+        let event_ids =
+            event_ids.into_iter().map(EventId::parse).collect::<Result<Vec<_>, _>>()?;
+        let client = self.inner.client();
+        let Some(event_cache) = client.event_cache() else {
+            return Ok(());
+        };
+        let (room_event_cache, _drop_handles) = event_cache.room(self.inner.room_id()).await?;
+        room_event_cache.erase_events_locally(&event_ids).await?;
+        Ok(())
+    }
+
     pub fn active_members_count(&self) -> u64 {
         self.inner.active_members_count()
     }
