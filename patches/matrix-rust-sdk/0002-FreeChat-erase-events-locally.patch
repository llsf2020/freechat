+#[async_test]
+async fn test_erase_events_locally() {
+    let server = MatrixMockServer::new().await;
+
+    let state_memory_store = matrix_sdk_base::store::MemoryStore::new();
+    let event_cache_store = Arc::new(MemoryStore::new());
+    let store_config = StoreConfig::new(CrossProcessLockConfig::multi_process("hodlor"))
+        .state_store(state_memory_store)
+        .event_cache_store(event_cache_store);
+    let client = server
+        .client_builder()
+        .on_builder(|builder| builder.store_config(store_config.clone()))
+        .build()
+        .await;
+
+    let room_id = room_id!("!omelette:fromage.fr");
+    let f = EventFactory::new().room(room_id).sender(user_id!("@a:b.c"));
+
+    // A message, its edit, a reaction to it, and another message.
+    server
+        .sync_room(
+            &client,
+            JoinedRoomBuilder::new(room_id)
+                .add_timeline_event(f.text_msg("secret one").event_id(event_id!("$1")))
+                .add_timeline_event(
+                    f.text_msg("* secret two")
+                        .edit(
+                            event_id!("$1"),
+                            RoomMessageEventContentWithoutRelation::text_plain("secret two"),
+                        )
+                        .event_id(event_id!("$2")),
+                )
+                .add_timeline_event(
+                    f.reaction(event_id!("$1"), "secret three").event_id(event_id!("$3")),
+                )
+                .add_timeline_event(f.text_msg("kept").event_id(event_id!("$4"))),
+        )
+        .await;
+
+    let (room_event_cache, _drop_handles) =
+        client.event_cache().unwrap().room(room_id).await.unwrap();
+
+    let (events, mut subscriber) = room_event_cache.subscribe().await.unwrap();
+    if events.is_empty() {
+        assert_let_timeout!(
+            Ok(RoomEventCacheUpdate::UpdateTimelineEvents(TimelineVectorDiffs { .. })) =
+                subscriber.recv()
+        );
+    }
+
+    room_event_cache.erase_events_locally(&[event_id!("$1").to_owned()]).await.unwrap();
+
+    // Observers are told about the three replaced events.
+    assert_let_timeout!(
+        Ok(RoomEventCacheUpdate::UpdateTimelineEvents(TimelineVectorDiffs { diffs, .. })) =
+            subscriber.recv()
+    );
+    assert_eq!(diffs.len(), 3);
+    for diff in &diffs {
+        assert_let!(VectorDiff::Set { value, .. } = diff);
+        assert!(value.raw().json().get().contains("secret").not());
+    }
+
+    let check = |events: Vec<TimelineEvent>| {
+        assert_eq!(events.len(), 4);
+        for event in &events[..3] {
+            let ev = event.raw().cast_ref_unchecked::<AnySyncMessageLikeEvent>();
+            assert!(ev.deserialize().unwrap().is_redacted());
+            assert!(ev.json().get().contains("secret").not());
+        }
+        assert_event_matches_msg(&events[3], "kept");
+    };
+    check(room_event_cache.events().await.unwrap());
+
+    // The store has the erased events too.
+    drop(room_event_cache);
+    drop(_drop_handles);
+    drop(client);
+
+    let client = server
+        .client_builder()
+        .on_builder(|builder| builder.store_config(store_config))
+        .build()
+        .await;
+    let (cache, _drop_handles) = client.event_cache().unwrap().room(room_id).await.unwrap();
+    check(cache.events().await.unwrap());
+}
