+    /// FreeChat: erase events from this room's cache, in memory and in the
+    /// store, without telling the server (e.g. disappearing messages the
+    /// server has already deleted).
+    ///
+    /// Each event, and its edits and reactions, is replaced by its redacted
+    /// form, as a plain event: only its ID, type, sender and time remain, so
+    /// it is shown like a redacted event. Thread and pinned-event caches
+    /// loaded in memory keep their copy until they are reloaded.
+    #[must_use = "Propagate `VectorDiff` updates via `TimelineVectorDiffs`"]
+    pub async fn erase_events_locally(
+        &mut self,
+        event_ids: &[OwnedEventId],
+    ) -> Result<Vec<VectorDiff<Event>>, EventCacheError> {
+        let mut targets = Vec::new();
+
+        for event_id in event_ids {
+            if let Some(found) = self.find_event(event_id).await? {
+                targets.push(found);
+            }
+
+            let relations = find_event_relations(
+                event_id,
+                &self.room_id,
+                Some(vec![RelationType::Replacement, RelationType::Annotation]),
+                &self.room_linked_chunk,
+                &self.store,
+            )
+            .await?;
+
+            for relation in relations {
+                if let Some(relation_id) = relation.event_id()
+                    && let Some(found) = self.find_event(relation_id).await?
+                {
+                    targets.push(found);
+                }
+            }
+        }
+
+        for (location, event) in targets {
+            let Some(event_id) = event.event_id() else { continue };
+
+            // Only kept as `unsigned.redacted_because`, so that the event is
+            // seen as redacted.
+            let redaction = serde_json::json!({
+                "type": "m.room.redaction",
+                "event_id": format!("$freechat-erased-{event_id}"),
+                "sender": self.state.own_user_id,
+                "origin_server_ts": MilliSecondsSinceUnixEpoch::now(),
+                "redacts": event_id,
+                "content": { "redacts": event_id },
+            });
+            let redaction = Raw::new(&redaction).expect("JSON is serializable").cast_unchecked();
+
+            let Some(redacted) =
+                apply_redaction(event.raw(), &redaction, &self.room_version_rules.redaction)
+            else {
+                error!(%event_id, "could not erase an event locally");
+                continue;
+            };
+
+            self.replace_event_at(location, Event::from_plaintext(redacted)).await?;
+        }
+
+        self.update_read_receipts(None).await?;
+
+        Ok(self.room_linked_chunk_mut().updates_as_vector_diffs())
+    }
+
     /// If the given event is a redaction, try to retrieve the to-be-redacted
     /// event in the chunk, and replace it by the redacted form.
     #[instrument(skip_all)]
