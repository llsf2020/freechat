+    /// FreeChat: erase events from this room's cache, in memory and in the
+    /// store, without telling the server. Each event, and its edits and
+    /// reactions, keeps only its ID, type, sender and time, and is shown like
+    /// a redacted event.
+    pub async fn erase_events_locally(&self, event_ids: &[OwnedEventId]) -> Result<()> {
+        let mut state = self.inner.state.write().await?;
+        let diffs = state.erase_events_locally(event_ids).await?;
+
+        if !diffs.is_empty() {
+            self.inner.update_sender.send(
+                RoomEventCacheUpdate::UpdateTimelineEvents(TimelineVectorDiffs {
+                    diffs,
+                    origin: EventsOrigin::Cache,
+                }),
+                Some(RoomEventCacheGenericUpdate { room_id: self.inner.room_id.clone() }),
+            );
+        }
+
+        Ok(())
+    }
+
