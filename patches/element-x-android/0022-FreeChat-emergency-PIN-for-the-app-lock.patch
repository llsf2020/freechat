+package io.element.android.features.lockscreen.impl.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.features.lockscreen.impl.biometric.FakeBiometricAuthenticatorManager
+import io.element.android.features.lockscreen.impl.fixtures.aPinCodeManager
+import io.element.android.features.lockscreen.impl.pin.storage.InMemoryLockScreenStore
+import io.element.android.features.lockscreen.impl.unlock.PinUnlockEvent
+import io.element.android.features.lockscreen.impl.unlock.PinUnlockHelper
+import io.element.android.features.lockscreen.impl.unlock.PinUnlockPresenter
+import io.element.android.features.lockscreen.impl.unlock.keypad.PinKeypadModel
+import io.element.android.features.logout.test.FakeLogoutUseCase
+import io.element.android.libraries.architecture.AsyncData
+import io.element.android.tests.testutils.lambda.assert
+import io.element.android.tests.testutils.lambda.lambdaRecorder
+import io.element.android.tests.testutils.test
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+
+class EmergencyPinTest {
+    private val store = InMemoryLockScreenStore()
+    private val pinCodeManager = aPinCodeManager(lockScreenStore = store)
+
+    @Test
+    fun `the emergency PIN needs a PIN, its length and another value`() = runTest {
+        assertThat(pinCodeManager.setEmergencyPinCode("9999")).isFalse()
+        pinCodeManager.createPinCode(PIN)
+        assertThat(pinCodeManager.setEmergencyPinCode(PIN)).isFalse()
+        assertThat(pinCodeManager.setEmergencyPinCode("999")).isFalse()
+        assertThat(pinCodeManager.hasEmergencyPinCode().first()).isFalse()
+
+        assertThat(pinCodeManager.setEmergencyPinCode(EMERGENCY)).isTrue()
+        assertThat(pinCodeManager.hasEmergencyPinCode().first()).isTrue()
+        assertThat(pinCodeManager.isEmergencyPinCode(EMERGENCY)).isTrue()
+        assertThat(pinCodeManager.isEmergencyPinCode(PIN)).isFalse()
+        // Stored encrypted, like the PIN.
+        assertThat(store.getEncryptedEmergencyCode()).doesNotContain(EMERGENCY)
+    }
+
+    @Test
+    fun `removing the PIN or the emergency PIN removes the emergency PIN`() = runTest {
+        pinCodeManager.createPinCode(PIN)
+        pinCodeManager.setEmergencyPinCode(EMERGENCY)
+        assertThat(pinCodeManager.setEmergencyPinCode(null)).isTrue()
+        assertThat(pinCodeManager.isEmergencyPinCode(EMERGENCY)).isFalse()
+
+        pinCodeManager.setEmergencyPinCode(EMERGENCY)
+        pinCodeManager.deletePinCode()
+        assertThat(pinCodeManager.hasEmergencyPinCode().first()).isFalse()
+        assertThat(pinCodeManager.isEmergencyPinCode(EMERGENCY)).isFalse()
+    }
+
+    @Test
+    fun `unlocking with the emergency PIN signs out at once, without counting a wrong PIN`() = runTest {
+        pinCodeManager.createPinCode(PIN)
+        pinCodeManager.setEmergencyPinCode(EMERGENCY)
+        val logout = lambdaRecorder<Boolean, Unit> {}
+        val biometric = FakeBiometricAuthenticatorManager()
+        val presenter = PinUnlockPresenter(
+            forDeviceUnlock = false,
+            pinCodeManager = pinCodeManager,
+            biometricAuthenticatorManager = biometric,
+            logoutUseCase = FakeLogoutUseCase(logout),
+            coroutineScope = this,
+            pinUnlockHelper = PinUnlockHelper(biometric, pinCodeManager),
+        )
+        val attempts = store.getRemainingPinCodeAttemptsNumber()
+        presenter.test {
+            var state = awaitItem()
+            while (state.pinEntry !is AsyncData.Success) state = awaitItem()
+            EMERGENCY.forEach { state.eventSink(PinUnlockEvent.OnPinKeypadPressed(PinKeypadModel.Number(it))) }
+            // Until the sign-out finishes; the turbine fails the test if it never does.
+            while (state.signOutAction.isUninitialized() || state.signOutAction.isLoading()) state = awaitItem()
+            assertThat(state.isUnlocked).isFalse()
+            assertThat(state.showSignOutPrompt).isFalse()
+            cancelAndIgnoreRemainingEvents()
+        }
+        assert(logout).isCalledOnce()
+        assertThat(store.getRemainingPinCodeAttemptsNumber()).isEqualTo(attempts)
+    }
+
+    private companion object {
+        const val PIN = "1235"
+        const val EMERGENCY = "9871"
+    }
+}
