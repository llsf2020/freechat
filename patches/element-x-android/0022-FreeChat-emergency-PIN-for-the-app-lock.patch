+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.designsystem.components.preferences.PreferenceDivider
+import io.element.android.libraries.designsystem.theme.components.ListItem
+import io.element.android.libraries.designsystem.theme.components.ListItemStyle
+import io.element.android.libraries.designsystem.theme.components.Text
+import io.element.android.libraries.matrix.ui.freechat.PasswordDialog
+import io.element.android.libraries.ui.strings.CommonStrings
+import kotlinx.coroutines.launch
+
+data class EmergencyPinState(
+    val hasEmergencyPin: Boolean,
+    /** Digits of the PIN, which the emergency PIN must have too; null without a PIN. */
+    val pinSize: Int?,
+    val showDialog: Boolean,
+    val showInvalid: Boolean,
+    val eventSink: (EmergencyPinEvent) -> Unit,
+)
+
+sealed interface EmergencyPinEvent {
+    data object Edit : EmergencyPinEvent
+    data class Submit(val pin: String) : EmergencyPinEvent
+    data object Dismiss : EmergencyPinEvent
+    data object Remove : EmergencyPinEvent
+}
+
+/**
+ * FreeChat: the emergency PIN of the app lock. Entered instead of the PIN, it signs out of every account and erases
+ * this device's data at once, for when someone forces the user to unlock the app.
+ */
+@Inject
+class EmergencyPinPresenter(
+    private val pinCodeManager: PinCodeManager,
+) : Presenter<EmergencyPinState> {
+    @Composable
+    override fun present(): EmergencyPinState {
+        val scope = rememberCoroutineScope()
+        val hasEmergencyPin by remember { pinCodeManager.hasEmergencyPinCode() }.collectAsState(initial = false)
+        val pinSize by produceState<Int?>(initialValue = null) { value = pinCodeManager.getPinCodeSize() }
+        var showDialog by remember { mutableStateOf(false) }
+        var showInvalid by remember { mutableStateOf(false) }
+
+        fun handleEvent(event: EmergencyPinEvent) {
+            when (event) {
+                EmergencyPinEvent.Edit -> {
+                    showInvalid = false
+                    showDialog = true
+                }
+                is EmergencyPinEvent.Submit -> scope.launch {
+                    if (pinCodeManager.setEmergencyPinCode(event.pin)) {
+                        showDialog = false
+                    } else {
+                        showInvalid = true
+                    }
+                }
+                EmergencyPinEvent.Dismiss -> showDialog = false
+                EmergencyPinEvent.Remove -> scope.launch { pinCodeManager.setEmergencyPinCode(null) }
+            }
+        }
+
+        return EmergencyPinState(
+            hasEmergencyPin = hasEmergencyPin,
+            pinSize = pinSize,
+            showDialog = showDialog,
+            showInvalid = showInvalid,
+            eventSink = ::handleEvent,
+        )
+    }
+}
+
+/** FreeChat: the emergency PIN items of the app lock settings. */
+@Composable
+fun EmergencyPinView(state: EmergencyPinState) {
+    val pinSize = state.pinSize ?: return
+    PreferenceDivider()
+    ListItem(
+        supportingContent = { Text(stringResource(CommonStrings.freechat_emergency_pin_description)) },
+        onClick = { state.eventSink(EmergencyPinEvent.Edit) },
+    ) {
+        Text(
+            stringResource(
+                if (state.hasEmergencyPin) CommonStrings.freechat_emergency_pin_change else CommonStrings.freechat_emergency_pin_set
+            )
+        )
+    }
+    if (state.hasEmergencyPin) {
+        ListItem(
+            style = ListItemStyle.Destructive,
+            onClick = { state.eventSink(EmergencyPinEvent.Remove) },
+        ) {
+            Text(stringResource(CommonStrings.freechat_emergency_pin_remove))
+        }
+    }
+    if (state.showDialog) {
+        PasswordDialog(
+            title = stringResource(CommonStrings.freechat_emergency_pin_title),
+            label = stringResource(CommonStrings.freechat_emergency_pin_label, pinSize),
+            submitText = stringResource(CommonStrings.action_save),
+            onSubmit = { state.eventSink(EmergencyPinEvent.Submit(it)) },
+            onDismissRequest = { state.eventSink(EmergencyPinEvent.Dismiss) },
+            error = if (state.showInvalid) stringResource(CommonStrings.freechat_emergency_pin_invalid, pinSize) else null,
+            minLength = pinSize,
+            keyboardType = KeyboardType.NumberPassword,
+        )
+    }
+}
