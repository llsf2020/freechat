         secretKeyRepository.deleteKey(SECRET_KEY_ALIAS)
         callbacks.forEach { it.onPinCodeRemoved() }
@@ -101,4 +102,35 @@ class DefaultPinCodeManager(
     override suspend fun getRemainingPinCodeAttemptsNumber(): Int {
         return lockScreenStore.getRemainingPinCodeAttemptsNumber()
     }
+
+    // FreeChat: the emergency PIN, encrypted with the PIN's key, so it goes when the PIN goes.
+    override fun hasEmergencyPinCode(): Flow<Boolean> = lockScreenStore.hasEmergencyCode()
+
+    override suspend fun setEmergencyPinCode(pinCode: String?): Boolean {
+        if (pinCode == null) {
+            lockScreenStore.saveEncryptedEmergencyCode(null)
+            return true
+        }
+        val pin = decrypt(lockScreenStore.getEncryptedCode()) ?: return false
+        val candidate = pinCode.toByteArray()
+        if (candidate.size != pin.size || candidate.contentEquals(pin)) return false
+        val secretKey = secretKeyRepository.getOrCreateKey(SECRET_KEY_ALIAS, false)
+        lockScreenStore.saveEncryptedEmergencyCode(encryptionDecryptionService.encrypt(secretKey, candidate).toBase64())
+        return true
+    }
+
+    override suspend fun isEmergencyPinCode(pinCode: String): Boolean {
+        val emergency = decrypt(lockScreenStore.getEncryptedEmergencyCode()) ?: return false
+        return emergency.contentEquals(pinCode.toByteArray())
+    }
+
+    private suspend fun decrypt(encrypted: String?): ByteArray? {
+        encrypted ?: return null
+        return try {
+            val secretKey = secretKeyRepository.getOrCreateKey(SECRET_KEY_ALIAS, false)
+            encryptionDecryptionService.decrypt(secretKey, EncryptionResult.fromBase64(encrypted))
+        } catch (_: Throwable) {
+            null
+        }
+    }
 }
