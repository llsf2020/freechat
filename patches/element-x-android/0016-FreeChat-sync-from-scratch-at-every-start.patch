From 61a757a9539f00380145c2fdfbc8f3e9db6c7bbc Mon Sep 17 00:00:00 2001
From: sjcsf <346224915+llsf2020@users.noreply.github.com>
Date: Fri, 23 Oct 2026 00:00:00 +0000
Subject: [PATCH 16/19] FreeChat: sync from scratch at every start

The sync position is no longer kept across processes, so every start gets each
room's latest event again: room list previews are only kept in memory, and the
event cache is dropped at start.
---
 .../android/libraries/matrix/impl/RustMatrixClientFactory.kt | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/libraries/matrix/impl/src/main/kotlin/io/element/android/libraries/matrix/impl/RustMatrixClientFactory.kt b/libraries/matrix/impl/src/main/kotlin/io/element/android/libraries/matrix/impl/RustMatrixClientFactory.kt
index ece2120cb1..b2b06cb179 100644
--- a/libraries/matrix/impl/src/main/kotlin/io/element/android/libraries/matrix/impl/RustMatrixClientFactory.kt
+++ b/libraries/matrix/impl/src/main/kotlin/io/element/android/libraries/matrix/impl/RustMatrixClientFactory.kt
@@ -131,8 +131,11 @@ class RustMatrixClientFactory(
 
         client.setUtdDelegate(UtdTracker(analyticsService))
 
+        // FreeChat: the sync position is not kept across processes, so every start syncs from scratch and gets
+        // each room's latest event again. Room list previews are only kept in memory (patched Rust SDK), and the
+        // event cache is dropped at start (deleteMessageCaches).
         val syncService = client.syncService()
-            .withSharePos(true)
+            .withSharePos(false)
             .withOfflineMode()
             .finish()
 
