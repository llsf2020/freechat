+package io.element.android.features.roomdetails.impl.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.freechat.Disappearing
+import io.element.android.libraries.matrix.test.AN_EXCEPTION
+import io.element.android.libraries.matrix.test.A_ROOM_ID
+import io.element.android.libraries.matrix.test.FakeMatrixClient
+import io.element.android.libraries.matrix.test.room.FakeJoinedRoom
+import io.element.android.tests.testutils.consumeItemsUntilPredicate
+import io.element.android.tests.testutils.test
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+
+class ReadBurnPresenterTest {
+    /** A client whose `com.freechat.disappearing` account data lives in [content]. */
+    private class AccountDataClient(
+        var stored: String?,
+        private val saveResult: Result<Unit> = Result.success(Unit),
+    ) : MatrixClient by FakeMatrixClient() {
+        override suspend fun getAccountData(eventType: String): Result<String?> = Result.success(stored)
+
+        override suspend fun setAccountData(eventType: String, content: String): Result<Unit> =
+            saveResult.onSuccess { stored = content }
+    }
+
+    private val roomId = A_ROOM_ID.value
+
+    @Test
+    fun `present - loads the default and this chat's override`() = runTest {
+        val client = AccountDataClient("""{"read_ttl":30,"rooms":{"$roomId":5}}""")
+        ReadBurnPresenter(FakeJoinedRoom(), client).test {
+            val state = consumeItemsUntilPredicate { it.isLoaded }.last()
+            assertThat(state.defaultTtl).isEqualTo(30)
+            assertThat(state.override).isEqualTo(5)
+            assertThat(state.effectiveTtl).isEqualTo(5)
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - setting an override keeps the default and other chats`() = runTest {
+        val client = AccountDataClient("""{"read_ttl":30,"rooms":{"!other:x":0}}""")
+        ReadBurnPresenter(FakeJoinedRoom(), client).test {
+            consumeItemsUntilPredicate { it.isLoaded }.last().eventSink(ReadBurnEvent.SetOverride(0))
+            val state = consumeItemsUntilPredicate { !it.isSaving && it.override == 0L }.last()
+            assertThat(state.defaultTtl).isEqualTo(30)
+            assertThat(Disappearing.parsePersonal(client.stored)).isEqualTo(
+                Disappearing.Personal(30, mapOf("!other:x" to 0L, roomId to 0L)),
+            )
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - following the default removes the override`() = runTest {
+        val client = AccountDataClient("""{"read_ttl":30,"rooms":{"$roomId":5}}""")
+        ReadBurnPresenter(FakeJoinedRoom(), client).test {
+            consumeItemsUntilPredicate { it.isLoaded }.last().eventSink(ReadBurnEvent.SetOverride(null))
+            val state = consumeItemsUntilPredicate { !it.isSaving && it.override == null }.last()
+            assertThat(state.effectiveTtl).isEqualTo(30)
+            assertThat(Disappearing.parsePersonal(client.stored).rooms).isEmpty()
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - save failure shows an error`() = runTest {
+        val client = AccountDataClient(null, saveResult = Result.failure(AN_EXCEPTION))
+        ReadBurnPresenter(FakeJoinedRoom(), client).test {
+            consumeItemsUntilPredicate { it.isLoaded }.last().eventSink(ReadBurnEvent.SetOverride(5))
+            val failed = consumeItemsUntilPredicate { it.hasError }.last()
+            assertThat(failed.override).isNull()
+            failed.eventSink(ReadBurnEvent.ClearError)
+            assertThat(consumeItemsUntilPredicate { !it.hasError }.last().hasError).isFalse()
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+}
