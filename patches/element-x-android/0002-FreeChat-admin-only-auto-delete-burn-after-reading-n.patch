+        aGlobalReadBurnState(ttl = 30),
+        aGlobalReadBurnState(ttl = 30, showDialog = true),
+        aGlobalReadBurnState(isLoaded = false),
+        aGlobalReadBurnState(hasError = true),
+    )
+}
+
+internal fun aGlobalReadBurnState(
+    ttl: Long = 0,
+    isLoaded: Boolean = true,
+    isSaving: Boolean = false,
+    showDialog: Boolean = false,
+    hasError: Boolean = false,
+    eventSink: (GlobalReadBurnEvent) -> Unit = {},
+) = GlobalReadBurnState(
