+import org.junit.Test
+
+class GlobalReadBurnPresenterTest {
+    private class AccountDataClient(
+        var stored: String?,
+        private val saveResult: Result<Unit> = Result.success(Unit),
+    ) : MatrixClient by FakeMatrixClient() {
+        override suspend fun getAccountData(eventType: String): Result<String?> = Result.success(stored)
+
+        override suspend fun setAccountData(eventType: String, content: String): Result<Unit> =
+            saveResult.onSuccess { stored = content }
+    }
+
+    @Test
+    fun `present - loads the default, off when unset`() = runTest {
+        GlobalReadBurnPresenter(AccountDataClient(null)).test {
+            val state = consumeItemsUntilPredicate { it.isLoaded }.last()
+            assertThat(state.ttl).isEqualTo(0)
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - changing the default keeps per-chat overrides`() = runTest {
+        val client = AccountDataClient("""{"read_ttl":5,"rooms":{"!a:x":0}}""")
+        GlobalReadBurnPresenter(client).test {
+            consumeItemsUntilPredicate { it.isLoaded && it.ttl == 5L }.last().eventSink(GlobalReadBurnEvent.SetTtl(60))
+            consumeItemsUntilPredicate { !it.isSaving && it.ttl == 60L }
+            assertThat(Disappearing.parsePersonal(client.stored)).isEqualTo(Disappearing.Personal(60, mapOf("!a:x" to 0L)))
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - save failure shows an error and keeps the old value`() = runTest {
+        GlobalReadBurnPresenter(AccountDataClient("""{"read_ttl":5}""", Result.failure(AN_EXCEPTION))).test {
+            consumeItemsUntilPredicate { it.isLoaded }.last().eventSink(GlobalReadBurnEvent.SetTtl(30))
+            val failed = consumeItemsUntilPredicate { it.hasError }.last()
+            assertThat(failed.ttl).isEqualTo(5)
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+}
