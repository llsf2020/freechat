+        val content = parseObject(contentJson).orEmpty()
+        val rooms = (content["rooms"] as? JsonObject).orEmpty().toMutableMap()
+        if (ttl == null) rooms.remove(roomId) else rooms[roomId] = JsonPrimitive(ttl.coerceAtLeast(0))
+        return JsonObject(content + ("rooms" to JsonObject(rooms))).toString()
+    }
