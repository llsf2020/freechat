+/** FreeChat: settings section for my default burn-after-read delay. */
+@Composable
+fun GlobalReadBurnSection(
+    state: GlobalReadBurnState,
+    modifier: Modifier = Modifier,
+) {
+    PreferenceCategory(modifier = modifier, title = stringResource(CommonStrings.freechat_burn_title)) {
+        ListItem(
+            leadingContent = ListItemContent.Icon(IconSource.Vector(CompoundIcons.VisibilityOff())),
+            content = { Text(stringResource(CommonStrings.freechat_burn_title)) },
+            supportingContent = { Text(readTtlLabel(state.ttl)) },
+            enabled = state.isLoaded && !state.isSaving,
+            onClick = { state.eventSink(GlobalReadBurnEvent.OpenDialog) },
+        )
+    }
+
+    if (state.showDialog) {
+        val presets = Disappearing.READ_TTL_PRESETS
+        val choices = if (state.ttl in presets) presets else presets + state.ttl
+        SingleSelectionDialog(
+            title = stringResource(CommonStrings.freechat_burn_title),
+            subtitle = stringResource(CommonStrings.freechat_burn_description),
+            options = choices.map { ListOption(readTtlLabel(it)) }.toImmutableList(),
+            initialSelection = choices.indexOf(state.ttl),
+            onSelectOption = { index -> state.eventSink(GlobalReadBurnEvent.SetTtl(choices[index])) },
+            onDismissRequest = { state.eventSink(GlobalReadBurnEvent.CloseDialog) },
+        )
+    }
+
+    if (state.hasError) {
+        ErrorDialog(
+            content = stringResource(CommonStrings.freechat_burn_error),
+            onSubmit = { state.eventSink(GlobalReadBurnEvent.ClearError) },
+        )
+    }
+}
+
