+package io.element.android.libraries.matrix.ui.freechat
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.res.pluralStringResource
+import androidx.compose.ui.res.stringResource
+import io.element.android.libraries.matrix.api.freechat.Disappearing
+import io.element.android.libraries.ui.strings.CommonPlurals
+import io.element.android.libraries.ui.strings.CommonStrings
+
+/** FreeChat: human-readable room auto-delete TTL, preferring the preset labels. */
+@Composable
+fun disappearingLabel(ttl: Long): String = durationLabel(Disappearing.describe(ttl))
+
+/** FreeChat: human-readable burn-after-read delay. */
+@Composable
+fun readTtlLabel(ttl: Long): String = durationLabel(Disappearing.describeReadTtl(ttl))
+
+@Composable
+private fun durationLabel(duration: Disappearing.Duration): String = when (duration) {
+    Disappearing.Duration.Off -> stringResource(CommonStrings.freechat_disappearing_off)
+    is Disappearing.Duration.Preset -> stringResource(PRESET_LABELS[duration.index])
+    is Disappearing.Duration.Days -> plural(CommonPlurals.freechat_disappearing_days, duration.count)
+    is Disappearing.Duration.Hours -> plural(CommonPlurals.freechat_disappearing_hours, duration.count)
+    is Disappearing.Duration.Minutes -> plural(CommonPlurals.freechat_disappearing_minutes, duration.count)
+    is Disappearing.Duration.Seconds -> plural(CommonPlurals.freechat_disappearing_seconds, duration.count)
+}
+
+@Composable
+private fun plural(id: Int, count: Long): String = pluralStringResource(id, count.toInt(), count)
+
+private val PRESET_LABELS = listOf(
+    CommonStrings.freechat_disappearing_off,
+    CommonStrings.freechat_disappearing_hour,
+    CommonStrings.freechat_disappearing_day,
+    CommonStrings.freechat_disappearing_week,
+    CommonStrings.freechat_disappearing_month,
+)
