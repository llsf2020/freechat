+import org.junit.Test
+
+class HideDeletedMessagesTest {
+    private val text = aTimelineItemEvent()
+    private val deleted = aTimelineItemEvent(content = TimelineItemRedactedContent)
+
+    @Test
+    fun `deleted messages are hidden`() {
+        assertThat(hideDeletedMessages(listOf(text, deleted))).containsExactly(text)
+    }
+
+    @Test
+    fun `deleted thread roots stay`() {
+        val root = aTimelineItemEvent(
+            content = TimelineItemRedactedContent,
+            threadInfo = TimelineItemThreadInfo.ThreadRoot(
+                summary = ThreadSummary(latestEvent = AsyncData.Uninitialized, numberOfReplies = 1),
+                latestEventText = null
+            ),
+        )
+        assertThat(hideDeletedMessages(listOf(root))).containsExactly(root)
+    }
+
+    @Test
+    fun `groups are filtered, dropped when empty, and kept as is when untouched`() {
+        val allDeleted = TimelineItem.GroupedEvents(UniqueId("g1"), persistentListOf(deleted, deleted), persistentListOf())
+        assertThat(hideDeletedMessages(listOf(allDeleted))).isEmpty()
+
+        val mixed = TimelineItem.GroupedEvents(UniqueId("g2"), persistentListOf(text, deleted), persistentListOf())
+        assertThat((hideDeletedMessages(listOf(mixed)).single() as TimelineItem.GroupedEvents).events).containsExactly(text)
+
+        val untouched = TimelineItem.GroupedEvents(UniqueId("g3"), persistentListOf(text), persistentListOf())
+        assertThat(hideDeletedMessages(listOf(untouched)).single()).isSameInstanceAs(untouched)
+    }
+}
