+
+class DisappearingPersonalTest {
+    @Test
+    fun `parsePersonal - reads default and room overrides, dropping invalid values`() {
+        val personal = Disappearing.parsePersonal("""{"read_ttl":30,"rooms":{"!a:x":0,"!b:x":"5","!c:x":-1,"!d:x":60}}""")
+        assertThat(personal.readTtl).isEqualTo(30)
+        assertThat(personal.rooms).containsExactly("!a:x", 0L, "!d:x", 60L)
+        assertThat(personal.roomOverride("!a:x")).isEqualTo(0)
+        assertThat(personal.roomOverride("!z:x")).isNull()
+    }
+
+    @Test
+    fun `parsePersonal - missing or broken content is off`() {
+        assertThat(Disappearing.parsePersonal(null)).isEqualTo(Disappearing.Personal())
+        assertThat(Disappearing.parsePersonal("nope")).isEqualTo(Disappearing.Personal())
+    }
+
+    @Test
+    fun `withGlobalReadTtl - keeps overrides and unknown fields`() {
+        val updated = Disappearing.withGlobalReadTtl("""{"read_ttl":5,"rooms":{"!a:x":0},"extra":true}""", 60)
+        assertThat(Disappearing.parsePersonal(updated)).isEqualTo(Disappearing.Personal(60, mapOf("!a:x" to 0L)))
+        assertThat(updated).contains("\"extra\":true")
+    }
+
+    @Test
+    fun `withRoomReadTtl - sets and clears one room`() {
+        val set = Disappearing.withRoomReadTtl("""{"read_ttl":30}""", "!a:x", 5)
+        assertThat(Disappearing.parsePersonal(set)).isEqualTo(Disappearing.Personal(30, mapOf("!a:x" to 5L)))
+        val cleared = Disappearing.withRoomReadTtl(set, "!a:x", null)
+        assertThat(Disappearing.parsePersonal(cleared)).isEqualTo(Disappearing.Personal(30))
+    }
+
+    @Test
+    fun `describeReadTtl - largest whole unit`() {
+        assertThat(Disappearing.describeReadTtl(0)).isEqualTo(Disappearing.Duration.Off)
+        assertThat(Disappearing.describeReadTtl(5)).isEqualTo(Disappearing.Duration.Seconds(5))
+        assertThat(Disappearing.describeReadTtl(300)).isEqualTo(Disappearing.Duration.Minutes(5))
