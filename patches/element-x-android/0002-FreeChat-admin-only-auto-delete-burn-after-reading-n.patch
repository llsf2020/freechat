+
+/** FreeChat: room details entry for this chat's burn-after-read override. */
+@Composable
+fun ReadBurnItem(
+    state: ReadBurnState,
+    modifier: Modifier = Modifier,
+) {
+    val followDefault = stringResource(CommonStrings.freechat_burn_follow_default, readTtlLabel(state.defaultTtl))
+    ListItem(
+        modifier = modifier,
+        leadingContent = ListItemContent.Icon(IconSource.Vector(CompoundIcons.VisibilityOff())),
+        content = { Text(stringResource(CommonStrings.freechat_burn_room_title)) },
+        supportingContent = { Text(if (state.override == null) followDefault else readTtlLabel(state.override)) },
+        enabled = state.isLoaded && !state.isSaving,
+        onClick = { state.eventSink(ReadBurnEvent.OpenDialog) },
+    )
+
+    if (state.showDialog) {
+        // null = follow the default; a non-preset override set elsewhere still shows as selected.
+        val presets = Disappearing.READ_TTL_PRESETS
+        val choices: List<Long?> = listOf<Long?>(null) + presets + listOfNotNull(state.override?.takeUnless { it in presets })
+        val options = choices.map { ListOption(if (it == null) followDefault else readTtlLabel(it)) }.toImmutableList()
+        SingleSelectionDialog(
+            title = stringResource(CommonStrings.freechat_burn_room_title),
+            subtitle = stringResource(CommonStrings.freechat_burn_description),
+            options = options,
+            initialSelection = choices.indexOf(state.override),
+            onSelectOption = { index -> state.eventSink(ReadBurnEvent.SetOverride(choices[index])) },
+            onDismissRequest = { state.eventSink(ReadBurnEvent.CloseDialog) },
+        )
+    }
+
+    if (state.hasError) {
+        ErrorDialog(
+            content = stringResource(CommonStrings.freechat_burn_error),
+            onSubmit = { state.eventSink(ReadBurnEvent.ClearError) },
+        )
+    }
+}
+
+internal class ReadBurnStateProvider : PreviewParameterProvider<ReadBurnState> {
+    override val values = sequenceOf(
+        aReadBurnState(),
+        aReadBurnState(defaultTtl = 30),
+        aReadBurnState(defaultTtl = 30, override = 0),
+        aReadBurnState(defaultTtl = 30, override = 5, showDialog = true),
+        aReadBurnState(isLoaded = false),
+        aReadBurnState(hasError = true),
+    )
+}
+
+internal fun aReadBurnState(
+    defaultTtl: Long = 0,
+    override: Long? = null,
+    isLoaded: Boolean = true,
+    isSaving: Boolean = false,
+    showDialog: Boolean = false,
+    hasError: Boolean = false,
+    eventSink: (ReadBurnEvent) -> Unit = {},
+) = ReadBurnState(
+    defaultTtl = defaultTtl,
+    override = override,
+    isLoaded = isLoaded,
+    isSaving = isSaving,
+    showDialog = showDialog,
+    hasError = hasError,
+    eventSink = eventSink,
+)
+
+@PreviewsDayNight
+@Composable
+internal fun ReadBurnItemPreview(@PreviewParameter(ReadBurnStateProvider::class) state: ReadBurnState) =
+    ElementPreview {
+        ReadBurnItem(state)
+    }
