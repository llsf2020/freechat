+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.freechat.Disappearing
+import io.element.android.libraries.matrix.api.room.JoinedRoom
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+/** FreeChat: this chat's burn-after-read override for my own messages. */
+@Inject
+class ReadBurnPresenter(
+    private val room: JoinedRoom,
+    private val client: MatrixClient,
+) : Presenter<ReadBurnState> {
+    @Composable
+    override fun present(): ReadBurnState {
+        val scope = rememberCoroutineScope()
+        var personal by remember { mutableStateOf<Disappearing.Personal?>(null) }
+        var showDialog by remember { mutableStateOf(false) }
+        var isSaving by remember { mutableStateOf(false) }
+        var hasError by remember { mutableStateOf(false) }
+        val roomId = room.roomId.value
+
+        LaunchedEffect(Unit) {
+            client.getAccountData(Disappearing.STATE_TYPE)
+                .onSuccess { personal = Disappearing.parsePersonal(it) }
+                .onFailure { Timber.e(it, "FreeChat: failed to load burn-after-read settings") }
+        }
+
+        fun save(override: Long?) = scope.launch {
+            isSaving = true
+            // Re-read so a change made on another device is not overwritten.
+            client.getAccountData(Disappearing.STATE_TYPE)
+                .mapCatching { latest ->
+                    val updated = Disappearing.withRoomReadTtl(latest, roomId, override)
+                    client.setAccountData(Disappearing.STATE_TYPE, updated).getOrThrow()
+                    updated
+                }
+                .onSuccess { personal = Disappearing.parsePersonal(it) }
+                .onFailure {
+                    Timber.e(it, "FreeChat: failed to save burn-after-read for $roomId")
+                    hasError = true
+                }
+            isSaving = false
+        }
+
+        fun handleEvent(event: ReadBurnEvent) {
+            when (event) {
+                ReadBurnEvent.OpenDialog -> showDialog = true
+                ReadBurnEvent.CloseDialog -> showDialog = false
+                ReadBurnEvent.ClearError -> hasError = false
+                is ReadBurnEvent.SetOverride -> {
+                    showDialog = false
+                    if (event.ttl != personal?.roomOverride(roomId)) save(event.ttl)
+                }
+            }
+        }
+
+        return ReadBurnState(
+            defaultTtl = personal?.readTtl ?: 0,
+            override = personal?.roomOverride(roomId),
+            isLoaded = personal != null,
+            isSaving = isSaving,
+            showDialog = showDialog,
+            hasError = hasError,
+            eventSink = ::handleEvent,
+        )
+    }
+}
+
+data class ReadBurnState(
+    /** My default delay in seconds, zero when off. */
+    val defaultTtl: Long,
+    /** This chat's delay, or null when it follows [defaultTtl]. */
+    val override: Long?,
+    val isLoaded: Boolean,
+    val isSaving: Boolean,
+    val showDialog: Boolean,
+    val hasError: Boolean,
+    val eventSink: (ReadBurnEvent) -> Unit,
+) {
+    val effectiveTtl: Long get() = override ?: defaultTtl
+}
+
+sealed interface ReadBurnEvent {
+    data object OpenDialog : ReadBurnEvent
+    data object CloseDialog : ReadBurnEvent
+    data object ClearError : ReadBurnEvent
+
+    /** Sets this chat's delay; null follows the default. */
+    data class SetOverride(val ttl: Long?) : ReadBurnEvent
+}
