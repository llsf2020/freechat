+/** IDs of the events [hideExpired] hides. */
+internal fun goneEventIds(
+    items: List<TimelineItem>,
+    now: Long,
+    purged: Set<EventId>,
+    markersOf: (TimelineItem.Event) -> ExpiryMarkers,
+): Set<EventId> =
+    items.events().filter { it.isGone(now, purged, markersOf) }.mapNotNull { it.eventId }.toSet()
+
+private fun TimelineItem.Event.isGone(now: Long, purged: Set<EventId>, markersOf: (TimelineItem.Event) -> ExpiryMarkers): Boolean {
+    if (eventId in purged) return true
+    val expiresAt = markersOf(this).expiresAt
+    return expiresAt != null && expiresAt <= now
+}
