+ */
+
+package io.element.android.appnav.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.matrix.api.freechat.StrictModeSettings
+import io.element.android.libraries.matrix.test.A_SESSION_ID
+import io.element.android.libraries.matrix.test.FakeMatrixClient
+import io.element.android.libraries.matrix.test.freechat.FakeStrictModeStore
+import io.element.android.libraries.sessionstorage.api.StrictSessions
+import io.element.android.libraries.sessionstorage.test.InMemorySessionStore
+import io.element.android.libraries.sessionstorage.test.aSessionData
+import io.element.android.services.appnavstate.test.FakeAppForegroundStateService
+import io.element.android.services.toolbox.test.systemclock.FakeSystemClock
+import kotlinx.coroutines.test.TestScope
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Duration.Companion.seconds
+
+class StrictSessionGuardTest {
+    private val foreground = FakeAppForegroundStateService(initialForegroundValue = true)
+    private val clock = FakeSystemClock(epochMillisResult = 0)
+    private var logouts = 0
+    private val client = FakeMatrixClient(sessionId = A_SESSION_ID).apply { logoutLambda = { _, _ -> logouts++ } }
+
+    private fun TestScope.startGuard(strict: Boolean) {
+        val path = if (strict) "/files/${StrictSessions.DIR_PREFIX}1" else "/files/1"
+        StrictSessionGuard(
+            client = client,
+            sessionStore = InMemorySessionStore(listOf(aSessionData(sessionId = A_SESSION_ID.value, sessionPath = path))),
+            strictModeStore = FakeStrictModeStore(StrictModeSettings(enabled = true, idleMinutes = 5)),
+            appForegroundStateService = foreground,
+            systemClock = clock,
+            sessionCoroutineScope = backgroundScope,
+        ).start()
+        runCurrent()
+    }
+
+    @Test
+    fun `signs a strict session out after the idle time in the background`() = runTest {
+        startGuard(strict = true)
+        foreground.givenIsInForeground(false)
+        advanceTimeBy(4.minutes)
+        foreground.givenIsInForeground(true)
+        advanceTimeBy(10.minutes)
+        assertThat(logouts).isEqualTo(0)
+
+        foreground.givenIsInForeground(false)
+        advanceTimeBy(5.minutes + 10.seconds)
+        assertThat(logouts).isEqualTo(1)
+    }
+
+    @Test
+    fun `signs out at once when coming back after the idle time on the wall clock`() = runTest {
+        startGuard(strict = true)
+        foreground.givenIsInForeground(false)
+        runCurrent()
+        clock.epochMillisResult = 6.minutes.inWholeMilliseconds // the device slept: timers did not run
+        foreground.givenIsInForeground(true)
+        advanceTimeBy(10.seconds)
+        assertThat(logouts).isEqualTo(1)
+    }
+
+    @Test
+    fun `stays signed in during a call`() = runTest {
+        startGuard(strict = true)
+        foreground.updateIsInCallState(true)
+        foreground.givenIsInForeground(false)
+        advanceTimeBy(30.minutes)
+        assertThat(logouts).isEqualTo(0)
+    }
+
+    @Test
+    fun `leaves normal sessions alone`() = runTest {
+        startGuard(strict = false)
+        foreground.givenIsInForeground(false)
+        advanceTimeBy(60.minutes)
+        assertThat(logouts).isEqualTo(0)
+    }
+}
