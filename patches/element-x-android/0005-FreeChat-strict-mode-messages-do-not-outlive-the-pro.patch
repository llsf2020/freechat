+/*
+ * Copyright 2026 FreeChat contributors
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.matrix.api.freechat
+
+import io.element.android.libraries.sessionstorage.api.StrictSessions
+import kotlinx.coroutines.flow.Flow
+import java.security.SecureRandom
+
+/**
+ * FreeChat strict mode: a per-device choice to leave nothing readable on the device.
+ *
+ * A session signed in while strict mode is on:
+ * - is never written to the session database: it lives in memory only (see [StrictSessions]);
+ * - keeps its SDK stores in a session directory marked with [STRICT_SESSION_DIR_PREFIX], encrypted with a
+ *   random key that only ever exists in memory. Once the process dies the files are unreadable, and they are
+ *   deleted on the next start;
+ * - signs out after [StrictModeSettings.idleMinutes] in the background;
+ * - for password sign-ins, uses a device ID of the form `FCS<minutes>_<random>`, which the homeserver
+ *   deletes once it has been idle for that long. This covers a process that was killed before it could sign out.
+ */
+object StrictMode {
+    const val STRICT_SESSION_DIR_PREFIX = StrictSessions.DIR_PREFIX
+    const val STRICT_DEVICE_PREFIX = "FCS"
+    const val DEFAULT_IDLE_MINUTES = 5
+    val IDLE_PRESETS_MINUTES = listOf(1, 5, 15, 30, 60)
+
+    fun deviceId(idleMinutes: Int, random: SecureRandom = SecureRandom()): String {
+        val bytes = ByteArray(8).also(random::nextBytes)
+        return "$STRICT_DEVICE_PREFIX${idleMinutes}_" + bytes.joinToString("") { "%02x".format(it) }
+    }
+}
+
+data class StrictModeSettings(
+    val enabled: Boolean = false,
+    val idleMinutes: Int = StrictMode.DEFAULT_IDLE_MINUTES,
+)
+
+/** The device's strict mode choice. It says nothing about the user, so it is kept on disk. */
+interface StrictModeStore {
+    val settings: Flow<StrictModeSettings>
+    suspend fun get(): StrictModeSettings
+    suspend fun set(settings: StrictModeSettings)
+}
