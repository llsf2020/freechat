+ */
+
+package io.element.android.appnav.freechat
+
+import dev.zacsweers.metro.Inject
+import io.element.android.libraries.di.annotations.SessionCoroutineScope
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.freechat.StrictModeStore
+import io.element.android.libraries.sessionstorage.api.SessionStore
+import io.element.android.libraries.sessionstorage.api.StrictSessions
+import io.element.android.services.appnavstate.api.AppForegroundStateService
+import io.element.android.services.toolbox.api.systemclock.SystemClock
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import kotlin.time.Duration.Companion.minutes
+
+/**
+ * FreeChat strict mode: signs a strict session out once the app has been in the background for the chosen time.
+ *
+ * Time in the background is measured on the wall clock as well, because timers do not run while the device
+ * sleeps or the process is frozen: coming back after the idle time signs out at once. A process that is killed
+ * outright cannot sign out; the homeserver then deletes the device (see `StrictMode.deviceId`).
+ */
+@Inject
+class StrictSessionGuard(
+    private val client: MatrixClient,
+    private val sessionStore: SessionStore,
+    private val strictModeStore: StrictModeStore,
+    private val appForegroundStateService: AppForegroundStateService,
+    private val systemClock: SystemClock,
+    @SessionCoroutineScope private val sessionCoroutineScope: CoroutineScope,
+) {
+    fun start() {
+        sessionCoroutineScope.launch {
+            val session = sessionStore.getSession(client.sessionId.value) ?: return@launch
+            if (!StrictSessions.isStrict(session)) return@launch
+            Timber.i("FreeChat: strict session, signing out after time in the background")
+            var backgroundSince: Long? = null
+            combine(appForegroundStateService.isInForeground, appForegroundStateService.isInCall) { foreground, inCall ->
+                foreground || inCall
+            }
+                .distinctUntilChanged()
+                .collectLatest { active ->
+                    val idleMillis = strictModeStore.get().idleMinutes.minutes.inWholeMilliseconds
+                    if (active) {
+                        val since = backgroundSince
+                        backgroundSince = null
+                        if (since != null && systemClock.epochMillis() - since >= idleMillis) signOut()
+                    } else {
+                        backgroundSince = systemClock.epochMillis()
+                        delay(idleMillis)
+                        signOut()
+                    }
+                }
+        }
+    }
+
+    private suspend fun signOut() {
+        Timber.i("FreeChat: strict session idle in the background, signing out")
+        client.logout(userInitiated = true, ignoreSdkError = true)
+    }
+}
