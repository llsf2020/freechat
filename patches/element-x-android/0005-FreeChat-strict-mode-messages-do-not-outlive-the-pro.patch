+
+package io.element.android.libraries.sessionstorage.impl
+
+import app.cash.sqldelight.driver.jdbc.sqlite.JdbcSqliteDriver
+import app.cash.turbine.test
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.core.coroutine.CoroutineDispatchers
+import io.element.android.libraries.sessionstorage.api.LoggedInState
+import io.element.android.libraries.sessionstorage.api.StrictSessions
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.test.UnconfinedTestDispatcher
+import kotlinx.coroutines.test.runTest
+import org.junit.Before
+import org.junit.Test
+
+/** FreeChat strict mode: strict sessions are served like any other but never reach the database. */
+class StrictSessionStoreTest {
+    private lateinit var database: SessionDatabase
+    private lateinit var store: DatabaseSessionStore
+
+    private val normal = aDbSessionData().toApiModel()
+    private val strict = aDbSessionData().toApiModel().copy(
+        userId = "@strict:server",
+        sessionPath = "/data/files/${StrictSessions.DIR_PREFIX}1234",
+        accessToken = "strict-token",
+    )
+
+    @OptIn(ExperimentalCoroutinesApi::class)
+    @Before
+    fun setup() {
+        val driver = JdbcSqliteDriver(JdbcSqliteDriver.IN_MEMORY)
+        SessionDatabase.Schema.create(driver)
+        database = SessionDatabase(driver)
+        store = DatabaseSessionStore(
+            database = database,
+            dispatchers = CoroutineDispatchers(
+                io = UnconfinedTestDispatcher(),
+                computation = UnconfinedTestDispatcher(),
+                main = UnconfinedTestDispatcher(),
+            )
+        )
+    }
+
+    @Test
+    fun `a strict session is never written to the database`() = runTest {
+        store.addSession(strict)
+        store.updateData(strict.copy(accessToken = "refreshed"))
+        store.updateUserProfile(strict.userId, "Alice", null)
+
+        assertThat(database.sessionDataQueries.selectAll().executeAsList()).isEmpty()
+        val session = store.getSession(strict.userId)!!
+        assertThat(session.accessToken).isEqualTo("refreshed")
+        assertThat(session.userDisplayName).isEqualTo("Alice")
+    }
+
+    @Test
+    fun `strict and normal sessions are listed together`() = runTest {
+        store.addSession(normal)
+        store.addSession(strict)
+
+        assertThat(store.getAllSessions().map { it.userId }).containsExactly(normal.userId, strict.userId)
+        assertThat(store.numberOfSessions()).isEqualTo(2)
+        assertThat(store.getLatestSession()?.userId).isEqualTo(strict.userId)
+        assertThat(database.sessionDataQueries.selectAll().executeAsList().map { it.userId }).containsExactly(normal.userId)
+
+        store.setLatestSession(normal.userId)
+        assertThat(store.getLatestSession()?.userId).isEqualTo(normal.userId)
+    }
+
+    @Test
+    fun `logged in state follows strict sessions`() = runTest {
+        store.loggedInStateFlow().test {
+            assertThat(awaitItem()).isEqualTo(LoggedInState.NotLoggedIn)
+            store.addSession(strict)
+            assertThat(awaitItem()).isEqualTo(LoggedInState.LoggedIn(sessionId = strict.userId, isTokenValid = true))
+            store.removeSession(strict.userId)
+            assertThat(awaitItem()).isEqualTo(LoggedInState.NotLoggedIn)
+        }
+    }
+
+    @Test
+    fun `sessions flow includes strict sessions`() = runTest {
+        store.sessionsFlow().test {
+            assertThat(awaitItem()).isEmpty()
+            store.addSession(strict)
+            assertThat(awaitItem().map { it.userId }).containsExactly(strict.userId)
+        }
+    }
+
+    @Test
+    fun `strict session paths are recognised`() {
+        assertThat(StrictSessions.isStrictPath("/data/files/${StrictSessions.DIR_PREFIX}abc")).isTrue()
+        assertThat(StrictSessions.isStrictPath("/data/files/${StrictSessions.DIR_PREFIX}abc/")).isTrue()
+        assertThat(StrictSessions.isStrictPath("/data/files/abc")).isFalse()
+        assertThat(StrictSessions.isStrictPath("/data/${StrictSessions.DIR_PREFIX}x/abc")).isFalse()
+    }
+}
