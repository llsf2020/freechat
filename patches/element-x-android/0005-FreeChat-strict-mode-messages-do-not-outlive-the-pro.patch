+
+private val enabledKey = booleanPreferencesKey("enabled")
+private val idleMinutesKey = intPreferencesKey("idle_minutes")
+
+@SingleIn(AppScope::class)
+@ContributesBinding(AppScope::class)
+class DataStoreStrictModeStore(
+    preferenceDataStoreFactory: PreferenceDataStoreFactory,
+) : StrictModeStore {
+    private val store = preferenceDataStoreFactory.create("freechat_strict_mode")
+
+    override val settings: Flow<StrictModeSettings> = store.data.map { prefs ->
+        StrictModeSettings(
+            enabled = prefs[enabledKey] ?: false,
+            idleMinutes = prefs[idleMinutesKey]?.takeIf { it > 0 } ?: StrictMode.DEFAULT_IDLE_MINUTES,
+        )
+    }
+
+    override suspend fun get(): StrictModeSettings = settings.first()
+
+    override suspend fun set(settings: StrictModeSettings) {
+        store.edit { prefs ->
+            prefs[enabledKey] = settings.enabled
+            prefs[idleMinutesKey] = settings.idleMinutes.takeIf { it > 0 } ?: StrictMode.DEFAULT_IDLE_MINUTES
+        }
+    }
+}
