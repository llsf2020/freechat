+package io.element.android.features.preferences.impl.freechat
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import dev.zacsweers.metro.Inject
+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.freechat.StrictModeSettings
+import io.element.android.libraries.matrix.api.freechat.StrictModeStore
+import io.element.android.libraries.sessionstorage.api.SessionStore
+import io.element.android.libraries.sessionstorage.api.StrictSessions
+import kotlinx.coroutines.launch
+
+/** FreeChat: the strict mode switch. See `StrictMode`. */
+@Inject
+class StrictModePresenter(
+    private val client: MatrixClient,
+    private val sessionStore: SessionStore,
+    private val strictModeStore: StrictModeStore,
+) : Presenter<StrictModeState> {
+    @Composable
+    override fun present(): StrictModeState {
+        val scope = rememberCoroutineScope()
+        val settings by strictModeStore.settings.collectAsState(initial = StrictModeSettings())
+        var isStrictSession by remember { mutableStateOf(false) }
+        var dialog by remember { mutableStateOf(StrictModeDialog.None) }
+
+        LaunchedEffect(Unit) {
+            isStrictSession = sessionStore.getSession(client.sessionId.value)?.let(StrictSessions::isStrict) == true
+        }
+
+        fun handleEvent(event: StrictModeEvent) {
+            when (event) {
+                StrictModeEvent.AskToEnable -> dialog = StrictModeDialog.ConfirmEnable
+                StrictModeEvent.ChooseIdleTime -> dialog = StrictModeDialog.IdleTime
+                StrictModeEvent.CloseDialog -> dialog = StrictModeDialog.None
+                StrictModeEvent.Enable -> {
+                    dialog = StrictModeDialog.None
+                    scope.launch { strictModeStore.set(settings.copy(enabled = true)) }
+                }
+                StrictModeEvent.Disable -> scope.launch { strictModeStore.set(settings.copy(enabled = false)) }
+                is StrictModeEvent.SetIdleMinutes -> {
+                    dialog = StrictModeDialog.None
+                    scope.launch { strictModeStore.set(settings.copy(idleMinutes = event.minutes)) }
+                }
+            }
+        }
+
+        return StrictModeState(
+            enabled = settings.enabled,
+            idleMinutes = settings.idleMinutes,
+            isStrictSession = isStrictSession,
+            dialog = dialog,
+            eventSink = ::handleEvent,
+        )
+    }
+}
+
+enum class StrictModeDialog { None, ConfirmEnable, IdleTime }
+
+data class StrictModeState(
+    /** Strict mode is chosen for the next sign-in on this device. */
+    val enabled: Boolean,
+    val idleMinutes: Int,
+    /** The current session was signed in with strict mode on. */
+    val isStrictSession: Boolean,
+    val dialog: StrictModeDialog,
+    val eventSink: (StrictModeEvent) -> Unit,
+)
+
+sealed interface StrictModeEvent {
+    data object AskToEnable : StrictModeEvent
+    data object ChooseIdleTime : StrictModeEvent
+    data object CloseDialog : StrictModeEvent
+
+    /** Turns strict mode on; the view then starts the sign-out, since it applies from the next sign-in. */
+    data object Enable : StrictModeEvent
+    data object Disable : StrictModeEvent
+    data class SetIdleMinutes(val minutes: Int) : StrictModeEvent
+}
