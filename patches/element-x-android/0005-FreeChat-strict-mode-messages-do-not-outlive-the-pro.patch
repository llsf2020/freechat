     override suspend fun removeSession(sessionId: String) {
         withContext(dispatchers.io) {
             sessionDataMutex.withLock {
+                strictSessions.update { it - sessionId }
                 database.sessionDataQueries.removeSession(sessionId)
             }
         }
diff --git a/libraries/session-storage/impl/src/test/kotlin/io/element/android/libraries/sessionstorage/impl/StrictSessionStoreTest.kt b/libraries/session-storage/impl/src/test/kotlin/io/element/android/libraries/sessionstorage/impl/StrictSessionStoreTest.kt
