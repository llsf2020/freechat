+
+/**
+ * FreeChat: settings section for strict mode.
+ *
+ * @param onSignOut starts the app's normal sign-out, which warns when the keys are not backed up.
+ */
+@Composable
+fun StrictModeSection(
+    state: StrictModeState,
+    onSignOut: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    PreferenceCategory(modifier = modifier, title = stringResource(CommonStrings.freechat_strict_title)) {
+        ListItem(
+            leadingContent = ListItemContent.Icon(IconSource.Vector(CompoundIcons.Shield())),
+            content = { Text(stringResource(CommonStrings.freechat_strict_switch)) },
+            supportingContent = {
+                Text(
+                    stringResource(
+                        when {
+                            state.isStrictSession && !state.enabled -> CommonStrings.freechat_strict_off_pending
+                            state.isStrictSession -> CommonStrings.freechat_strict_on
+                            else -> CommonStrings.freechat_strict_description
+                        }
+                    )
+                )
+            },
+            trailingContent = ListItemContent.Switch(checked = state.isStrictSession && state.enabled),
+            onClick = {
+                when {
+                    state.isStrictSession && state.enabled -> state.eventSink(StrictModeEvent.Disable)
+                    else -> state.eventSink(StrictModeEvent.AskToEnable)
+                }
+            },
+        )
+        if (state.isStrictSession && state.enabled) {
+            ListItem(
+                leadingContent = ListItemContent.Icon(IconSource.Vector(CompoundIcons.Time())),
+                content = { Text(stringResource(CommonStrings.freechat_strict_idle)) },
+                supportingContent = { Text(readTtlLabel(state.idleMinutes * 60L)) },
+                onClick = { state.eventSink(StrictModeEvent.ChooseIdleTime) },
+            )
+        }
+    }
+
+    when (state.dialog) {
+        StrictModeDialog.None -> Unit
+        StrictModeDialog.ConfirmEnable -> ConfirmationDialog(
+            title = stringResource(CommonStrings.freechat_strict_confirm_title),
+            content = stringResource(CommonStrings.freechat_strict_confirm_body),
+            submitText = stringResource(CommonStrings.freechat_strict_confirm_button),
+            destructiveSubmit = true,
+            onSubmitClick = {
+                state.eventSink(StrictModeEvent.Enable)
+                onSignOut()
+            },
+            onDismiss = { state.eventSink(StrictModeEvent.CloseDialog) },
+        )
+        StrictModeDialog.IdleTime -> {
+            val presets = StrictMode.IDLE_PRESETS_MINUTES
+            val choices = if (state.idleMinutes in presets) presets else presets + state.idleMinutes
+            SingleSelectionDialog(
+                title = stringResource(CommonStrings.freechat_strict_idle),
+                options = choices.map { ListOption(readTtlLabel(it * 60L)) }.toImmutableList(),
+                initialSelection = choices.indexOf(state.idleMinutes),
+                onSelectOption = { index -> state.eventSink(StrictModeEvent.SetIdleMinutes(choices[index])) },
+                onDismissRequest = { state.eventSink(StrictModeEvent.CloseDialog) },
+            )
+        }
+    }
+}
+
+internal class StrictModeStateProvider : PreviewParameterProvider<StrictModeState> {
+    override val values = sequenceOf(
+        aStrictModeState(),
+        aStrictModeState(dialog = StrictModeDialog.ConfirmEnable),
+        aStrictModeState(enabled = true, isStrictSession = true),
+        aStrictModeState(enabled = true, isStrictSession = true, dialog = StrictModeDialog.IdleTime),
+        aStrictModeState(enabled = false, isStrictSession = true),
+    )
+}
+
+internal fun aStrictModeState(
+    enabled: Boolean = false,
+    idleMinutes: Int = StrictMode.DEFAULT_IDLE_MINUTES,
+    isStrictSession: Boolean = false,
+    dialog: StrictModeDialog = StrictModeDialog.None,
+    eventSink: (StrictModeEvent) -> Unit = {},
+) = StrictModeState(
+    enabled = enabled,
+    idleMinutes = idleMinutes,
+    isStrictSession = isStrictSession,
+    dialog = dialog,
+    eventSink = eventSink,
+)
+
+@PreviewsDayNight
+@Composable
+internal fun StrictModeSectionPreview(@PreviewParameter(StrictModeStateProvider::class) state: StrictModeState) =
+    ElementPreview {
+        StrictModeSection(state, onSignOut = {})
+    }
