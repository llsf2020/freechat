+package io.element.android.features.messages.impl.timeline.freechat
+
+import dev.zacsweers.metro.ContributesBinding
+import dev.zacsweers.metro.Inject
+import io.element.android.features.messages.impl.timeline.model.TimelineItem
+import io.element.android.libraries.di.SessionScope
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.EventId
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.freechat.ExpiryMarkers
+import io.element.android.libraries.matrix.api.freechat.existingEvents
+import kotlinx.collections.immutable.toImmutableList
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.channelFlow
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.flow
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+/**
+ * FreeChat: removes disappearing messages from the timeline on this device.
+ *
+ * The server purges expired messages without leaving a redaction. `unsigned.com.freechat.expires_at`
+ * (room auto-delete) is honoured to the second, even offline. Messages that burn after reading, whose
+ * expiry this device cannot compute, are dropped once the server says they no longer exist.
+ */
+interface DisappearingTimelineFilter {
+    fun filter(roomId: RoomId, items: Flow<List<TimelineItem>>): Flow<List<TimelineItem>>
+
+    /** No filtering; keeps tests and previews independent of the server. */
+    object None : DisappearingTimelineFilter {
+        override fun filter(roomId: RoomId, items: Flow<List<TimelineItem>>) = items
+    }
+}
+
+@ContributesBinding(SessionScope::class)
+@Inject
+class DefaultDisappearingTimelineFilter(
+    private val client: MatrixClient,
+) : DisappearingTimelineFilter {
+    override fun filter(roomId: RoomId, items: Flow<List<TimelineItem>>): Flow<List<TimelineItem>> = channelFlow {
+        val latest = MutableStateFlow<List<TimelineItem>>(emptyList())
+        val purged = MutableStateFlow<Set<EventId>>(emptySet())
+        val markers = MarkerCache()
+
+        launch { items.collect { latest.value = it } }
+        launch {
+            while (true) {
+                val pending = latest.value.markedEventIds(markers, System.currentTimeMillis()) - purged.value
+                if (pending.isNotEmpty()) {
+                    client.existingEvents(roomId, pending)
+                        .onSuccess { existing -> purged.value += pending - existing }
+                        .onFailure { Timber.w(it, "FreeChat: existence check failed in $roomId") }
+                }
+                delay(CHECK_INTERVAL_MS)
+            }
+        }
+        combine(latest, purged, ticker()) { list, gone, now -> hideExpired(list, now, gone, markers::of) }
+            .collect { send(it) }
+    }.distinctUntilChanged()
+
+    private companion object {
+        const val CHECK_INTERVAL_MS = 30_000L
+    }
+}
+
+/** Parses each event's markers once; the original JSON of an event never changes. */
+private class MarkerCache {
+    private val cache = HashMap<EventId, ExpiryMarkers>()
+
+    fun of(event: TimelineItem.Event): ExpiryMarkers {
+        val eventId = event.eventId ?: return ExpiryMarkers.NONE
+        return synchronized(cache) {
+            cache.getOrPut(eventId) { ExpiryMarkers.parse(event.timelineItemDebugInfoProvider().originalJson) }
+        }
+    }
+}
+
+/** Hides events whose marked expiry passed or that the server purged. */
+internal fun hideExpired(
+    items: List<TimelineItem>,
+    now: Long,
+    purged: Set<EventId>,
+    markersOf: (TimelineItem.Event) -> ExpiryMarkers,
+): List<TimelineItem> {
+    fun TimelineItem.Event.isGone(): Boolean {
+        if (eventId in purged) return true
+        val expiresAt = markersOf(this).expiresAt
+        return expiresAt != null && expiresAt <= now
+    }
+
+    return items.mapNotNull { item ->
+        when (item) {
+            is TimelineItem.Event -> item.takeUnless { it.isGone() }
+            is TimelineItem.GroupedEvents -> {
+                val kept = item.events.filterNot { it.isGone() }
+                when {
+                    kept.size == item.events.size -> item
+                    kept.isEmpty() -> null
+                    else -> item.copy(events = kept.toImmutableList())
+                }
+            }
+            is TimelineItem.Virtual -> item
+        }
+    }
+}
+
+private fun List<TimelineItem>.markedEventIds(markers: MarkerCache, now: Long): Set<EventId> =
+    flatMap { item ->
+        when (item) {
+            is TimelineItem.Event -> listOf(item)
+            is TimelineItem.GroupedEvents -> item.events
+            is TimelineItem.Virtual -> emptyList()
+        }
+    }
+        .filter { event ->
+            val m = markers.of(event)
+            val expiresAt = m.expiresAt
+            m.isMarked && (expiresAt == null || expiresAt > now)
+        }
+        .mapNotNull { it.eventId }
+        .toSet()
+
+private fun ticker() = flow {
+    while (true) {
+        emit(System.currentTimeMillis())
+        delay(1_000)
+    }
+}
