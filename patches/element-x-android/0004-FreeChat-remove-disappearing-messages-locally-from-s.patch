+/** Expiry markers the server put in an event's `unsigned`, read from its original JSON. */
+data class ExpiryMarkers(val expiresAt: Long?, val burnsAfterReading: Boolean) {
+    val isMarked get() = expiresAt != null || burnsAfterReading
+
+    companion object {
+        val NONE = ExpiryMarkers(null, false)
+
+        fun parse(originalJson: String?): ExpiryMarkers {
+            val unsigned = runCatching { Json.parseToJsonElement(originalJson ?: return NONE).jsonObject["unsigned"] as? JsonObject }
+                .getOrNull() ?: return NONE
+            fun positive(key: String) = (unsigned[key] as? JsonPrimitive)?.takeUnless { it.isString }?.longOrNull?.takeIf { it > 0 }
+            return ExpiryMarkers(expiresAt = positive("com.freechat.expires_at"), burnsAfterReading = positive("com.freechat.read_ttl") != null)
+        }
+    }
+}
+
+/** Which of [eventIds] still exist on the server; purged ones are left out. Members only. */
+suspend fun MatrixClient.existingEvents(roomId: RoomId, eventIds: Set<EventId>): Result<Set<EventId>> {
+    val body = JsonObject(mapOf("event_ids" to JsonArray(eventIds.map { JsonPrimitive(it.value) }))).toString()
+    return freechatRequest("POST", FreeChatApi.existingEventsPath(roomId), body).mapCatching { response ->
+        (Json.parseToJsonElement(response).jsonObject["existing"] as? JsonArray).orEmpty()
+            .mapNotNull { (it as? JsonPrimitive)?.content?.let(::EventId) }
+            .toSet()
+    }
+}
