+package io.element.android.features.messages.impl.timeline.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.features.messages.impl.timeline.aTimelineItemDebugInfo
+import io.element.android.features.messages.impl.timeline.aTimelineItemEvent
+import io.element.android.features.messages.impl.timeline.model.TimelineItem
+import io.element.android.libraries.matrix.api.core.EventId
+import io.element.android.libraries.matrix.api.core.UniqueId
+import io.element.android.libraries.matrix.api.freechat.ExpiryMarkers
+import kotlinx.collections.immutable.persistentListOf
+import org.junit.Test
+
+class DisappearingTimelineFilterTest {
+    private fun json(unsigned: String) = """{"type":"m.room.message","content":{},"unsigned":$unsigned}"""
+
+    private val plain = aTimelineItemEvent(eventId = EventId("\$plain"))
+    private val timed = aTimelineItemEvent(
+        eventId = EventId("\$timed"),
+        debugInfo = aTimelineItemDebugInfo(originalJson = json("""{"com.freechat.expires_at":5000}""")),
+    )
+    private val burn = aTimelineItemEvent(
+        eventId = EventId("\$burn"),
+        debugInfo = aTimelineItemDebugInfo(originalJson = json("""{"com.freechat.read_ttl":5}""")),
+    )
+
+    private fun markers(event: TimelineItem.Event) = ExpiryMarkers.parse(event.timelineItemDebugInfoProvider().originalJson)
+
+    @Test
+    fun `markers are parsed leniently`() {
+        assertThat(ExpiryMarkers.parse(json("""{"com.freechat.expires_at":5000}"""))).isEqualTo(ExpiryMarkers(5000, false))
+        assertThat(ExpiryMarkers.parse(json("""{"com.freechat.read_ttl":5}"""))).isEqualTo(ExpiryMarkers(null, true))
+        assertThat(ExpiryMarkers.parse(json("""{"com.freechat.expires_at":"5000"}"""))).isEqualTo(ExpiryMarkers.NONE)
+        assertThat(ExpiryMarkers.parse(null)).isEqualTo(ExpiryMarkers.NONE)
+        assertThat(ExpiryMarkers.parse("broken")).isEqualTo(ExpiryMarkers.NONE)
+    }
+
+    @Test
+    fun `timed messages disappear on time, without the server`() {
+        assertThat(hideExpired(listOf(plain, timed), now = 4999, purged = emptySet(), markersOf = ::markers)).containsExactly(plain, timed).inOrder()
+        assertThat(hideExpired(listOf(plain, timed), now = 5000, purged = emptySet(), markersOf = ::markers)).containsExactly(plain)
+    }
+
+    @Test
+    fun `messages the server purged disappear`() {
+        assertThat(hideExpired(listOf(plain, burn), now = 0, purged = setOf(EventId("\$burn")), markersOf = ::markers)).containsExactly(plain)
+    }
+
+    @Test
+    fun `groups are filtered too`() {
+        val group = TimelineItem.GroupedEvents(UniqueId("g"), persistentListOf(timed, burn), persistentListOf())
+        assertThat(hideExpired(listOf(group), now = 9999, purged = setOf(EventId("\$burn")), markersOf = ::markers)).isEmpty()
+    }
+}
