From bf3217a06278d4b0a40de2f984b6751dcaf48894 Mon Sep 17 00:00:00 2001
From: sjcsf <346224915+llsf2020@users.noreply.github.com>
Date: Sat, 24 Oct 2026 00:00:00 +0000
Subject: [PATCH 19/23] FreeChat: release builds use the local Rust SDK too

The app calls the SDK's FreeChat additions, which the published SDK does not have, so with
libraries/rustsdk/matrix-rust-sdk.aar in place release builds use it as debug builds do.
---
 libraries/matrix/impl/build.gradle.kts | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/libraries/matrix/impl/build.gradle.kts b/libraries/matrix/impl/build.gradle.kts
index f43a12d17e..899e4e7a02 100644
--- a/libraries/matrix/impl/build.gradle.kts
+++ b/libraries/matrix/impl/build.gradle.kts
@@ -26,13 +26,27 @@ setupDependencyInjection()
 val elementCallVersion: String = providers.gradleProperty("elementCallLocalVersion")
     .getOrElse(libs.versions.element.call.get())
 
+val usesLocalRustSdk = file("${rootDir.path}/libraries/rustsdk/matrix-rust-sdk.aar").exists()
+
+if (usesLocalRustSdk) {
+    // FreeChat: debug and release builds both use the local AAR, since the app needs the SDK's FreeChat
+    // patches. Anything that still asks for the published Rust SDK (a call library, say) gets the same
+    // local AAR, so a classpath never carries a second, unpatched copy of org.matrix.rustcomponents.sdk.
+    configurations.configureEach {
+        resolutionStrategy.dependencySubstitution {
+            substitute(module("org.matrix.rustcomponents:sdk-android"))
+                .using(project(":libraries:rustsdk"))
+                .because("the local Rust SDK AAR replaces the published one")
+        }
+    }
+}
+
 dependencies {
-    releaseImplementation(libs.matrix.sdk)
-    if (file("${rootDir.path}/libraries/rustsdk/matrix-rust-sdk.aar").exists()) {
+    if (usesLocalRustSdk) {
         println("\nNote: Using local binary of the Rust SDK.\n")
-        debugImplementation(projects.libraries.rustsdk)
+        implementation(projects.libraries.rustsdk)
     } else {
-        debugImplementation(libs.matrix.sdk)
+        implementation(libs.matrix.sdk)
     }
     // Disabled until the platform verifier is ready for production. See CertificateVerifier.kt.
 //    implementation(variantOf(libs.rustls.platform.verifier) { artifactType("aar") })
