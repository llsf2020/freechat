+    /**
+     * TTL in seconds from a whole state event's JSON (the SDK drops the content of custom state events from timeline
+     * items, but keeps the original JSON). Null when the JSON is missing or has no content object.
+     */
+    fun ttlFromEventJson(eventJson: String?): Long? {
+        val content = parseObject(eventJson)?.get("content") as? JsonObject ?: return null
+        return ttlFromContent(content.toString())
+    }
+
     fun contentForTtl(ttl: Long): String = """{"ttl":${ttl.coerceAtLeast(0)}}"""
 
