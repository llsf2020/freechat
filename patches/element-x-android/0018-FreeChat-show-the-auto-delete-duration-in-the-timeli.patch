+
+package io.element.android.libraries.eventformatter.impl
+
+import android.content.Context
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.eventformatter.impl.mode.RenderingMode
+import io.element.android.services.toolbox.impl.strings.AndroidStringProvider
+import io.element.android.tests.testutils.robolectric.RobolectricTest
+import org.junit.Before
+import org.junit.Test
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+class FreeChatDisappearingFormatterTest : RobolectricTest() {
+    private lateinit var formatter: StateContentFormatter
+
+    @Before
+    fun setup() {
+        val context = RuntimeEnvironment.getApplication() as Context
+        formatter = StateContentFormatter(AndroidStringProvider(context.resources))
+    }
+
+    private fun format(ttl: Long?, isYou: Boolean = false, mode: RenderingMode = RenderingMode.Timeline) =
+        formatter.formatDisappearing(ttl, "Alice", isYou, mode)?.toString()
+
+    @Test
+    @Config(qualifiers = "en")
+    fun `the duration is shown when known`() {
+        assertThat(format(86_400)).isEqualTo("Alice set messages to auto-delete after 1 day.")
+        assertThat(format(2 * 86_400, isYou = true)).isEqualTo("You set messages to auto-delete after 2 days.")
+        assertThat(format(0)).isEqualTo("Alice turned off auto-delete.")
+        assertThat(format(0, isYou = true)).isEqualTo("You turned off auto-delete.")
+    }
+
+    @Test
+    @Config(qualifiers = "en")
+    fun `without the event's JSON it stays generic, and the room list shows nothing`() {
+        assertThat(format(null)).isEqualTo("Alice changed the auto-delete setting.")
+        assertThat(format(3600, mode = RenderingMode.RoomList)).isNull()
+    }
+
+    @Test
+    @Config(qualifiers = "zh")
+    fun `simplified Chinese`() {
+        assertThat(format(3600)).isEqualTo("Alice 将自动删除设为 1 小时。")
+    }
+}
