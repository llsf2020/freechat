+/*
+ * Copyright 2026 FreeChat contributors
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.matrix.api.freechat
+
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.longOrNull
+
+/**
+ * FreeChat disappearing messages.
+ *
+ * The homeserver enforces expiry by
+ * redacting messages as their sender; clients let users pick a TTL and hide expired messages entirely.
+ */
+object Disappearing {
+    const val STATE_TYPE = "com.freechat.disappearing"
+    const val EXPIRED_KEY = "com.freechat.expired"
+
+    private const val HOUR = 3600L
+    private const val DAY = 24 * HOUR
+
+    /** TTL presets offered in the UI, in seconds. Zero means off. */
+    val PRESETS: List<Long> = listOf(0L, HOUR, DAY, 7 * DAY, 30 * DAY)
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /** TTL in seconds from a state event's content JSON; zero when missing, invalid or disabled. */
+    fun ttlFromContent(contentJson: String?): Long {
+        val content = parseObject(contentJson) ?: return 0
+        val ttl = (content["ttl"] as? JsonPrimitive)?.takeUnless { it.isString }?.longOrNull ?: return 0
+        return ttl.coerceAtLeast(0)
+    }
+
+    fun contentForTtl(ttl: Long): String = """{"ttl":${ttl.coerceAtLeast(0)}}"""
+
+    /** True when an event's original JSON shows it was redacted by the server because it expired. */
+    fun isExpiredRedaction(originalJson: String?): Boolean {
+        val event = parseObject(originalJson) ?: return false
+        val because = (event["unsigned"] as? JsonObject)?.get("redacted_because") as? JsonObject ?: return false
+        val content = because["content"] as? JsonObject ?: return false
+        return (content[EXPIRED_KEY] as? JsonPrimitive)?.booleanOrNull == true
+    }
+
+    /** How a TTL should be described: a preset label or a count of the largest whole unit. */
+    sealed interface Duration {
+        data object Off : Duration
+        data class Preset(val index: Int) : Duration
+        data class Days(val count: Long) : Duration
+        data class Hours(val count: Long) : Duration
+        data class Minutes(val count: Long) : Duration
+        data class Seconds(val count: Long) : Duration
+    }
+
+    fun describe(ttl: Long): Duration {
+        if (ttl <= 0) return Duration.Off
+        val preset = PRESETS.indexOf(ttl)
+        return when {
+            preset >= 0 -> Duration.Preset(preset)
+            ttl % DAY == 0L -> Duration.Days(ttl / DAY)
+            ttl % HOUR == 0L -> Duration.Hours(ttl / HOUR)
+            ttl % 60 == 0L -> Duration.Minutes(ttl / 60)
+            else -> Duration.Seconds(ttl)
+        }
+    }
+
+    private fun parseObject(raw: String?): JsonObject? = raw?.let {
+        runCatching { json.parseToJsonElement(it).jsonObject }.getOrNull()
+    }
+}
