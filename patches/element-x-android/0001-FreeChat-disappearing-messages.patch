+import io.element.android.tests.testutils.test
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+
+class DisappearingMessagesPresenterTest {
+    /** A room whose disappearing state lives in [content] and whose state sends update it. */
+    private class StateRoom(
+        private val delegate: JoinedRoom,
+        val content: MutableStateFlow<String?> = MutableStateFlow(null),
+        private val sendResult: Result<Unit> = Result.success(Unit),
+    ) : JoinedRoom by delegate {
+        val sent = mutableListOf<Triple<String, String, String>>()
+
+        override fun stateEventContentFlow(type: String, stateKey: String): Flow<String?> = content
+
+        override suspend fun sendStateEvent(type: String, stateKey: String, contentJson: String): Result<Unit> {
+            sent += Triple(type, stateKey, contentJson)
+            return sendResult.onSuccess { content.value = contentJson }
+        }
+    }
+
+    private fun aStateRoom(
+        canSendState: Boolean = true,
+        content: String? = null,
+        sendResult: Result<Unit> = Result.success(Unit),
+    ) = StateRoom(
+        delegate = FakeJoinedRoom(
+            baseRoom = FakeBaseRoom(
+                roomPermissions = FakeRoomPermissions(
+                    canSendState = { it == StateEventType.Custom(Disappearing.STATE_TYPE) && canSendState },
+                ),
+            ),
+        ),
+        content = MutableStateFlow(content),
+        sendResult = sendResult,
+    )
+
+    @Test
+    fun `present - reflects the room ttl and permission`() = runTest {
+        val room = aStateRoom(content = """{"ttl":86400}""")
+        DisappearingMessagesPresenter(room).test {
+            val state = consumeItemsUntilPredicate { it.ttl == 86_400L && it.canChange }.last()
+            assertThat(state.showDialog).isFalse()
+            room.content.value = null
+            assertThat(consumeItemsUntilPredicate { it.ttl == 0L }.last().ttl).isEqualTo(0)
+        }
+    }
+
+    @Test
+    fun `present - cannot change without permission`() = runTest {
+        DisappearingMessagesPresenter(aStateRoom(canSendState = false)).test {
+            assertThat(awaitItem().canChange).isFalse()
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - picking a ttl sends the state event`() = runTest {
+        val room = aStateRoom()
+        DisappearingMessagesPresenter(room).test {
+            awaitItem().eventSink(DisappearingMessagesEvent.OpenDialog)
+            val dialog = consumeItemsUntilPredicate { it.showDialog }.last()
+            dialog.eventSink(DisappearingMessagesEvent.SetTtl(3600))
+            val saved = consumeItemsUntilPredicate { !it.isSaving && it.ttl == 3600L }.last()
+            assertThat(saved.showDialog).isFalse()
+            assertThat(room.sent).containsExactly(Triple(Disappearing.STATE_TYPE, "", """{"ttl":3600}"""))
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - picking the current ttl sends nothing`() = runTest {
+        val room = aStateRoom(content = """{"ttl":3600}""")
+        DisappearingMessagesPresenter(room).test {
+            consumeItemsUntilPredicate { it.ttl == 3600L }.last().eventSink(DisappearingMessagesEvent.OpenDialog)
+            consumeItemsUntilPredicate { it.showDialog }.last().eventSink(DisappearingMessagesEvent.SetTtl(3600))
+            val closed = consumeItemsUntilPredicate { !it.showDialog }.last()
+            assertThat(closed.isSaving).isFalse()
+            assertThat(room.sent).isEmpty()
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - send failure shows an error`() = runTest {
+        val room = aStateRoom(sendResult = Result.failure(AN_EXCEPTION))
+        DisappearingMessagesPresenter(room).test {
+            awaitItem().eventSink(DisappearingMessagesEvent.SetTtl(86400))
+            val failed = consumeItemsUntilPredicate { it.hasError }.last()
+            assertThat(failed.ttl).isEqualTo(0)
+            failed.eventSink(DisappearingMessagesEvent.ClearError)
+            assertThat(consumeItemsUntilPredicate { !it.hasError }.last().hasError).isFalse()
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+}
