+/** FreeChat: room details entry to pick the disappearing-messages TTL. */
+@Composable
+fun DisappearingMessagesItem(
+    state: DisappearingMessagesState,
+    modifier: Modifier = Modifier,
+) {
+    ListItem(
+        modifier = modifier,
+        leadingContent = ListItemContent.Icon(IconSource.Vector(CompoundIcons.Time())),
+        content = { Text(stringResource(CommonStrings.freechat_disappearing_title)) },
+        supportingContent = { Text(disappearingLabel(state.ttl)) },
+        enabled = state.canChange && !state.isSaving,
+        onClick = { state.eventSink(DisappearingMessagesEvent.OpenDialog) },
+    )
+
+    if (state.showDialog) {
+        // A TTL set by another client that is not a preset still shows as selected.
+        val ttls = if (state.ttl in Disappearing.PRESETS) Disappearing.PRESETS else Disappearing.PRESETS + state.ttl
+        val options = ttls.map { ListOption(disappearingLabel(it)) }.toImmutableList()
+        SingleSelectionDialog(
+            title = stringResource(CommonStrings.freechat_disappearing_title),
+            subtitle = stringResource(CommonStrings.freechat_disappearing_description),
+            options = options,
+            initialSelection = ttls.indexOf(state.ttl),
+            onSelectOption = { index -> state.eventSink(DisappearingMessagesEvent.SetTtl(ttls[index])) },
+            onDismissRequest = { state.eventSink(DisappearingMessagesEvent.CloseDialog) },
+        )
+    }
+
+    if (state.hasError) {
+        ErrorDialog(
+            content = stringResource(CommonStrings.freechat_disappearing_error),
+            onSubmit = { state.eventSink(DisappearingMessagesEvent.ClearError) },
+        )
+    }
+}
+
+/** Human-readable TTL, preferring the preset labels. */
+@Composable
+fun disappearingLabel(ttl: Long): String = when (val d = Disappearing.describe(ttl)) {
+    Disappearing.Duration.Off -> stringResource(CommonStrings.freechat_disappearing_off)
+    is Disappearing.Duration.Preset -> stringResource(PRESET_LABELS[d.index])
+    is Disappearing.Duration.Days -> pluralStringResource(CommonPlurals.freechat_disappearing_days, d.count.toInt(), d.count)
+    is Disappearing.Duration.Hours -> pluralStringResource(CommonPlurals.freechat_disappearing_hours, d.count.toInt(), d.count)
+    is Disappearing.Duration.Minutes -> pluralStringResource(CommonPlurals.freechat_disappearing_minutes, d.count.toInt(), d.count)
+    is Disappearing.Duration.Seconds -> pluralStringResource(CommonPlurals.freechat_disappearing_seconds, d.count.toInt(), d.count)
+}
+
+private val PRESET_LABELS = listOf(
+    CommonStrings.freechat_disappearing_off,
+    CommonStrings.freechat_disappearing_hour,
+    CommonStrings.freechat_disappearing_day,
+    CommonStrings.freechat_disappearing_week,
+    CommonStrings.freechat_disappearing_month,
+)
