+    showDialog: Boolean = false,
+    hasError: Boolean = false,
+    eventSink: (DisappearingMessagesEvent) -> Unit = {},
+) = DisappearingMessagesState(
+    ttl = ttl,
+    canChange = canChange,
+    isSaving = isSaving,
+    showDialog = showDialog,
+    hasError = hasError,
+    eventSink = eventSink,
+)
