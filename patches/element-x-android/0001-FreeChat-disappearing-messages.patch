+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.matrix.api.freechat
+
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+
+class DisappearingTest {
+    @Test
+    fun `ttlFromContent - reads valid ttl`() {
+        assertThat(Disappearing.ttlFromContent("""{"ttl":3600}""")).isEqualTo(3600)
+    }
+
+    @Test
+    fun `ttlFromContent - treats missing, invalid and negative as off`() {
+        assertThat(Disappearing.ttlFromContent(null)).isEqualTo(0)
+        assertThat(Disappearing.ttlFromContent("{}")).isEqualTo(0)
+        assertThat(Disappearing.ttlFromContent("""{"ttl":"3600"}""")).isEqualTo(0)
+        assertThat(Disappearing.ttlFromContent("""{"ttl":-5}""")).isEqualTo(0)
+        assertThat(Disappearing.ttlFromContent("not json")).isEqualTo(0)
+    }
+
+    @Test
+    fun `contentForTtl - round trips`() {
+        assertThat(Disappearing.ttlFromContent(Disappearing.contentForTtl(86400))).isEqualTo(86400)
+    }
+
+    @Test
+    fun `isExpiredRedaction - detects server expiry`() {
+        val json = """{"type":"m.room.message","content":{},"unsigned":{"redacted_because":
+            {"type":"m.room.redaction","content":{"redacts":"${'$'}a","com.freechat.expired":true}}}}"""
+        assertThat(Disappearing.isExpiredRedaction(json)).isTrue()
+    }
+
+    @Test
+    fun `isExpiredRedaction - ignores manual redactions and live events`() {
+        val manual = """{"content":{},"unsigned":{"redacted_because":{"content":{"redacts":"${'$'}a"}}}}"""
+        assertThat(Disappearing.isExpiredRedaction(manual)).isFalse()
+        assertThat(Disappearing.isExpiredRedaction("""{"content":{"body":"hi"}}""")).isFalse()
+        assertThat(Disappearing.isExpiredRedaction(null)).isFalse()
+    }
+
+    @Test
+    fun `describe - presets then largest whole unit`() {
+        assertThat(Disappearing.describe(0)).isEqualTo(Disappearing.Duration.Off)
+        assertThat(Disappearing.describe(86400)).isEqualTo(Disappearing.Duration.Preset(2))
+        assertThat(Disappearing.describe(2 * 86400)).isEqualTo(Disappearing.Duration.Days(2))
+        assertThat(Disappearing.describe(7200)).isEqualTo(Disappearing.Duration.Hours(2))
+        assertThat(Disappearing.describe(300)).isEqualTo(Disappearing.Duration.Minutes(5))
+        assertThat(Disappearing.describe(45)).isEqualTo(Disappearing.Duration.Seconds(45))
+    }
+}
