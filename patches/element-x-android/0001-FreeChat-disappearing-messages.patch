+package io.element.android.features.messages.impl.timeline.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.features.messages.impl.timeline.aTimelineItemDebugInfo
+import io.element.android.features.messages.impl.timeline.aTimelineItemEvent
+import io.element.android.features.messages.impl.timeline.model.TimelineItem
+import io.element.android.features.messages.impl.timeline.model.event.TimelineItemRedactedContent
+import io.element.android.libraries.matrix.api.core.UniqueId
+import kotlinx.collections.immutable.persistentListOf
+import org.junit.Test
+
+class HideExpiredMessagesTest {
+    private val expiredJson = """{"content":{},"unsigned":{"redacted_because":{"content":{"com.freechat.expired":true}}}}"""
+
+    private val text = aTimelineItemEvent()
+    private val redacted = aTimelineItemEvent(content = TimelineItemRedactedContent)
+    private val expired = aTimelineItemEvent(content = TimelineItemRedactedContent, debugInfo = aTimelineItemDebugInfo(originalJson = expiredJson))
+
+    @Test
+    fun `room without ttl keeps manual deletions and hides known expiries`() {
+        assertThat(hideExpiredMessages(listOf(text, redacted, expired), roomTtl = 0)).containsExactly(text, redacted).inOrder()
+    }
+
+    @Test
+    fun `room with ttl hides every deleted message`() {
+        assertThat(hideExpiredMessages(listOf(text, redacted, expired), roomTtl = 3600)).containsExactly(text)
+    }
+
+    @Test
+    fun `groups are filtered and dropped when empty`() {
+        val group = TimelineItem.GroupedEvents(UniqueId("g"), persistentListOf(redacted, expired), persistentListOf())
+        assertThat(hideExpiredMessages(listOf(group), roomTtl = 3600)).isEmpty()
+
+        val filtered = hideExpiredMessages(listOf(group), roomTtl = 0).single() as TimelineItem.GroupedEvents
+        assertThat(filtered.events).containsExactly(redacted)
+    }
+
+    @Test
+    fun `untouched groups are returned as is`() {
+        val group = TimelineItem.GroupedEvents(UniqueId("g"), persistentListOf(redacted), persistentListOf())
+        assertThat(hideExpiredMessages(listOf(group), roomTtl = 0).single()).isSameInstanceAs(group)
+    }
+}
