+package io.element.android.features.messages.impl.timeline.freechat
+
+import io.element.android.features.messages.impl.timeline.model.TimelineItem
+import io.element.android.features.messages.impl.timeline.model.event.TimelineItemRedactedContent
+import io.element.android.libraries.matrix.api.freechat.Disappearing
+import kotlinx.collections.immutable.toImmutableList
+
+/**
+ * FreeChat: drop deleted messages from the timeline instead of showing a "message deleted" placeholder.
+ *
+ * matrix-rust-sdk forgets an event's original JSON when a redaction arrives live, so the server's
+ * `com.freechat.expired` marker is only visible after a reload. In rooms with disappearing messages on,
+ * every redacted message is therefore hidden (Telegram never shows placeholders either); elsewhere only
+ * the ones we can tell expired are.
+ */
+internal fun hideExpiredMessages(items: List<TimelineItem>, roomTtl: Long): List<TimelineItem> {
+    fun TimelineItem.Event.isHidden(): Boolean =
+        content is TimelineItemRedactedContent &&
+            (roomTtl > 0 || Disappearing.isExpiredRedaction(timelineItemDebugInfoProvider().originalJson))
+
+    return items.mapNotNull { item ->
+        when (item) {
+            is TimelineItem.Event -> item.takeUnless { it.isHidden() }
+            is TimelineItem.GroupedEvents -> {
+                val kept = item.events.filterNot { it.isHidden() }
+                when {
+                    kept.size == item.events.size -> item
+                    kept.isEmpty() -> null
+                    else -> item.copy(events = kept.toImmutableList())
+                }
+            }
+            is TimelineItem.Virtual -> item
+        }
+    }
+}
