+
+package io.element.android.features.messages.impl.timeline.freechat
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import io.element.android.libraries.di.SessionScope
+import io.element.android.libraries.di.annotations.SessionCoroutineScope
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.freechat.Disappearing
+import io.element.android.libraries.matrix.api.freechat.FreeChatApi
+import io.element.android.libraries.matrix.api.room.JoinedRoom
+import io.element.android.libraries.matrix.api.timeline.MsgType
+import io.element.android.libraries.matrix.ui.freechat.ScreenCaptureEffect
+import io.element.android.libraries.matrix.ui.freechat.ScreenshotPolicy
+import io.element.android.libraries.matrix.ui.freechat.SecureWindowEffect
+import io.element.android.libraries.ui.strings.CommonStrings
+import io.element.android.services.toolbox.api.strings.StringProvider
+import io.element.android.services.toolbox.api.systemclock.SystemClock
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * FreeChat: tells a room with auto-delete that the user took a screenshot, as an emote ("* Alice took a screenshot")
+ * that every client shows and that expires like the other messages. At most one every [MIN_INTERVAL_MS] per room, so
+ * a burst of screenshots does not flood it. Sent from the session's scope, so leaving the room does not cancel it.
+ */
+@Inject
+@SingleIn(SessionScope::class)
+class ScreenshotAlerts(
+    private val stringProvider: StringProvider,
+    private val systemClock: SystemClock,
+    @SessionCoroutineScope private val sessionCoroutineScope: CoroutineScope,
+) {
+    private val lastSent = ConcurrentHashMap<RoomId, Long>()
+
+    fun onScreenshot(room: JoinedRoom) {
+        val now = systemClock.epochMillis()
+        val previous = lastSent[room.roomId]
+        if (previous != null && now - previous < MIN_INTERVAL_MS) return
+        lastSent[room.roomId] = now
+        sessionCoroutineScope.launch {
+            room.liveTimeline.sendMessage(
+                body = stringProvider.getString(CommonStrings.freechat_screenshot_alert),
+                htmlBody = null,
+                intentionalMentions = emptyList(),
+                msgType = MsgType.MSG_TYPE_EMOTE,
+                asPlainText = true,
+            ).onFailure { Timber.w(it, "Could not tell the room about a screenshot") }
+        }
+    }
+
+    companion object {
+        const val MIN_INTERVAL_MS = 30_000L
+    }
+}
+
+/**
+ * FreeChat: the screenshot rules of a room's screens (its timeline and its threads). Blocks screenshots when the room
+ * asks for it (the account-wide choice is applied app-wide), and otherwise, in a room with auto-delete, tells the
+ * others when one is taken.
+ */
+@Composable
+fun RoomScreenshotRules(room: JoinedRoom, screenshotPolicy: ScreenshotPolicy, screenshotAlerts: ScreenshotAlerts) {
+    val roomBlocksScreenshots by remember {
+        room.stateEventContentFlow(FreeChatApi.PRIVACY_STATE_TYPE).map(FreeChatApi::blockScreenshotsFromContent)
+    }.collectAsState(initial = false)
+    val alwaysBlockScreenshots by screenshotPolicy.alwaysBlockScreenshots.collectAsState()
+    val blocked = roomBlocksScreenshots || alwaysBlockScreenshots
+    SecureWindowEffect(blocked)
+    val roomAutoDeletes by remember {
+        room.stateEventContentFlow(Disappearing.STATE_TYPE).map { Disappearing.ttlFromContent(it) > 0 }
+    }.collectAsState(initial = false)
+    ScreenCaptureEffect(enabled = roomAutoDeletes && !blocked) { screenshotAlerts.onScreenshot(room) }
+}
