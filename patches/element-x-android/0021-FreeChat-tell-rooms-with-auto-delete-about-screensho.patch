+ */
+
+package io.element.android.features.messages.impl.timeline.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.timeline.MsgType
+import io.element.android.libraries.matrix.test.room.FakeBaseRoom
+import io.element.android.libraries.matrix.test.room.FakeJoinedRoom
+import io.element.android.libraries.matrix.test.timeline.FakeTimeline
+import io.element.android.services.toolbox.test.strings.FakeStringProvider
+import io.element.android.services.toolbox.test.systemclock.FakeSystemClock
+import kotlinx.coroutines.test.TestScope
+import kotlinx.coroutines.test.advanceUntilIdle
+import org.junit.Test
+
+class ScreenshotAlertsTest {
+    private val sent = mutableListOf<Pair<String, MsgType>>()
+    private val clock = FakeSystemClock(epochMillisResult = 1_000_000)
+    private val scope = TestScope()
+    private val alerts = ScreenshotAlerts(FakeStringProvider("took a screenshot"), clock, scope)
+
+    private fun room(id: String) = FakeJoinedRoom(
+        baseRoom = FakeBaseRoom(roomId = RoomId(id)),
+        liveTimeline = FakeTimeline().apply {
+            sendMessageLambda = { body, _, _, msgType, asPlainText ->
+                assertThat(asPlainText).isTrue()
+                sent.add(body to msgType)
+                Result.success(Unit)
+            }
+        },
+    )
+
+    @Test
+    fun `a screenshot is told to the room as an emote`() {
+        alerts.onScreenshot(room("!a:example.org"))
+        scope.advanceUntilIdle()
+        assertThat(sent).containsExactly("took a screenshot" to MsgType.MSG_TYPE_EMOTE)
+    }
+
+    @Test
+    fun `a burst of screenshots in one room is told once`() {
+        val room = room("!a:example.org")
+        alerts.onScreenshot(room)
+        clock.epochMillisResult += ScreenshotAlerts.MIN_INTERVAL_MS - 1
+        alerts.onScreenshot(room)
+        scope.advanceUntilIdle()
+        assertThat(sent).hasSize(1)
+
+        clock.epochMillisResult += 1
+        alerts.onScreenshot(room)
+        scope.advanceUntilIdle()
+        assertThat(sent).hasSize(2)
+    }
+
+    @Test
+    fun `rooms are limited separately`() {
+        alerts.onScreenshot(room("!a:example.org"))
+        alerts.onScreenshot(room("!b:example.org"))
+        scope.advanceUntilIdle()
+        assertThat(sent).hasSize(2)
+    }
+}
