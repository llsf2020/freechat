--- a/features/createroom/impl/src/test/kotlin/io/element/android/features/createroom/impl/ConfigureRoomPresenterTest.kt
+++ b/features/createroom/impl/src/test/kotlin/io/element/android/features/createroom/impl/ConfigureRoomPresenterTest.kt
@@ -217,6 +217,28 @@ class ConfigureRoomPresenterTest : RobolectricTest() {
         }
     }
 
+    @Test
+    fun `present - FreeChat - a channel is created as one`() = runTest {
+        val matrixClient = createMatrixClient()
+        var params: CreateRoomParameters? = null
+        matrixClient.createRoomResult = {
+            params = it
+            Result.success(RoomId("!channel:domain"))
+        }
+        val presenter = createConfigureRoomPresenter(matrixClient = matrixClient)
+        presenter.test {
+            val initialState = initialState()
+            assertThat(initialState.config.isChannel).isFalse()
+            initialState.eventSink(ConfigureRoomEvent.ChannelChanged(true))
+            val channelState = awaitItem()
+            assertThat(channelState.config.isChannel).isTrue()
+            channelState.eventSink(ConfigureRoomEvent.CreateRoom)
+            assertThat(awaitItem().createRoomAction).isInstanceOf(AsyncAction.Loading::class.java)
+            assertThat(awaitItem().createRoomAction).isInstanceOf(AsyncAction.Success::class.java)
+        }
+        assertThat(params?.isChannel).isTrue()
+    }
+
     @Test
     fun `present - when creating a room in a space if the room doesn't receive the power levels value it can't be added to the space`() = runTest {
