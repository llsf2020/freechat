+
+package io.element.android.libraries.matrix.api.freechat
+
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.RoomId
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.jsonObject
+import java.net.URLEncoder
+
+/** A FreeChat homeserver extension answered with a non-2xx [statusCode]. */
+class FreeChatHttpException(val statusCode: Int, message: String) : Exception(message)
+
+/** FreeChat homeserver extensions under `/_matrix/client/unstable/com.freechat`. */
+object FreeChatApi {
+    const val PREFIX = "/_matrix/client/unstable/com.freechat"
+
+    /** Shortest join password the server accepts. */
+    const val MIN_JOIN_PASSWORD_LENGTH = 6
+
+    /** Room privacy options, admin-only: `{"block_screenshots": true}`. */
+    const val PRIVACY_STATE_TYPE = "com.freechat.privacy"
+
+    fun joinPasswordPath(roomId: RoomId) = "/rooms/${encode(roomId.value)}/join_password"
+
+    fun joinWithPasswordPath(roomId: RoomId) = "/rooms/${encode(roomId.value)}/join_with_password"
+
+    /** True only for a real JSON `true`; strings and anything malformed count as off. */
+    fun blockScreenshotsFromContent(contentJson: String?): Boolean {
+        val value = runCatching { Json.parseToJsonElement(contentJson ?: return false).jsonObject["block_screenshots"] }.getOrNull()
+        return (value as? JsonPrimitive)?.takeUnless { it.isString }?.booleanOrNull == true
+    }
+
+    fun contentForBlockScreenshots(block: Boolean): String = JsonObject(mapOf("block_screenshots" to JsonPrimitive(block))).toString()
+
+    private fun encode(value: String) = URLEncoder.encode(value, "UTF-8").replace("+", "%20")
+}
+
+/** Whether the room has a join password. Room admins only. */
+suspend fun MatrixClient.hasJoinPassword(roomId: RoomId): Result<Boolean> =
+    freechatRequest("GET", FreeChatApi.joinPasswordPath(roomId), null).mapCatching { body ->
+        (Json.parseToJsonElement(body).jsonObject["enabled"] as? JsonPrimitive)?.booleanOrNull == true
+    }
+
+/** Sets the room's join password, or removes it when [password] is null. Room admins only. */
+suspend fun MatrixClient.setJoinPassword(roomId: RoomId, password: String?): Result<Unit> {
+    val body = JsonObject(password?.let { mapOf("password" to JsonPrimitive(it)) }.orEmpty()).toString()
+    return freechatRequest("PUT", FreeChatApi.joinPasswordPath(roomId), body).map { }
+}
+
+/** Gets invited with [password], then joins the room normally. */
+suspend fun MatrixClient.joinWithPassword(roomId: RoomId, password: String): Result<Unit> {
+    val body = JsonObject(mapOf("password" to JsonPrimitive(password))).toString()
+    return freechatRequest("POST", FreeChatApi.joinWithPasswordPath(roomId), body)
+        .mapCatching { joinRoom(roomId).getOrThrow() }
+        .map { }
+}
