+/** FreeChat: room details entries only room admins see. */
+@Composable
+fun PrivateRoomItems(state: PrivateRoomState) {
+    if (!state.isAdmin) return
+    val enabled = state.hasPassword != null && !state.isSaving
+
+    ListItem(
+        leadingContent = ListItemContent.Icon(IconSource.Vector(CompoundIcons.Key())),
+        content = {
+            Text(
+                stringResource(if (state.hasPassword == true) CommonStrings.freechat_pw_change else CommonStrings.freechat_pw_set)
+            )
+        },
+        supportingContent = {
+            Text(stringResource(if (state.hasPassword == true) CommonStrings.freechat_pw_status_on else CommonStrings.freechat_pw_status_off))
+        },
+        enabled = enabled,
+        onClick = { state.eventSink(PrivateRoomEvent.OpenPasswordDialog) },
+    )
+    if (state.hasPassword == true) {
+        ListItem(
+            content = { Text(stringResource(CommonStrings.freechat_pw_remove)) },
+            style = ListItemStyle.Destructive,
+            enabled = enabled,
+            onClick = { state.eventSink(PrivateRoomEvent.RemovePassword) },
+        )
+    }
+    ListItem(
+        leadingContent = ListItemContent.Icon(IconSource.Vector(CompoundIcons.VisibilityOff())),
+        content = { Text(stringResource(CommonStrings.freechat_block_screenshots_room)) },
+        supportingContent = { Text(stringResource(CommonStrings.freechat_block_screenshots_room_description)) },
+        trailingContent = ListItemContent.Switch(checked = state.blockScreenshots),
+        onClick = { state.eventSink(PrivateRoomEvent.SetBlockScreenshots(!state.blockScreenshots)) },
+    )
+
+    if (state.showPasswordDialog) {
+        PasswordDialog(
+            title = stringResource(CommonStrings.freechat_pw_settings_title),
+            subtitle = stringResource(CommonStrings.freechat_pw_description),
+            label = stringResource(CommonStrings.freechat_pw_label),
+            error = stringResource(CommonStrings.freechat_pw_too_short, FreeChatApi.MIN_JOIN_PASSWORD_LENGTH),
+            submitText = stringResource(CommonStrings.freechat_pw_set),
+            minLength = FreeChatApi.MIN_JOIN_PASSWORD_LENGTH,
+            onSubmit = { state.eventSink(PrivateRoomEvent.SetPassword(it)) },
+            onDismissRequest = { state.eventSink(PrivateRoomEvent.ClosePasswordDialog) },
+        )
+    }
+
+    state.error?.let { error ->
+        ErrorDialog(
+            content = stringResource(
+                when (error) {
+                    PrivateRoomError.Password -> CommonStrings.freechat_pw_error
+                    PrivateRoomError.Screenshots -> CommonStrings.freechat_privacy_error
+                }
+            ),
+            onSubmit = { state.eventSink(PrivateRoomEvent.ClearError) },
+        )
+    }
+}
+
+internal class PrivateRoomStateProvider : PreviewParameterProvider<PrivateRoomState> {
+    override val values = sequenceOf(
