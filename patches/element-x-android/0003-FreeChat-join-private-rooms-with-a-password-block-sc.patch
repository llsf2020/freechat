+        title = title,
+        subtitle = subtitle,
+        submitText = submitText,
+        enabled = enabled && password.length >= minLength,
+        onSubmit = { onSubmit(password) },
+        onDismissRequest = onDismissRequest,
+    ) {
+        item {
+            TextField(
+                value = password,
+                onValueChange = { password = it },
+                label = label,
+                supportingText = error,
