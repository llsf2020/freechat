+package io.element.android.libraries.matrix.ui.freechat
+
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import io.element.android.libraries.di.SessionScope
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.freechat.Disappearing
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+/**
+ * FreeChat: the account-wide "always block screenshots" choice, from `com.freechat.disappearing` account data.
+ *
+ * The Rust SDK cannot observe custom account data, so the value is read once per session and updated
+ * in place when this device changes it.
+ */
+@SingleIn(SessionScope::class)
+@Inject
+class ScreenshotPolicy(
+    private val client: MatrixClient,
+) {
+    private val alwaysBlock = MutableStateFlow(false)
+    val alwaysBlockScreenshots: StateFlow<Boolean> = alwaysBlock.asStateFlow()
+
+    init {
+        client.sessionCoroutineScope.launch { refresh() }
+    }
+
+    suspend fun refresh() {
+        client.getAccountData(Disappearing.STATE_TYPE)
+            .onSuccess { alwaysBlock.value = Disappearing.parsePersonal(it).blockScreenshots }
+            .onFailure { Timber.w(it, "FreeChat: failed to read screenshot setting") }
+    }
+
+    /** Saves the choice, keeping the other personal settings, then applies it. */
+    suspend fun setAlwaysBlock(on: Boolean): Result<Unit> =
+        client.getAccountData(Disappearing.STATE_TYPE)
+            .mapCatching { latest -> client.setAccountData(Disappearing.STATE_TYPE, Disappearing.withBlockScreenshots(latest, on)).getOrThrow() }
+            .onSuccess { alwaysBlock.value = on }
+}
