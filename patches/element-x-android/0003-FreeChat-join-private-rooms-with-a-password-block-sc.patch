+import io.element.android.libraries.matrix.api.freechat.joinWithPassword
+import io.element.android.libraries.matrix.ui.freechat.PasswordDialog
+import io.element.android.libraries.ui.strings.CommonStrings
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+/** FreeChat: joins private rooms with a password; the join itself updates the screen through membership. */
+@Inject
+class PasswordJoinPresenter(
+    private val client: MatrixClient,
+) {
+    @Composable
+    fun present(roomId: RoomId): PasswordJoinState {
+        val scope = rememberCoroutineScope()
+        var showDialog by remember { mutableStateOf(false) }
+        var isJoining by remember { mutableStateOf(false) }
+        var error by remember { mutableStateOf<PasswordJoinError?>(null) }
+
+        fun handleEvent(event: PasswordJoinEvent) {
+            when (event) {
+                PasswordJoinEvent.OpenDialog -> {
+                    error = null
+                    showDialog = true
+                }
+                PasswordJoinEvent.CloseDialog -> showDialog = false
+                is PasswordJoinEvent.Submit -> scope.launch {
+                    isJoining = true
+                    client.joinWithPassword(roomId, event.password)
+                        .onSuccess { showDialog = false }
+                        .onFailure {
+                            Timber.w("FreeChat: password join to $roomId failed")
+                            error = if ((it as? FreeChatHttpException)?.statusCode == 429) PasswordJoinError.Locked else PasswordJoinError.Wrong
+                        }
+                    isJoining = false
+                }
+            }
+        }
+
+        return PasswordJoinState(showDialog, isJoining, error, ::handleEvent)
+    }
+}
+
+enum class PasswordJoinError { Wrong, Locked }
+
+data class PasswordJoinState(
+    val showDialog: Boolean,
+    val isJoining: Boolean,
+    val error: PasswordJoinError?,
+    val eventSink: (PasswordJoinEvent) -> Unit,
+)
+
+sealed interface PasswordJoinEvent {
+    data object OpenDialog : PasswordJoinEvent
+    data object CloseDialog : PasswordJoinEvent
+    data class Submit(val password: String) : PasswordJoinEvent
+}
+
+/** Statuses where the user is outside a room they may hold a password for. */
+fun JoinAuthorisationStatus.allowsPasswordJoin(): Boolean = when (this) {
+    JoinAuthorisationStatus.NeedInvite,
+    JoinAuthorisationStatus.CanKnock,
+    JoinAuthorisationStatus.Restricted,
+    JoinAuthorisationStatus.Unknown,
+    JoinAuthorisationStatus.Unauthorized -> true
+    else -> false
+}
+
+@Composable
+fun PasswordJoinFooter(state: PasswordJoinState, modifier: Modifier = Modifier) {
+    TextButton(
+        text = stringResource(CommonStrings.freechat_pw_join_action),
+        onClick = { state.eventSink(PasswordJoinEvent.OpenDialog) },
+        modifier = modifier.fillMaxWidth(),
+    )
+    if (state.showDialog) {
+        PasswordDialog(
+            title = stringResource(CommonStrings.freechat_pw_join_title),
+            subtitle = stringResource(CommonStrings.freechat_pw_join_description),
+            label = stringResource(CommonStrings.freechat_pw_label),
+            submitText = stringResource(CommonStrings.freechat_pw_join_button),
+            enabled = !state.isJoining,
+            error = when (state.error) {
+                PasswordJoinError.Wrong -> stringResource(CommonStrings.freechat_pw_join_wrong)
+                PasswordJoinError.Locked -> stringResource(CommonStrings.freechat_pw_join_locked)
+                null -> null
+            },
+            onSubmit = { state.eventSink(PasswordJoinEvent.Submit(it)) },
+            onDismissRequest = { state.eventSink(PasswordJoinEvent.CloseDialog) },
+        )
+    }
+}
