+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.launch
+import timber.log.Timber
+
+/** FreeChat: admin settings for the room's join password and screenshot blocking. */
+@Inject
+class PrivateRoomPresenter(
+    private val room: JoinedRoom,
+    private val client: MatrixClient,
+) : Presenter<PrivateRoomState> {
+    @Composable
+    override fun present(): PrivateRoomState {
+        val scope = rememberCoroutineScope()
+        val roomInfo by room.roomInfoFlow.collectAsState()
+        val isAdmin by produceState(false, roomInfo) {
+            value = room.userRole(room.sessionId).getOrNull()?.let { it.powerLevel >= Disappearing.ADMIN_POWER_LEVEL } == true
+        }
+        val blockScreenshots by remember {
+            room.stateEventContentFlow(FreeChatApi.PRIVACY_STATE_TYPE).map(FreeChatApi::blockScreenshotsFromContent)
+        }.collectAsState(initial = false)
+        var hasPassword by remember { mutableStateOf<Boolean?>(null) }
+        var showPasswordDialog by remember { mutableStateOf(false) }
+        var isSaving by remember { mutableStateOf(false) }
+        var error by remember { mutableStateOf<PrivateRoomError?>(null) }
+
+        LaunchedEffect(isAdmin) {
+            if (!isAdmin || hasPassword != null) return@LaunchedEffect
+            client.hasJoinPassword(room.roomId)
+                .onSuccess { hasPassword = it }
+                .onFailure { Timber.w(it, "FreeChat: cannot read join password state of ${room.roomId}") }
+        }
+
+        fun savePassword(password: String?) = scope.launch {
+            isSaving = true
+            client.setJoinPassword(room.roomId, password)
+                .onSuccess { hasPassword = password != null }
+                .onFailure {
+                    Timber.e(it, "FreeChat: failed to change join password of ${room.roomId}")
+                    error = PrivateRoomError.Password
+                }
+            isSaving = false
+        }
+
+        fun handleEvent(event: PrivateRoomEvent) {
+            when (event) {
+                PrivateRoomEvent.OpenPasswordDialog -> showPasswordDialog = true
+                PrivateRoomEvent.ClosePasswordDialog -> showPasswordDialog = false
+                is PrivateRoomEvent.SetPassword -> {
+                    showPasswordDialog = false
+                    savePassword(event.password)
+                }
+                PrivateRoomEvent.RemovePassword -> savePassword(null)
+                is PrivateRoomEvent.SetBlockScreenshots -> scope.launch {
+                    room.sendStateEvent(FreeChatApi.PRIVACY_STATE_TYPE, "", FreeChatApi.contentForBlockScreenshots(event.block))
+                        .onFailure {
+                            Timber.e(it, "FreeChat: failed to change screenshot setting of ${room.roomId}")
+                            error = PrivateRoomError.Screenshots
+                        }
+                }
+                PrivateRoomEvent.ClearError -> error = null
+            }
+        }
+
+        return PrivateRoomState(
+            isAdmin = isAdmin,
+            hasPassword = hasPassword,
+            blockScreenshots = blockScreenshots,
+            isSaving = isSaving,
+            showPasswordDialog = showPasswordDialog,
+            error = error,
+            eventSink = ::handleEvent,
+        )
+    }
+}
+
+enum class PrivateRoomError { Password, Screenshots }
+
+data class PrivateRoomState(
+    val isAdmin: Boolean,
+    /** Null until known. */
+    val hasPassword: Boolean?,
+    val blockScreenshots: Boolean,
+    val isSaving: Boolean,
+    val showPasswordDialog: Boolean,
+    val error: PrivateRoomError?,
+    val eventSink: (PrivateRoomEvent) -> Unit,
+)
+
+sealed interface PrivateRoomEvent {
+    data object OpenPasswordDialog : PrivateRoomEvent
+    data object ClosePasswordDialog : PrivateRoomEvent
+    data class SetPassword(val password: String) : PrivateRoomEvent
+    data object RemovePassword : PrivateRoomEvent
+    data class SetBlockScreenshots(val block: Boolean) : PrivateRoomEvent
+    data object ClearError : PrivateRoomEvent
+}
