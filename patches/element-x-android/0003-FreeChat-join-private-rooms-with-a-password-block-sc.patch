+class PrivateRoomPresenterTest {
+    /** Records FreeChat API calls and answers GET with whether a password is set. */
+    private class ApiClient(var hasPassword: Boolean = false, val failWith: Throwable? = null) : MatrixClient by FakeMatrixClient() {
+        val calls = mutableListOf<Triple<String, String, String?>>()
+
+        override suspend fun freechatRequest(method: String, path: String, jsonBody: String?): Result<String> {
+            calls += Triple(method, path, jsonBody)
+            failWith?.let { if (method != "GET") return Result.failure(it) }
+            if (method == "PUT") hasPassword = jsonBody?.contains("password") == true
+            return Result.success(if (method == "GET") """{"enabled":$hasPassword}""" else "{}")
+        }
+    }
+
+    private class PrivacyRoom(delegate: JoinedRoom) : JoinedRoom by delegate {
+        val privacy = MutableStateFlow<String?>(null)
+        val sent = mutableListOf<String>()
+
+        override fun stateEventContentFlow(type: String, stateKey: String): Flow<String?> = privacy
+
+        override suspend fun sendStateEvent(type: String, stateKey: String, contentJson: String): Result<Unit> {
+            sent += "$type=$contentJson"
+            privacy.value = contentJson
+            return Result.success(Unit)
+        }
+    }
+
+    private fun aRoom(role: RoomMember.Role = RoomMember.Role.Admin) =
+        PrivacyRoom(FakeJoinedRoom(baseRoom = FakeBaseRoom(userRoleResult = { Result.success(role) })))
+
+    private val passwordPath = "/rooms/${A_ROOM_ID.value.replace("!", "%21").replace(":", "%3A")}/join_password"
+
+    @Test
+    fun `present - non admins see nothing and nothing is fetched`() = runTest {
+        val client = ApiClient()
+        PrivateRoomPresenter(aRoom(RoomMember.Role.Moderator), client).test {
+            assertThat(consumeItemsUntilTimeout().last().isAdmin).isFalse()
+            assertThat(client.calls).isEmpty()
+        }
+    }
+
+    @Test
+    fun `present - admins load the password state and can set and remove it`() = runTest {
+        val client = ApiClient(hasPassword = false)
+        PrivateRoomPresenter(aRoom(), client).test {
+            val loaded = consumeItemsUntilPredicate { it.isAdmin && it.hasPassword == false }.last()
+            loaded.eventSink(PrivateRoomEvent.SetPassword("s3cret-pass"))
+            val set = consumeItemsUntilPredicate { !it.isSaving && it.hasPassword == true }.last()
+            set.eventSink(PrivateRoomEvent.RemovePassword)
+            consumeItemsUntilPredicate { !it.isSaving && it.hasPassword == false }
+            assertThat(client.calls.map { it.first to it.third }).containsExactly(
+                "GET" to null,
+                "PUT" to """{"password":"s3cret-pass"}""",
+                "PUT" to "{}",
+            ).inOrder()
+            assertThat(client.calls.first().second).isEqualTo(passwordPath)
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - toggling screenshot blocking sends the privacy state`() = runTest {
+        val room = aRoom()
+        PrivateRoomPresenter(room, ApiClient()).test {
+            consumeItemsUntilPredicate { it.isAdmin }.last().eventSink(PrivateRoomEvent.SetBlockScreenshots(true))
+            assertThat(consumeItemsUntilPredicate { it.blockScreenshots }.last().blockScreenshots).isTrue()
+            assertThat(room.sent).containsExactly("${FreeChatApi.PRIVACY_STATE_TYPE}={\"block_screenshots\":true}")
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - a failed password change shows an error`() = runTest {
+        PrivateRoomPresenter(aRoom(), ApiClient(failWith = AN_EXCEPTION)).test {
+            consumeItemsUntilPredicate { it.hasPassword == false }.last().eventSink(PrivateRoomEvent.SetPassword("s3cret-pass"))
+            val failed = consumeItemsUntilPredicate { it.error != null }.last()
+            assertThat(failed.error).isEqualTo(PrivateRoomError.Password)
+            assertThat(failed.hasPassword).isFalse()
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+}
