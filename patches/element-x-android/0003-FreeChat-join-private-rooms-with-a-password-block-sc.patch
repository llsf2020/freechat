+package io.element.android.features.joinroom.impl.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.features.joinroom.impl.JoinAuthorisationStatus
+import io.element.android.libraries.architecture.Presenter
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.matrix.api.freechat.FreeChatHttpException
+import io.element.android.libraries.matrix.api.room.RoomInfo
+import io.element.android.libraries.matrix.test.A_ROOM_ID
+import io.element.android.libraries.matrix.test.FakeMatrixClient
+import io.element.android.tests.testutils.consumeItemsUntilPredicate
+import io.element.android.tests.testutils.test
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+
+class PasswordJoinPresenterTest {
+    private class JoinClient(private val answer: Result<String>) : MatrixClient by FakeMatrixClient() {
+        val joined = mutableListOf<RoomId>()
+
+        override suspend fun freechatRequest(method: String, path: String, jsonBody: String?): Result<String> = answer
+
+        override suspend fun joinRoom(roomId: RoomId): Result<RoomInfo?> {
+            joined += roomId
+            return Result.success(null)
+        }
+    }
+
+    private fun PasswordJoinPresenter.forRoom() = Presenter { present(A_ROOM_ID) }
+
+    @Test
+    fun `present - the right password gets an invite, then joins`() = runTest {
+        val client = JoinClient(Result.success("""{"room_id":"${A_ROOM_ID.value}"}"""))
+        PasswordJoinPresenter(client).forRoom().test {
+            awaitItem().eventSink(PasswordJoinEvent.OpenDialog)
+            consumeItemsUntilPredicate { it.showDialog }.last().eventSink(PasswordJoinEvent.Submit("s3cret-pass"))
+            val done = consumeItemsUntilPredicate { !it.isJoining && !it.showDialog }.last()
+            assertThat(done.error).isNull()
+            assertThat(client.joined).containsExactly(A_ROOM_ID)
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - a wrong password keeps the dialog open and does not join`() = runTest {
+        val client = JoinClient(Result.failure(FreeChatHttpException(403, "{}")))
+        PasswordJoinPresenter(client).forRoom().test {
+            awaitItem().eventSink(PasswordJoinEvent.OpenDialog)
+            consumeItemsUntilPredicate { it.showDialog }.last().eventSink(PasswordJoinEvent.Submit("nope"))
+            val failed = consumeItemsUntilPredicate { it.error != null }.last()
+            assertThat(failed.error).isEqualTo(PasswordJoinError.Wrong)
+            assertThat(failed.showDialog).isTrue()
+            assertThat(client.joined).isEmpty()
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `present - too many attempts reports a lockout`() = runTest {
+        PasswordJoinPresenter(JoinClient(Result.failure(FreeChatHttpException(429, "{}")))).forRoom().test {
+            awaitItem().eventSink(PasswordJoinEvent.Submit("x"))
+            assertThat(consumeItemsUntilPredicate { it.error != null }.last().error).isEqualTo(PasswordJoinError.Locked)
+            cancelAndIgnoreRemainingEvents()
+        }
+    }
+
+    @Test
+    fun `password join is offered only to people outside the room`() {
+        assertThat(JoinAuthorisationStatus.NeedInvite.allowsPasswordJoin()).isTrue()
+        assertThat(JoinAuthorisationStatus.CanKnock.allowsPasswordJoin()).isTrue()
+        assertThat(JoinAuthorisationStatus.CanJoin.allowsPasswordJoin()).isFalse()
+        assertThat(JoinAuthorisationStatus.IsKnocked.allowsPasswordJoin()).isFalse()
+    }
+}
