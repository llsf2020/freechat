+        aPrivateRoomState(hasPassword = null),
+        aPrivateRoomState(showPasswordDialog = true),
+        aPrivateRoomState(error = PrivateRoomError.Password),
+    )
+}
+
+internal fun aPrivateRoomState(
+    isAdmin: Boolean = true,
+    hasPassword: Boolean? = false,
+    blockScreenshots: Boolean = false,
+    isSaving: Boolean = false,
+    showPasswordDialog: Boolean = false,
+    error: PrivateRoomError? = null,
+    eventSink: (PrivateRoomEvent) -> Unit = {},
+) = PrivateRoomState(isAdmin, hasPassword, blockScreenshots, isSaving, showPasswordDialog, error, eventSink)
+
+@PreviewsDayNight
+@Composable
+internal fun PrivateRoomItemsPreview(@PreviewParameter(PrivateRoomStateProvider::class) state: PrivateRoomState) =
+    ElementPreview {
+        PrivateRoomItems(state)
+    }
