+/**
+ * Which of [eventIds] still exist on the server; purged ones are left out. Members only. Asks in batches of
+ * [FreeChatApi.MAX_EXISTING_EVENTS], the most the server takes at once.
+ */
+suspend fun MatrixClient.existingEvents(roomId: RoomId, eventIds: Set<EventId>): Result<Set<EventId>> = runCatchingExceptions {
+    eventIds.chunked(FreeChatApi.MAX_EXISTING_EVENTS).flatMapTo(HashSet()) { batch ->
+        val body = JsonObject(mapOf("event_ids" to JsonArray(batch.map { JsonPrimitive(it.value) }))).toString()
+        val response = freechatRequest("POST", FreeChatApi.existingEventsPath(roomId), body).getOrThrow()
         (Json.parseToJsonElement(response).jsonObject["existing"] as? JsonArray).orEmpty()
             .mapNotNull { (it as? JsonPrimitive)?.content?.let(::EventId) }
-            .toSet()
     }
 }
 
