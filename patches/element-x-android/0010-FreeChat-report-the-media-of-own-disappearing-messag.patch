+
+/**
+ * Tells the server which media the user's own disappearing message [eventId] uses, so the files are deleted when it
+ * expires. The SDK encrypts attachments itself, so their IDs cannot go in the event's plaintext. Returns how many the
+ * server kept: none for messages that never expire.
+ */
+suspend fun MatrixClient.reportEventMedia(roomId: RoomId, eventId: EventId, mxcs: List<String>): Result<Int> {
+    val body = JsonObject(
+        mapOf(
+            "event_id" to JsonPrimitive(eventId.value),
+            "mxcs" to JsonArray(mxcs.take(FreeChatApi.MAX_EVENT_MEDIA).map(::JsonPrimitive)),
+        )
+    ).toString()
+    return freechatRequest("POST", FreeChatApi.eventMediaPath(roomId), body).mapCatching { response ->
+        (Json.parseToJsonElement(response).jsonObject["kept"] as? JsonPrimitive)?.longOrNull?.toInt() ?: 0
+    }
+}
