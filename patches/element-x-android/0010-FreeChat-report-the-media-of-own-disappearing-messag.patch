-private fun List<TimelineItem>.markedEventIds(markers: MarkerCache, now: Long): Set<EventId> =
+/** The user's own sent disappearing messages with media not reported yet, and the MXCs of each. */
+internal fun mediaToReport(
+    items: List<TimelineItem>,
+    now: Long,
+    reported: Set<EventId>,
+    markersOf: (TimelineItem.Event) -> ExpiryMarkers,
+): Map<EventId, List<String>> =
+    items.events()
+        .filter { it.isMine && it.content.isMedia }
+        .mapNotNull { event ->
+            val eventId = event.eventId?.takeUnless { it in reported } ?: return@mapNotNull null
+            val m = markersOf(event)
+            val expiresAt = m.expiresAt
+            if (!m.isMarked || (expiresAt != null && expiresAt <= now)) return@mapNotNull null
+            mediaMxcs(event.content).takeIf { it.isNotEmpty() }?.let { eventId to it }
+        }
+        .toMap()
+
+/** MXCs of a message's files and thumbnails; for encrypted media they are the IDs of the encrypted files. */
+internal fun mediaMxcs(content: TimelineItemEventContent): List<String> {
+    val sources: List<MediaSource?> = when (content) {
+        is TimelineItemImageContent -> listOf(content.mediaSource, content.thumbnailSource)
+        is TimelineItemVideoContent -> listOf(content.mediaSource, content.thumbnailSource)
+        is TimelineItemFileContent -> listOf(content.mediaSource, content.thumbnailSource)
+        is TimelineItemStickerContent -> listOf(content.mediaSource, content.thumbnailSource)
+        is TimelineItemEventContentWithAttachment -> listOf(content.mediaSource)
+        is TimelineItemGalleryContent -> content.items.flatMap { listOf(it.mediaSource, it.thumbnailSource) }
+        is TimelineItemAttachmentsContent -> content.attachments.flatMap { listOf(it.mediaSource, it.thumbnailSource) }
+        else -> emptyList()
+    }
+    return sources.mapNotNull { it?.safeUrl?.takeIf { url -> url.startsWith("mxc://") } }.distinct()
+}
