+class NtfyStreamTest {
+    @Test
+    fun `a message event carries the push body`() {
+        val message = NtfyStream.parse("""{"id":"abc123","time":1,"event":"message","topic":"upX","message":"{\"notification\":{}}"}""")
+        assertThat(message?.id).isEqualTo("abc123")
