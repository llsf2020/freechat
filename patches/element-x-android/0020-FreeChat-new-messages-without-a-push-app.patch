+
+    @Test
+    fun `a base64 message is decoded`() {
+        val message = NtfyStream.parse("""{"id":"abc123","event":"message","message":"aGVsbG8=","encoding":"base64"}""")
+        assertThat(message?.body?.let(::String)).isEqualTo("hello")
+    }
+
+    @Test
+    fun `other events and unreadable lines are skipped`() {
+        assertThat(NtfyStream.parse("""{"id":"a","event":"open","topic":"upX"}""")).isNull()
+        assertThat(NtfyStream.parse("""{"id":"b","event":"keepalive","topic":"upX"}""")).isNull()
+        assertThat(NtfyStream.parse("""{"event":"message","message":"x"}""")).isNull()
+        assertThat(NtfyStream.parse("""{"id":"c","event":"message","message":"%%","encoding":"base64"}""")).isNull()
+        assertThat(NtfyStream.parse("not json")).isNull()
+        assertThat(NtfyStream.parse("")).isNull()
+    }
+
+    @Test
+    fun `topics are random and served by a FreeChat server`() {
+        val topic = NtfyUrls.newTopic()
+        assertThat(topic).matches("up[A-Za-z0-9]{32}")
+        assertThat(NtfyUrls.newTopic()).isNotEqualTo(topic)
+    }
+
+    @Test
+    fun `urls are on the homeserver`() {
+        val base = NtfyUrls.base("https://chat.example.org/")
+        assertThat(base).isEqualTo("https://chat.example.org")
+        assertThat(NtfyUrls.base("http://localhost:8008")).isEqualTo("http://localhost:8008")
+        assertThat(NtfyUrls.base("matrix.org")).isNull()
+        assertThat(NtfyUrls.base("ftp://chat.example.org")).isNull()
+        val endpoint = NtfyUrls.endpoint(base!!, "upAbc")
+        assertThat(endpoint).isEqualTo("https://chat.example.org/upAbc?up=1")
+        assertThat(NtfyUrls.gateway(base)).isEqualTo("https://chat.example.org/_matrix/push/v1/notify")
+        assertThat(NtfyUrls.stream(endpoint, null)).isEqualTo("https://chat.example.org/upAbc/json")
+        assertThat(NtfyUrls.stream(endpoint, "m1")).isEqualTo("https://chat.example.org/upAbc/json?since=m1")
+    }
+}
