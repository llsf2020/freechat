+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.pushproviders.unifiedpush.freechat
+
+import android.content.SharedPreferences
+import androidx.core.content.edit
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.ContributesBinding
+import io.element.android.libraries.matrix.api.core.SessionId
+
+/** Where a session using the built-in connection gets its pushes: the ntfy topic on its own server. */
+data class BuiltInSubscription(
+    val sessionId: SessionId,
+    val endpoint: String,
+    val gateway: String,
+)
+
+/**
+ * What the two FreeChat ways of getting new messages without a push app keep per session. Only what they need to work:
+ * when the last check saw a notification, and the random topic of the built-in connection.
+ */
+interface FreeChatPushStore {
+    /** Server time (ms) of the newest notification the last check saw; null when the session does not check. */
+    fun getPollSince(sessionId: SessionId): Long?
+    fun setPollSince(sessionId: SessionId, since: Long?)
+
+    fun getBuiltInSubscription(sessionId: SessionId): BuiltInSubscription?
+    fun setBuiltInSubscription(sessionId: SessionId, endpoint: String?, gateway: String?)
+
+    /** Every session using the built-in connection. */
+    fun getBuiltInSubscriptions(): List<BuiltInSubscription>
+}
+
+@ContributesBinding(AppScope::class)
+class SharedPreferencesFreeChatPushStore(
+    private val sharedPreferences: SharedPreferences,
+) : FreeChatPushStore {
+    override fun getPollSince(sessionId: SessionId): Long? =
+        sharedPreferences.getLong(PREFS_POLL_SINCE + sessionId, -1).takeIf { it >= 0 }
+
+    override fun setPollSince(sessionId: SessionId, since: Long?) {
+        sharedPreferences.edit {
+            if (since == null) remove(PREFS_POLL_SINCE + sessionId) else putLong(PREFS_POLL_SINCE + sessionId, since)
+        }
+    }
+
+    override fun getBuiltInSubscription(sessionId: SessionId): BuiltInSubscription? {
+        val endpoint = sharedPreferences.getString(PREFS_BUILT_IN_ENDPOINT + sessionId, null) ?: return null
+        val gateway = sharedPreferences.getString(PREFS_BUILT_IN_GATEWAY + sessionId, null) ?: return null
+        return BuiltInSubscription(sessionId, endpoint, gateway)
+    }
+
+    override fun setBuiltInSubscription(sessionId: SessionId, endpoint: String?, gateway: String?) {
+        sharedPreferences.edit {
+            if (endpoint == null || gateway == null) {
+                remove(PREFS_BUILT_IN_ENDPOINT + sessionId)
+                remove(PREFS_BUILT_IN_GATEWAY + sessionId)
+            } else {
+                putString(PREFS_BUILT_IN_ENDPOINT + sessionId, endpoint)
+                putString(PREFS_BUILT_IN_GATEWAY + sessionId, gateway)
+            }
+        }
+    }
+
+    override fun getBuiltInSubscriptions(): List<BuiltInSubscription> =
+        sharedPreferences.all.keys
+            .filter { it.startsWith(PREFS_BUILT_IN_ENDPOINT) }
+            .mapNotNull { getBuiltInSubscription(SessionId(it.removePrefix(PREFS_BUILT_IN_ENDPOINT))) }
+
+    companion object {
+        private const val PREFS_POLL_SINCE = "FREECHAT_POLL_SINCE_"
+        private const val PREFS_BUILT_IN_ENDPOINT = "FREECHAT_BUILT_IN_ENDPOINT_"
+        private const val PREFS_BUILT_IN_GATEWAY = "FREECHAT_BUILT_IN_GATEWAY_"
+    }
+}
