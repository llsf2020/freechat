+import io.element.android.libraries.pushstore.api.clientsecret.PushClientSecret
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import timber.log.Timber
+import java.io.IOException
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.TimeUnit
+import kotlin.time.Duration
+import kotlin.time.Duration.Companion.minutes
+import kotlin.time.Duration.Companion.seconds
+
+/**
+ * FreeChat: the built-in connection. Keeps an ntfy JSON stream open to the user's own homeserver for each session using
+ * it, and hands each push to the [PushHandler] like a UnifiedPush app would. Runs inside [BuiltInPushService].
+ */
+@SingleIn(AppScope::class)
+@Inject
+class BuiltInPushConnection(
+    private val pushClientSecret: PushClientSecret,
+    private val pushParser: UnifiedPushParser,
+    private val pushHandler: PushHandler,
+    private val fetchPushForegroundServiceManager: FetchPushForegroundServiceManager,
+) {
+    // Its own client: the app's shared one may log bodies, which would wait for a stream that never ends. ntfy sends a
+    // keepalive every 45 seconds, so a connection silent for longer than the read timeout is dead.
+    private val httpClient = OkHttpClient.Builder()
+        .connectTimeout(30, TimeUnit.SECONDS)
+        .readTimeout(100, TimeUnit.SECONDS)
+        .followRedirects(false)
+        .followSslRedirects(false)
+        .build()
+
+    // The last message read per topic, to resume from after a reconnection. In memory only.
+    private val lastMessageIds = ConcurrentHashMap<String, String>()
+
+    private val networkAvailable = MutableSharedFlow<Unit>(extraBufferCapacity = 1)
+
+    /** The network is back: reconnect now instead of waiting out the backoff. */
+    fun onNetworkAvailable() {
+        networkAvailable.tryEmit(Unit)
+    }
+
+    /** Reads [subscription]'s topic until cancelled, reconnecting whenever the connection drops. */
+    suspend fun run(subscription: BuiltInSubscription) {
+        var backoff = MIN_BACKOFF
+        while (currentCoroutineContext().isActive) {
+            try {
+                read(subscription) { backoff = MIN_BACKOFF }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                // Anything else must not end the loop either: it would take the whole service down.
+                Timber.d(e, "Built-in push connection dropped")
+            }
+            withTimeoutOrNull(backoff) { networkAvailable.first() }
+            backoff = (backoff * 2).coerceAtMost(MAX_BACKOFF)
+        }
+    }
+
+    private suspend fun read(subscription: BuiltInSubscription, onConnected: () -> Unit) {
+        val url = NtfyUrls.stream(subscription.endpoint, lastMessageIds[subscription.endpoint])
+        val call = httpClient.newCall(Request.Builder().url(url).build())
+        coroutineScope {
+            // Blocking reads do not see coroutine cancellation; cancelling the call ends them.
+            val cancelWithScope = launch {
+                try {
+                    awaitCancellation()
+                } finally {
+                    call.cancel()
+                }
+            }
+            try {
+                withContext(Dispatchers.IO) {
+                    call.execute().use { response ->
+                        if (!response.isSuccessful) throw IOException("HTTP ${response.code}")
+                        onConnected()
+                        val source = response.body.source()
+                        while (true) {
+                            val line = source.readUtf8Line() ?: break
+                            val message = NtfyStream.parse(line) ?: continue
+                            lastMessageIds[subscription.endpoint] = message.id
+                            handle(subscription, message)
+                        }
+                    }
+                }
+            } finally {
+                cancelWithScope.cancel()
+            }
+        }
+    }
+
+    private suspend fun handle(subscription: BuiltInSubscription, message: NtfyStream.Message) {
+        val clientSecret = pushClientSecret.getSecretForUser(subscription.sessionId)
+        val pushData = pushParser.parse(message.body, clientSecret)
+        if (pushData == null) {
+            pushHandler.handleInvalid(providerInfo = PROVIDER_INFO, data = String(message.body))
+            return
+        }
+        // Keeps the device awake while the notification is fetched, as for UnifiedPush.
+        fetchPushForegroundServiceManager.start()
+        if (!pushHandler.handle(pushData = pushData, providerInfo = PROVIDER_INFO)) {
+            fetchPushForegroundServiceManager.stop()
+        }
+    }
+
+    companion object {
+        const val PROVIDER_INFO = "FreeChat - built-in connection"
+        private val MIN_BACKOFF: Duration = 5.seconds
+        private val MAX_BACKOFF: Duration = 5.minutes
+    }
+}
