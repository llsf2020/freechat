+package io.element.android.libraries.pushproviders.unifiedpush.freechat
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.ContributesIntoSet
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.SessionId
+import io.element.android.libraries.pushproviders.api.Config
+import io.element.android.libraries.pushproviders.api.Distributor
+import io.element.android.libraries.pushproviders.api.PushProvider
+import io.element.android.libraries.pushproviders.api.PusherSubscriber
+import io.element.android.libraries.ui.strings.CommonStrings
+import io.element.android.services.toolbox.api.strings.StringProvider
+
+/**
+ * FreeChat: real-time pushes without a UnifiedPush app. The app itself does what the ntfy app would: it subscribes to a
+ * random topic of the ntfy on the user's own homeserver and registers it as the pusher, so pushes go from the homeserver
+ * to the phone without any third party. Costs a permanent notification and some battery for the open connection.
+ */
+@ContributesIntoSet(AppScope::class)
+class BuiltInPushProvider(
+    private val store: FreeChatPushStore,
+    private val pusherSubscriber: PusherSubscriber,
+    private val serviceStarter: BuiltInPushServiceStarter,
+    private val stringProvider: StringProvider,
+) : PushProvider {
+    override val index = FreeChatPushConfig.BUILT_IN_INDEX
+    override val name = FreeChatPushConfig.BUILT_IN_NAME
+    override val supportMultipleDistributors = false
+
+    private fun distributor() = Distributor(FreeChatPushConfig.BUILT_IN_DISTRIBUTOR, stringProvider.getString(CommonStrings.freechat_push_built_in))
+
+    override fun getDistributors(): List<Distributor> = listOf(distributor())
+
+    override suspend fun registerWith(matrixClient: MatrixClient, distributor: Distributor): Result<Unit> {
+        val sessionId = matrixClient.sessionId
+        // Registered again at every start: keep the topic, so pushes sent meanwhile are not lost.
+        val subscription = store.getBuiltInSubscription(sessionId) ?: run {
+            val base = NtfyUrls.base(matrixClient.homeserverUrl)
+                ?: return Result.failure(IllegalStateException("FreeChat: unusable homeserver URL"))
+            BuiltInSubscription(sessionId, NtfyUrls.endpoint(base, NtfyUrls.newTopic()), NtfyUrls.gateway(base))
+        }
+        return pusherSubscriber.registerPusher(matrixClient, subscription.endpoint, subscription.gateway)
+            .onSuccess {
+                store.setBuiltInSubscription(sessionId, subscription.endpoint, subscription.gateway)
+                serviceStarter.refresh()
+            }
+    }
+
+    override suspend fun getCurrentDistributorValue(sessionId: SessionId): String? =
+        FreeChatPushConfig.BUILT_IN_DISTRIBUTOR.takeIf { store.getBuiltInSubscription(sessionId) != null }
+
+    override suspend fun getCurrentDistributor(sessionId: SessionId): Distributor? =
+        distributor().takeIf { store.getBuiltInSubscription(sessionId) != null }
+
+    override suspend fun unregister(matrixClient: MatrixClient): Result<Unit> {
+        val subscription = store.getBuiltInSubscription(matrixClient.sessionId) ?: return Result.success(Unit)
+        return pusherSubscriber.unregisterPusher(matrixClient, subscription.endpoint, subscription.gateway)
+            .onSuccess { stop(matrixClient.sessionId) }
+    }
+
+    // The homeserver drops the pusher along with the session.
+    override suspend fun onSessionDeleted(sessionId: SessionId) = stop(sessionId)
+
+    private fun stop(sessionId: SessionId) {
+        store.setBuiltInSubscription(sessionId, null, null)
+        serviceStarter.refresh()
+    }
+
+    override suspend fun getPushConfig(sessionId: SessionId): Config? =
+        store.getBuiltInSubscription(sessionId)?.let { Config(url = it.gateway, pushKey = it.endpoint) }
+
+    override fun canRotateToken(): Boolean = false
+}
