+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.pushproviders.unifiedpush.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.matrix.test.AN_EXCEPTION
+import io.element.android.libraries.matrix.test.A_SECRET
+import io.element.android.libraries.matrix.test.A_SESSION_ID
+import io.element.android.libraries.matrix.test.FakeMatrixClient
+import io.element.android.libraries.push.test.FakePusherSubscriber
+import io.element.android.libraries.push.test.test.FakePushHandler
+import io.element.android.libraries.pushproviders.api.Config
+import io.element.android.libraries.pushstore.test.userpushstore.clientsecret.FakePushClientSecret
+import io.element.android.libraries.workmanager.api.WorkManagerRequestBuilder
+import io.element.android.libraries.workmanager.api.WorkManagerRequestType
+import io.element.android.libraries.workmanager.test.FakeWorkManagerScheduler
+import io.element.android.services.toolbox.test.strings.FakeStringProvider
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+
+class FreeChatPushProvidersTest {
+    private val store = FakeFreeChatPushStore()
+
+    @Test
+    fun `periodic checks start from the server's newest notification and are scheduled once`() = runTest {
+        val submitted = mutableListOf<WorkManagerRequestBuilder>()
+        val cancelled = mutableListOf<Pair<Any, WorkManagerRequestType?>>()
+        var pending = false
+        val provider = PollingPushProvider(
+            store = store,
+            notificationsPoller = NotificationsPoller(
+                pushHandler = FakePushHandler(),
+                pushClientSecret = FakePushClientSecret(getSecretForUserResult = { A_SECRET }),
+                store = store,
+            ),
+            workManagerScheduler = FakeWorkManagerScheduler(
+                submitLambda = { submitted.add(it); pending = true },
+                hasPendingWorkLambda = { _, type -> type == WorkManagerRequestType.PUSH_POLL && pending },
+                cancelLambda = { sessionId, type -> cancelled.add(sessionId to type); pending = false },
+            ),
+            stringProvider = FakeStringProvider("Check every 15 minutes"),
+        )
+        val client = FakeMatrixClient(clientApiRequestLambda = { _, _, _ -> Result.success("""{"notifications":[]}""") })
+        assertThat(provider.getCurrentDistributor(A_SESSION_ID)).isNull()
+
+        assertThat(provider.registerWith(client, provider.getDistributors().single()).isSuccess).isTrue()
+        provider.registerWith(client, provider.getDistributors().single())
+
+        assertThat(submitted).hasSize(1)
+        assertThat(store.getPollSince(A_SESSION_ID)).isNotNull()
+        assertThat(provider.getCurrentDistributor(A_SESSION_ID)?.value).isEqualTo(FreeChatPushConfig.POLLING_DISTRIBUTOR)
+        assertThat(provider.getCurrentDistributor(A_SESSION_ID)?.name).isEqualTo("Check every 15 minutes")
+        assertThat(provider.getPushConfig(A_SESSION_ID)).isNull()
+
+        assertThat(provider.unregister(client).isSuccess).isTrue()
+        assertThat(cancelled).containsExactly(A_SESSION_ID to WorkManagerRequestType.PUSH_POLL)
+        assertThat(provider.getCurrentDistributor(A_SESSION_ID)).isNull()
+    }
+
+    @Test
+    fun `the built-in connection registers a random topic on the homeserver and keeps it`() = runTest {
+        val registered = mutableListOf<Pair<String, String>>()
+        var refreshes = 0
+        val provider = builtInProvider(
+            subscriber = FakePusherSubscriber(registerPusherResult = { _, key, gateway -> registered.add(key to gateway); Result.success(Unit) }),
+            onRefresh = { refreshes++ },
+        )
+        val client = FakeMatrixClient(homeserverUrl = "https://chat.example.org")
+
+        assertThat(provider.registerWith(client, provider.getDistributors().single()).isSuccess).isTrue()
+        provider.registerWith(client, provider.getDistributors().single())
+
+        val (endpoint, gateway) = registered.first()
+        assertThat(endpoint).matches("https://chat\\.example\\.org/up[A-Za-z0-9]{32}\\?up=1")
+        assertThat(gateway).isEqualTo("https://chat.example.org/_matrix/push/v1/notify")
+        assertThat(registered).containsExactly(endpoint to gateway, endpoint to gateway)
+        assertThat(store.getBuiltInSubscriptions().map { it.endpoint }).containsExactly(endpoint)
+        assertThat(provider.getPushConfig(A_SESSION_ID)).isEqualTo(Config(url = gateway, pushKey = endpoint))
+        assertThat(provider.getCurrentDistributor(A_SESSION_ID)?.value).isEqualTo(FreeChatPushConfig.BUILT_IN_DISTRIBUTOR)
+        assertThat(refreshes).isEqualTo(2)
+    }
+
+    @Test
+    fun `the built-in connection is not kept when the homeserver refuses the pusher`() = runTest {
+        val provider = builtInProvider(subscriber = FakePusherSubscriber(registerPusherResult = { _, _, _ -> Result.failure(AN_EXCEPTION) }))
+        val result = provider.registerWith(FakeMatrixClient(homeserverUrl = "https://chat.example.org"), provider.getDistributors().single())
+        assertThat(result.isFailure).isTrue()
+        assertThat(provider.getCurrentDistributor(A_SESSION_ID)).isNull()
+    }
+
+    @Test
+    fun `stopping the built-in connection removes the pusher and the topic`() = runTest {
+        store.setBuiltInSubscription(A_SESSION_ID, ENDPOINT, GATEWAY)
+        val removed = mutableListOf<Pair<String, String>>()
+        var refreshes = 0
+        val provider = builtInProvider(
+            subscriber = FakePusherSubscriber(unregisterPusherResult = { _, key, gateway -> removed.add(key to gateway); Result.success(Unit) }),
+            onRefresh = { refreshes++ },
+        )
+        assertThat(provider.unregister(FakeMatrixClient()).isSuccess).isTrue()
+        assertThat(removed).containsExactly(ENDPOINT to GATEWAY)
+        assertThat(store.getBuiltInSubscriptions()).isEmpty()
+        assertThat(refreshes).isEqualTo(1)
+    }
+
+    @Test
+    fun `a pusher that cannot be removed keeps the built-in connection`() = runTest {
+        store.setBuiltInSubscription(A_SESSION_ID, ENDPOINT, GATEWAY)
+        val provider = builtInProvider(subscriber = FakePusherSubscriber(unregisterPusherResult = { _, _, _ -> Result.failure(AN_EXCEPTION) }))
+        assertThat(provider.unregister(FakeMatrixClient()).isFailure).isTrue()
+        assertThat(store.getBuiltInSubscriptions()).isNotEmpty()
+    }
+
+    @Test
+    fun `a deleted session stops using the built-in connection`() = runTest {
+        store.setBuiltInSubscription(A_SESSION_ID, ENDPOINT, GATEWAY)
+        builtInProvider(subscriber = FakePusherSubscriber()).onSessionDeleted(A_SESSION_ID)
+        assertThat(store.getBuiltInSubscriptions()).isEmpty()
+    }
+
+    @Test
+    fun `the push app comes first, then periodic checks, then the built-in connection`() {
+        assertThat(FreeChatPushConfig.POLLING_INDEX).isGreaterThan(io.element.android.libraries.pushproviders.unifiedpush.UnifiedPushConfig.INDEX)
+        assertThat(FreeChatPushConfig.BUILT_IN_INDEX).isGreaterThan(FreeChatPushConfig.POLLING_INDEX)
+    }
+
+    private fun builtInProvider(subscriber: FakePusherSubscriber, onRefresh: () -> Unit = {}) = BuiltInPushProvider(
+        store = store,
+        pusherSubscriber = subscriber,
+        serviceStarter = object : BuiltInPushServiceStarter {
+            override fun refresh() = onRefresh()
+        },
+        stringProvider = FakeStringProvider("Built-in connection"),
+    )
+
+    private companion object {
+        const val ENDPOINT = "https://chat.example.org/upAbc?up=1"
+        const val GATEWAY = "https://chat.example.org/_matrix/push/v1/notify"
+    }
+}
