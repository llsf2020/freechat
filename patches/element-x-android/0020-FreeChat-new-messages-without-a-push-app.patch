+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.pushproviders.unifiedpush.freechat
+
+import dev.zacsweers.metro.Inject
+import io.element.android.libraries.core.extensions.runCatchingExceptions
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.EventId
+import io.element.android.libraries.matrix.api.core.RoomId
+import io.element.android.libraries.pushproviders.api.PushData
+import io.element.android.libraries.pushproviders.api.PushHandler
+import io.element.android.libraries.pushstore.api.clientsecret.PushClientSecret
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+
+/**
+ * Asks the homeserver which messages the user would have been notified about since the last check, and hands the
+ * unread ones to the [PushHandler] as if they had been pushed, so they are shown like pushed ones.
+ */
+@Inject
+class NotificationsPoller(
+    private val pushHandler: PushHandler,
+    private val pushClientSecret: PushClientSecret,
+    private val store: FreeChatPushStore,
+) {
+    /** Starts checking from the newest notification on the server, so older ones are not shown again. */
+    suspend fun start(client: MatrixClient, now: Long = System.currentTimeMillis()) {
+        val newest = fetch(client, limit = 1).getOrNull()?.maxOfOrNull { it.ts }
+        store.setPollSince(client.sessionId, newest ?: now)
+    }
+
+    /** Returns how many new notifications were handed over. */
+    suspend fun poll(client: MatrixClient): Result<Int> = runCatchingExceptions {
+        val since = store.getPollSince(client.sessionId)
+        if (since == null) {
+            start(client)
+            return@runCatchingExceptions 0
+        }
+        val newer = fetch(client, limit = LIMIT).getOrThrow().filter { it.ts > since }
+        val clientSecret = pushClientSecret.getSecretForUser(client.sessionId)
+        val unread = newer.filterNot { it.read }.sortedBy { it.ts }.mapNotNull { it.toPushData(clientSecret) }
+        for (pushData in unread) {
+            pushHandler.handle(pushData = pushData, providerInfo = PROVIDER_INFO)
+        }
+        newer.maxOfOrNull { it.ts }?.let { store.setPollSince(client.sessionId, it) }
+        unread.size
+    }
+
+    // A malformed ID is skipped rather than failing every later check too.
+    private fun Notification.toPushData(clientSecret: String): PushData? = runCatchingExceptions {
+        PushData(eventId = EventId(event.eventId), roomId = RoomId(roomId), unread = null, clientSecret = clientSecret)
+    }.getOrNull()
+
+    private suspend fun fetch(client: MatrixClient, limit: Int): Result<List<Notification>> =
+        client.clientApiRequest("GET", "/_matrix/client/v3/notifications?limit=$limit", null).mapCatching { body ->
+            json.decodeFromString<NotificationsResponse>(body).notifications
+        }
+
+    @Serializable
+    internal data class NotificationsResponse(val notifications: List<Notification> = emptyList())
+
+    @Serializable
+    internal data class Notification(
+        @SerialName("room_id") val roomId: String = "",
+        val event: NotifiedEvent = NotifiedEvent(),
+        val ts: Long = 0,
+        val read: Boolean = false,
+    )
+
+    @Serializable
+    internal data class NotifiedEvent(@SerialName("event_id") val eventId: String = "")
+
+    companion object {
+        /** Most notifications one check asks for; the server's own default. */
+        const val LIMIT = 50
+        const val PROVIDER_INFO = "FreeChat - periodic check"
+
+        private val json = Json { ignoreUnknownKeys = true }
+    }
+}
