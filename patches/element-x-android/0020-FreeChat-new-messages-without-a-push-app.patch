+package io.element.android.libraries.pushproviders.unifiedpush.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.matrix.api.core.EventId
+import io.element.android.libraries.matrix.test.AN_EXCEPTION
+import io.element.android.libraries.matrix.test.A_SECRET
+import io.element.android.libraries.matrix.test.A_SESSION_ID
+import io.element.android.libraries.matrix.test.FakeMatrixClient
+import io.element.android.libraries.push.test.test.FakePushHandler
+import io.element.android.libraries.pushproviders.api.PushData
+import io.element.android.libraries.pushstore.test.userpushstore.clientsecret.FakePushClientSecret
+import kotlinx.coroutines.test.runTest
+import org.junit.Test
+
+class NotificationsPollerTest {
+    private val handled = mutableListOf<PushData>()
+    private val store = FakeFreeChatPushStore()
+    private val poller = NotificationsPoller(
+        pushHandler = FakePushHandler(handleResult = { pushData, _ -> handled.add(pushData) }),
+        pushClientSecret = FakePushClientSecret(getSecretForUserResult = { A_SECRET }),
+        store = store,
+    )
+    private val paths = mutableListOf<String>()
+
+    private fun client(response: Result<String>) = FakeMatrixClient(
+        clientApiRequestLambda = { method, path, _ ->
+            assertThat(method).isEqualTo("GET")
+            paths.add(path)
+            response
+        },
+    )
+
+    @Test
+    fun `starts from the newest notification on the server`() = runTest {
+        poller.start(client(Result.success(notifications(notification("\$e1", ts = 500)))), now = 9)
+        assertThat(store.getPollSince(A_SESSION_ID)).isEqualTo(500)
+        assertThat(paths).containsExactly("/_matrix/client/v3/notifications?limit=1")
+    }
+
+    @Test
+    fun `starts from now when the server cannot be asked or has nothing`() = runTest {
+        poller.start(client(Result.failure(AN_EXCEPTION)), now = 9)
+        assertThat(store.getPollSince(A_SESSION_ID)).isEqualTo(9)
+        poller.start(client(Result.success(notifications())), now = 10)
+        assertThat(store.getPollSince(A_SESSION_ID)).isEqualTo(10)
+    }
+
+    @Test
+    fun `hands over the new unread notifications, oldest first`() = runTest {
+        store.setPollSince(A_SESSION_ID, 100)
+        val body = notifications(
+            notification("\$new2", ts = 300),
+            notification("\$read", ts = 250, read = true),
+            notification("\$new1", ts = 200),
+            notification("\$old", ts = 100),
+            """{"room_id":"not a room","event":{"event_id":"${'$'}bad"},"ts":260,"read":false}""",
+        )
+        val result = poller.poll(client(Result.success(body)))
+        assertThat(result.getOrNull()).isEqualTo(2)
+        assertThat(handled.map { it.eventId }).containsExactly(EventId("\$new1"), EventId("\$new2")).inOrder()
+        assertThat(handled.map { it.clientSecret }.toSet()).containsExactly(A_SECRET)
+        assertThat(store.getPollSince(A_SESSION_ID)).isEqualTo(300)
+        assertThat(paths).containsExactly("/_matrix/client/v3/notifications?limit=50")
+    }
+
+    @Test
+    fun `nothing new keeps the position`() = runTest {
+        store.setPollSince(A_SESSION_ID, 100)
+        assertThat(poller.poll(client(Result.success(notifications(notification("\$old", ts = 100))))).getOrNull()).isEqualTo(0)
+        assertThat(handled).isEmpty()
+        assertThat(store.getPollSince(A_SESSION_ID)).isEqualTo(100)
+    }
+
+    @Test
+    fun `a failed check keeps the position`() = runTest {
+        store.setPollSince(A_SESSION_ID, 100)
+        assertThat(poller.poll(client(Result.failure(AN_EXCEPTION))).isFailure).isTrue()
+        assertThat(store.getPollSince(A_SESSION_ID)).isEqualTo(100)
+    }
+
+    @Test
+    fun `the first check only sets the position`() = runTest {
+        assertThat(poller.poll(client(Result.success(notifications(notification("\$e1", ts = 500))))).getOrNull()).isEqualTo(0)
+        assertThat(handled).isEmpty()
+        assertThat(store.getPollSince(A_SESSION_ID)).isEqualTo(500)
+    }
+
+    private fun notifications(vararg items: String) = """{"notifications":[${items.joinToString(",")}],"next_token":"1"}"""
+
+    private fun notification(eventId: String, ts: Long, read: Boolean = false) =
+        """{"room_id":"!room:example.org","event":{"event_id":"$eventId","type":"m.room.message"},"ts":$ts,"read":$read,"actions":["notify"]}"""
+}
