+/*
+ * Copyright 2026 FreeChat contributors
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.pushproviders.unifiedpush.freechat
+
+import io.element.android.libraries.matrix.api.core.SessionId
+
+class FakeFreeChatPushStore : FreeChatPushStore {
+    val pollSince = mutableMapOf<SessionId, Long>()
+    val subscriptions = mutableMapOf<SessionId, BuiltInSubscription>()
+
+    override fun getPollSince(sessionId: SessionId): Long? = pollSince[sessionId]
+
+    override fun setPollSince(sessionId: SessionId, since: Long?) {
+        if (since == null) pollSince.remove(sessionId) else pollSince[sessionId] = since
+    }
+
+    override fun getBuiltInSubscription(sessionId: SessionId): BuiltInSubscription? = subscriptions[sessionId]
+
+    override fun setBuiltInSubscription(sessionId: SessionId, endpoint: String?, gateway: String?) {
+        if (endpoint == null || gateway == null) {
+            subscriptions.remove(sessionId)
+        } else {
+            subscriptions[sessionId] = BuiltInSubscription(sessionId, endpoint, gateway)
+        }
+    }
+
+    override fun getBuiltInSubscriptions(): List<BuiltInSubscription> = subscriptions.values.toList()
+}
