+package io.element.android.libraries.pushproviders.unifiedpush.freechat
+
+import io.element.android.libraries.core.extensions.runCatchingExceptions
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+import java.net.URI
+import java.security.SecureRandom
+import kotlin.io.encoding.Base64
+
+/** The ntfy topic URLs of the built-in connection, on the user's own homeserver (FreeChat runs ntfy there). */
+object NtfyUrls {
+    private const val TOPIC_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
+
+    /** `https://host[:port]` of [homeserverUrl], or null when it is not an HTTP(S) URL. */
+    fun base(homeserverUrl: String): String? {
+        val uri = runCatchingExceptions { URI(homeserverUrl) }.getOrNull() ?: return null
+        if (uri.scheme !in listOf("https", "http") || uri.host.isNullOrEmpty()) return null
+        return "${uri.scheme}://${uri.rawAuthority}"
+    }
+
+    /**
+     * A new random topic. ntfy on a FreeChat server only serves topics starting with `up`; the random part keeps
+     * others from reading or posting to it.
+     */
+    fun newTopic(random: SecureRandom = SecureRandom()): String =
+        "up" + (1..32).map { TOPIC_CHARS[random.nextInt(TOPIC_CHARS.length)] }.joinToString("")
+
+    /** What the homeserver pushes to: the topic in UnifiedPush mode, through ntfy's Matrix gateway. */
+    fun endpoint(base: String, topic: String) = "$base/$topic?up=1"
+
+    fun gateway(base: String) = "$base/_matrix/push/v1/notify"
+
+    /** Where the phone reads the topic: one JSON object per line, as long as the connection stays open. */
+    fun stream(endpoint: String, since: String?): String =
+        endpoint.substringBefore('?') + "/json" + (since?.let { "?since=$it" } ?: "")
+}
+
+/** One line of an ntfy JSON stream: `open` and `keepalive` events, and `message` events carrying a push. */
+object NtfyStream {
+    @Serializable
+    internal data class Event(
+        val id: String = "",
+        val event: String = "",
+        val message: String? = null,
+        val encoding: String? = null,
+    )
+
+    private val json = Json { ignoreUnknownKeys = true }
+
+    /** A message: its ID, to resume from after a reconnection, and the push body the homeserver sent. */
+    class Message(val id: String, val body: ByteArray)
+
+    /** The message on [line], or null for any other event or a line that cannot be read. */
+    fun parse(line: String): Message? {
+        if (line.isBlank()) return null
+        val event = runCatchingExceptions { json.decodeFromString<Event>(line) }.getOrNull() ?: return null
+        if (event.event != "message" || event.id.isEmpty()) return null
+        val message = event.message ?: return null
+        // ntfy sends bodies that are not UTF-8 in base64.
+        val body = if (event.encoding == "base64") {
+            runCatchingExceptions { Base64.decode(message) }.getOrNull() ?: return null
+        } else {
+            message.toByteArray()
+        }
+        return Message(event.id, body)
+    }
+}
