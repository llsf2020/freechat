+ */
+
+package io.element.android.libraries.pushproviders.unifiedpush.freechat
+
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.ContributesIntoSet
+import io.element.android.libraries.matrix.api.MatrixClient
+import io.element.android.libraries.matrix.api.core.SessionId
+import io.element.android.libraries.pushproviders.api.Config
+import io.element.android.libraries.pushproviders.api.Distributor
+import io.element.android.libraries.pushproviders.api.PushProvider
+import io.element.android.libraries.ui.strings.CommonStrings
+import io.element.android.libraries.workmanager.api.WorkManagerRequestType
+import io.element.android.libraries.workmanager.api.WorkManagerScheduler
+import io.element.android.services.toolbox.api.strings.StringProvider
+
+/**
+ * FreeChat: no push at all. The phone asks its own homeserver for new messages about every 15 minutes (later while it
+ * saves battery), and shows them like pushed ones. Nothing but the homeserver is involved, and it registers no pusher.
+ */
+@ContributesIntoSet(AppScope::class)
+class PollingPushProvider(
+    private val store: FreeChatPushStore,
+    private val notificationsPoller: NotificationsPoller,
+    private val workManagerScheduler: WorkManagerScheduler,
+    private val stringProvider: StringProvider,
+) : PushProvider {
+    override val index = FreeChatPushConfig.POLLING_INDEX
+    override val name = FreeChatPushConfig.POLLING_NAME
+    override val supportMultipleDistributors = false
+
+    private fun distributor() = Distributor(FreeChatPushConfig.POLLING_DISTRIBUTOR, stringProvider.getString(CommonStrings.freechat_push_polling))
+
+    override fun getDistributors(): List<Distributor> = listOf(distributor())
+
+    override suspend fun registerWith(matrixClient: MatrixClient, distributor: Distributor): Result<Unit> {
+        val sessionId = matrixClient.sessionId
+        if (store.getPollSince(sessionId) == null) {
+            notificationsPoller.start(matrixClient)
+        }
+        if (!workManagerScheduler.hasPendingWork(sessionId, WorkManagerRequestType.PUSH_POLL)) {
+            workManagerScheduler.submit(PushPollRequestBuilder(sessionId))
+        }
+        return Result.success(Unit)
+    }
+
+    override suspend fun getCurrentDistributorValue(sessionId: SessionId): String? =
+        FreeChatPushConfig.POLLING_DISTRIBUTOR.takeIf { store.getPollSince(sessionId) != null }
+
+    override suspend fun getCurrentDistributor(sessionId: SessionId): Distributor? =
+        distributor().takeIf { store.getPollSince(sessionId) != null }
+
+    override suspend fun unregister(matrixClient: MatrixClient): Result<Unit> {
+        stop(matrixClient.sessionId)
+        return Result.success(Unit)
+    }
+
+    override suspend fun onSessionDeleted(sessionId: SessionId) = stop(sessionId)
+
+    private fun stop(sessionId: SessionId) {
+        workManagerScheduler.cancel(sessionId, WorkManagerRequestType.PUSH_POLL)
+        store.setPollSince(sessionId, null)
+    }
+
+    // There is no pusher, so nothing to test a push against.
+    override suspend fun getPushConfig(sessionId: SessionId): Config? = null
+
+    override fun canRotateToken(): Boolean = false
+}
