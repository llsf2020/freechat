+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.matrix.api.freechat
+
+import kotlinx.coroutines.flow.Flow
+
+/**
+ * FreeChat: whether notifications show what a message says and who sent it. Off by default: Android keeps
+ * notifications (in its notification history, on the lock screen, on connected watches), so they only say
+ * that there are new messages.
+ */
+interface NotificationPrivacyStore {
+    val showContent: Flow<Boolean>
+    suspend fun setShowContent(show: Boolean)
+}
