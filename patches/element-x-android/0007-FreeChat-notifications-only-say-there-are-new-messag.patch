diff --git a/libraries/preferences/impl/src/main/kotlin/io/element/android/libraries/preferences/impl/freechat/DataStoreNotificationPrivacyStore.kt b/libraries/preferences/impl/src/main/kotlin/io/element/android/libraries/preferences/impl/freechat/DataStoreNotificationPrivacyStore.kt
