+
+import io.element.android.libraries.matrix.api.freechat.NotificationPrivacyStore
+import kotlinx.coroutines.flow.MutableStateFlow
+
+class FakeNotificationPrivacyStore(showContent: Boolean = true) : NotificationPrivacyStore {
