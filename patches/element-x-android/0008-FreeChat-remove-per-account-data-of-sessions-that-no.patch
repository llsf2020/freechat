+package io.element.android.libraries.pushstore.impl.freechat
+
+import com.google.common.truth.Truth.assertThat
+import io.element.android.libraries.androidutils.hash.hash
+import org.junit.Test
+
+class StaleSessionDataCleanerTest {
+    private val live = "@alice:chat.example".hash().take(16)
+    private val gone = "@bob:chat.example".hash().take(16)
+
+    @Test
+    fun `files of accounts that no longer exist are stale`() {
+        assertThat(isStalePerSessionFile("session_${gone}_preferences.preferences_pb", setOf(live))).isTrue()
+        assertThat(isStalePerSessionFile("push_store_$gone.preferences_pb", setOf(live))).isTrue()
+    }
+
+    @Test
+    fun `files of live accounts and shared files are kept`() {
+        assertThat(isStalePerSessionFile("session_${live}_preferences.preferences_pb", setOf(live))).isFalse()
+        assertThat(isStalePerSessionFile("push_store_$live.preferences_pb", setOf(live))).isFalse()
+        assertThat(isStalePerSessionFile("elementx_preferences.preferences_pb", setOf(live))).isFalse()
+        assertThat(isStalePerSessionFile("push_client_secret_store.preferences_pb", emptySet())).isFalse()
+        assertThat(isStalePerSessionFile("freechat_strict_mode.preferences_pb", emptySet())).isFalse()
+    }
+}
