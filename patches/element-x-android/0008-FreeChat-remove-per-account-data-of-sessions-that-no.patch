+/*
+ * Copyright 2026 FreeChat contributors
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+package io.element.android.libraries.pushstore.impl.freechat
+
+import android.content.Context
+import androidx.datastore.preferences.core.edit
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.ContributesTo
+import dev.zacsweers.metro.Inject
+import io.element.android.libraries.androidutils.hash.hash
+import io.element.android.libraries.core.coroutine.CoroutineDispatchers
+import io.element.android.libraries.di.annotations.AppCoroutineScope
+import io.element.android.libraries.di.annotations.ApplicationContext
+import io.element.android.libraries.preferences.api.store.PreferenceDataStoreFactory
+import io.element.android.libraries.sessionstorage.api.SessionStore
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import timber.log.Timber
+import java.io.File
+
+/**
+ * FreeChat: removes per-account data left behind by sessions that no longer exist.
+ *
+ * A strict-mode session lives in memory only, but some per-account settings still go to small files: session
+ * preferences, push settings and the push client secret (keyed by the user ID). A normal sign-out deletes them;
+ * when the process is killed instead, they would reveal which account was signed in. Run once at start-up, before
+ * any session is restored: in-memory strict sessions are part of [SessionStore], so live accounts are never touched.
+ */
+@Inject
+class StaleSessionDataCleaner(
+    @ApplicationContext private val context: Context,
+    private val sessionStore: SessionStore,
+    private val preferenceDataStoreFactory: PreferenceDataStoreFactory,
+    @AppCoroutineScope private val coroutineScope: CoroutineScope,
+    private val dispatchers: CoroutineDispatchers,
+) {
+    fun clean() {
+        coroutineScope.launch(dispatchers.io) {
+            runCatching {
+                val userIds = sessionStore.getAllSessions().map { it.userId }.toSet()
+                deleteStalePreferenceFiles(userIds.map { it.hash().take(16) }.toSet())
+                preferenceDataStoreFactory.create(PUSH_CLIENT_SECRET_STORE).edit { secrets ->
+                    secrets.asMap().keys.filter { it.name !in userIds }.forEach { secrets.remove(it) }
+                }
+            }.onFailure {
+                Timber.e(it, "FreeChat: failed cleaning up data of old sessions")
+            }
+        }
+    }
+
+    private fun deleteStalePreferenceFiles(liveHashes: Set<String>) {
+        File(context.filesDir, "datastore").listFiles()
+            ?.filter { isStalePerSessionFile(it.name, liveHashes) }
+            ?.forEach { it.delete() }
+    }
+
+    private companion object {
+        // Name used by DataStorePushClientSecretStore.
+        const val PUSH_CLIENT_SECRET_STORE = "push_client_secret_store"
+    }
+}
+
+// Names used by DefaultSessionPreferencesStore and UserPushStoreDataStore: a 16-character hash of the user ID.
+private val PER_SESSION_FILE = Regex("""session_([0-9a-f]{16})_preferences\.preferences_pb|push_store_([0-9a-f]{16})\.preferences_pb""")
+
+/** Whether [fileName] holds per-account data of an account whose user ID hash is not in [liveHashes]. */
+internal fun isStalePerSessionFile(fileName: String, liveHashes: Set<String>): Boolean {
+    val hash = PER_SESSION_FILE.matchEntire(fileName)?.groupValues?.drop(1)?.firstOrNull { it.isNotEmpty() } ?: return false
+    return hash !in liveHashes
+}
+
+@ContributesTo(AppScope::class)
+interface StaleSessionDataCleanerBindings {
+    fun staleSessionDataCleaner(): StaleSessionDataCleaner
+}
