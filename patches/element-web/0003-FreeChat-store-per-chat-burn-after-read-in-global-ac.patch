+/** Shape of the global `com.freechat.disappearing` account data. */
+export interface PersonalSettings {
+    /** Default burn-after-read delay in seconds; zero or missing means off. */
+    read_ttl?: number;
+    /** Per-room overrides by room ID; zero turns it off in that room. */
+    rooms?: Record<string, number>;
+}
+
+function validTtl(ttl: unknown): number | undefined {
     return typeof ttl === "number" && Number.isFinite(ttl) && ttl >= 0 ? Math.floor(ttl) : undefined;
 }
 
+export function getPersonalSettings(client: MatrixClient): PersonalSettings {
+    return (client.getAccountData(DISAPPEARING_EVENT_TYPE as any)?.getContent() as PersonalSettings) ?? {};
+}
+
 /** The user's global burn-after-read delay, zero when off. */
 export function getGlobalReadTtl(client: MatrixClient): number {
-    return readTtlFromContent(client.getAccountData(DISAPPEARING_EVENT_TYPE as any)?.getContent()) ?? 0;
+    return validTtl(getPersonalSettings(client).read_ttl) ?? 0;
+}
+
+/** The override for a room, or undefined when the room follows the default. */
+export function roomReadTtl(settings: PersonalSettings, roomId: string): number | undefined {
+    return validTtl(settings.rooms?.[roomId]);
 }
 
-/** The user's per-room override, or undefined when the room follows the global setting. */
-export function getRoomReadTtl(room: Room): number | undefined {
-    return readTtlFromContent(room.getAccountData(DISAPPEARING_EVENT_TYPE)?.getContent());
+/** New settings content with the room's override set, or removed when `ttl` is undefined. */
+export function withRoomReadTtl(settings: PersonalSettings, roomId: string, ttl: number | undefined): PersonalSettings {
+    const rooms = { ...settings.rooms };
+    if (ttl === undefined) delete rooms[roomId];
+    else rooms[roomId] = ttl;
+    return { ...settings, rooms };
 }
 
