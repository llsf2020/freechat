From 7eed65d8564ec5030fb6b2efcdebecaf04b687e9 Mon Sep 17 00:00:00 2001
From: sjcsf <346224915+llsf2020@users.noreply.github.com>
Date: Wed, 18 Nov 2026 00:00:00 +0000
Subject: [PATCH 14/14] FreeChat: build against Element Web 1.12.35

copyPlaintext moved to shared-utils as copyPlainTextToClipboard; the indexedDB handle in createMatrixClient is unused now that neither the sync store nor the legacy crypto store needs it.
---
 apps/web/src/freechat/PrivateRoomSettings.tsx | 4 ++--
 apps/web/src/utils/createMatrixClient.ts      | 7 -------
 2 files changed, 2 insertions(+), 9 deletions(-)

diff --git a/apps/web/src/freechat/PrivateRoomSettings.tsx b/apps/web/src/freechat/PrivateRoomSettings.tsx
index 0fd84d1f82..9080ca7c90 100644
--- a/apps/web/src/freechat/PrivateRoomSettings.tsx
+++ b/apps/web/src/freechat/PrivateRoomSettings.tsx
@@ -22,7 +22,7 @@ import ErrorDialog from "../components/views/dialogs/ErrorDialog";
 import AccessibleButton from "../components/views/elements/AccessibleButton";
 import Field from "../components/views/elements/Field";
 import SettingsFieldset from "../components/views/settings/SettingsFieldset";
-import { copyPlaintext } from "../utils/strings";
+import { copyPlainTextToClipboard } from "@element-hq/element-web-shared-utils";
 import { MIN_JOIN_PASSWORD_LENGTH, hasJoinPassword, setJoinPassword } from "./api";
 import { PRIVACY_EVENT_TYPE, isRoomAdmin } from "./disappearing";
 import { ft } from "./i18n";
@@ -79,7 +79,7 @@ export default function PrivateRoomSettings({ room }: { room: Room }): JSX.Eleme
     };
 
     const copyLink = async (): Promise<void> => {
-        setCopied(await copyPlaintext(roomLink(room.roomId)));
+        setCopied(await copyPlainTextToClipboard(roomLink(room.roomId)));
     };
 
     return (
diff --git a/apps/web/src/utils/createMatrixClient.ts b/apps/web/src/utils/createMatrixClient.ts
index 074daed7ad..5d79384567 100644
--- a/apps/web/src/utils/createMatrixClient.ts
+++ b/apps/web/src/utils/createMatrixClient.ts
@@ -29,13 +29,6 @@ import { persistTokens } from "./tokens/tokens.ts";
 
 const localStorage = window.localStorage;
 
-// just *accessing* indexedDB throws an exception in firefox with
-// indexeddb disabled.
-let indexedDB: IDBFactory;
-try {
-    indexedDB = window.indexedDB;
-} catch {}
-
 /**
  * Credentials used to create a MatrixClient with `createClientWithCreds`.
  */
