index 19a8037d5d..66814452df 100644
--- a/apps/web/src/Lifecycle.ts
+++ b/apps/web/src/Lifecycle.ts
@@ -75,7 +75,9 @@ import {
     beginSession,
     endSession,
     getStrictMode,
+    holdCredentials,
     keepStrictModeChoice,
+    takeHeldCredentials,
     watchStrictSession,
 } from "./freechat/strictMode";
 
@@ -489,6 +491,12 @@ async function loadOrCreatePickleKey(credentials: IMatrixClientCreds): Promise<s
  */
 async function onSuccessfulDelegatedAuthLogin(credentials: IMatrixClientCreds): Promise<void> {
     await clearStorage();
+    // FreeChat strict mode: the session lives in memory only, so neither the credentials nor a
+    // pickle key are stored; restoreSessionFromStorage starts the session from the held credentials.
+    if (getStrictMode().enabled) {
+        holdCredentials(credentials);
+        return;
+    }
     // SSO does not go through setLoggedIn so we need to load/create the pickle key here too
     credentials.pickleKey = await loadOrCreatePickleKey(credentials);
     await persistCredentials(credentials);
@@ -716,6 +724,18 @@ async function processStoredToken(
 export async function restoreSessionFromStorage(opts?: { ignoreGuest?: boolean }): Promise<boolean> {
     const ignoreGuest = opts?.ignoreGuest;
 
+    // FreeChat strict mode: an SSO, OAuth or QR login held its credentials in memory instead of storing them.
+    const held = takeHeldCredentials();
+    if (held) {
+        if (ignoreGuest && held.guest) {
+            logger.log("Ignoring held guest account: " + held.userId);
+            return false;
+        }
+        logger.log(`Starting strict session for ${held.userId}`);
+        await doSetLoggedIn({ ...held, freshLogin: true }, false, true);
+        return true;
+    }
+
     if (!localStorage) {
         return false;
     }
