 } from "./strictMode";
 
@@ -136,4 +138,34 @@ describe("strict mode", () => {
         vi.advanceTimersByTime(60 * 60_000);
         expect(logout).not.toHaveBeenCalled();
     });
+
+    it("hands held login credentials over once", () => {
+        const creds = {
+            userId: "@a:chat.example",
+            deviceId: "FCS5_X",
+            accessToken: "t",
+            homeserverUrl: "https://chat.example",
+        };
+        holdCredentials(creds);
+        creds.accessToken = "changed afterwards";
+        expect(takeHeldCredentials()).toEqual({ ...creds, accessToken: "t" });
+        expect(takeHeldCredentials()).toBeUndefined();
+    });
+
+    it("forgets held credentials on sign-out", () => {
+        holdCredentials({ userId: "@a:chat.example", accessToken: "t", homeserverUrl: "https://chat.example" });
+        endSession();
+        expect(takeHeldCredentials()).toBeUndefined();
+    });
+
+    it("keeps held credentials out of localStorage and sessionStorage", () => {
+        holdCredentials({
+            userId: "@a:chat.example",
+            accessToken: "secret-token",
+            homeserverUrl: "https://chat.example",
+        });
+        const stored = JSON.stringify({ ...localStorage }) + JSON.stringify({ ...sessionStorage });
+        expect(stored).not.toContain("secret-token");
+        takeHeldCredentials();
+    });
 });
diff --git a/apps/web/src/freechat/strictMode.ts b/apps/web/src/freechat/strictMode.ts
index 08b3a10529..c949f3798f 100644
--- a/apps/web/src/freechat/strictMode.ts
+++ b/apps/web/src/freechat/strictMode.ts
@@ -23,6 +23,8 @@ Please see LICENSE files in the repository root for full details.
 import { type MatrixClient } from "matrix-js-sdk/src/matrix";
 import { logger } from "matrix-js-sdk/src/logger";
 
+import { type IMatrixClientCreds } from "../utils/createMatrixClient";
+
 const STORAGE_KEY = "freechat_strict_mode";
 
 export const IDLE_PRESETS_MINUTES = [1, 5, 15, 30, 60];
@@ -86,6 +88,7 @@ export function endSession(): void {
     stopWatching?.();
     stopWatching = undefined;
     strictSession = false;
+    heldCredentials = undefined;
 }
 
 /** Keeps the strict mode choice across a wipe of localStorage. Returns the function that puts it back. */
@@ -103,6 +106,24 @@ export function isStrictSession(): boolean {
     return strictSession;
 }
 
+let heldCredentials: IMatrixClientCreds | undefined;
+
+/**
+ * Holds the credentials of an SSO, OAuth or QR login in memory. Those logins normally store the
+ * credentials and then start the session from storage; in strict mode nothing is stored, and the
+ * session starts from these instead (see `takeHeldCredentials`).
+ */
+export function holdCredentials(credentials: IMatrixClientCreds): void {
+    heldCredentials = { ...credentials };
+}
+
+/** Returns the held credentials once, then forgets them. */
+export function takeHeldCredentials(): IMatrixClientCreds | undefined {
+    const credentials = heldCredentials;
+    heldCredentials = undefined;
+    return credentials;
+}
+
 /** Device preferences (language, theme) that say nothing about the user and survive a wipe. */
 const KEPT_KEYS = [STORAGE_KEY, "mx_local_settings"];
 
