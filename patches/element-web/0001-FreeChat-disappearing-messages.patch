+    hours: "%(count)s hours",
+    days: "%(count)s days",
+    changed: "%(sender)s set messages to auto-delete after %(duration)s.",
+    disabled: "%(sender)s turned off auto-delete.",
+    error_title: "Could not change auto-delete",
+    composer_hint: "Messages auto-delete after %(duration)s",
+};
+
+type Key = keyof typeof en;
+
+const zhHans: Record<Key, string> = {
+    settings_legend: "自动删除消息",
+    settings_description: "新消息会在设定时间后，从所有人的所有设备和服务器上删除。开启前发出的消息不受影响。",
+    off: "关闭",
+    hour: "1 小时",
+    day: "1 天",
+    week: "1 周",
+    month: "1 个月",
+    custom: "%(duration)s",
+    seconds: "%(count)s 秒",
+    minutes: "%(count)s 分钟",
+    hours: "%(count)s 小时",
+    days: "%(count)s 天",
+    changed: "%(sender)s 将消息设置为 %(duration)s 后自动删除。",
+    disabled: "%(sender)s 关闭了自动删除。",
+    error_title: "无法修改自动删除设置",
+    composer_hint: "消息将在 %(duration)s 后自动删除",
+};
+
+const zhHant: Record<Key, string> = {
+    settings_legend: "自動刪除訊息",
+    settings_description: "新訊息會在設定時間後，從所有人的所有裝置和伺服器上刪除。開啟前發出的訊息不受影響。",
+    off: "關閉",
+    hour: "1 小時",
+    day: "1 天",
+    week: "1 週",
+    month: "1 個月",
+    custom: "%(duration)s",
+    seconds: "%(count)s 秒",
+    minutes: "%(count)s 分鐘",
+    hours: "%(count)s 小時",
+    days: "%(count)s 天",
+    changed: "%(sender)s 將訊息設定為 %(duration)s 後自動刪除。",
+    disabled: "%(sender)s 關閉了自動刪除。",
+    error_title: "無法修改自動刪除設定",
+    composer_hint: "訊息將在 %(duration)s 後自動刪除",
+};
+
+function table(): Record<Key, string> {
+    const lang = (getCurrentLanguage() ?? "en").toLowerCase();
+    if (lang === "zh-hant" || lang === "zh-tw" || lang === "zh-hk") return zhHant;
+    if (lang.startsWith("zh")) return zhHans;
+    return en;
+}
+
+export function ft(key: Key, vars: Record<string, string | number> = {}): string {
+    return table()[key].replace(/%\((\w+)\)s/g, (match, name: string) => (name in vars ? String(vars[name]) : match));
+}
