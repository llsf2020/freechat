+ *
+ * Kept out of the upstream en_EN.json/zh_Hans.json so syncing upstream
+ * translations never conflicts with ours.
+ */
+
+import { getCurrentLanguage } from "../languageHandler";
+
+const en = {
+    settings_legend: "Auto-delete messages",
+    settings_description:
+        "New messages are deleted for everyone, on every device and on the server, after the chosen time. Messages sent earlier are not affected.",
+    off: "Off",
