+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: room setting to pick the disappearing-messages TTL.
+ */
+
+import React, { type JSX, useContext, useState } from "react";
+import { type Room } from "matrix-js-sdk/src/matrix";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import MatrixClientContext from "../contexts/MatrixClientContext";
+import { useRoomState } from "../hooks/useRoomState";
+import Modal from "../Modal";
+import ErrorDialog from "../components/views/dialogs/ErrorDialog";
+import StyledRadioGroup from "../components/views/elements/StyledRadioGroup";
+import SettingsFieldset from "../components/views/settings/SettingsFieldset";
+import { DISAPPEARING_EVENT_TYPE, TTL_PRESETS, formatTtl, getStateTtl } from "./disappearing";
+import { ft } from "./i18n";
+
+interface Props {
+    room: Room;
+}
+
+export default function DisappearingMessagesSettings({ room }: Props): JSX.Element {
+    const client = useContext(MatrixClientContext);
+    const { ttl, canChange } = useRoomState(room, (state) => ({
+        ttl: getStateTtl(state),
+        canChange: state.maySendStateEvent(DISAPPEARING_EVENT_TYPE, client.getSafeUserId()),
+    }));
+    const [pending, setPending] = useState<number | null>(null);
+
+    const definitions = TTL_PRESETS.map((p) => ({ value: String(p.ttl), label: p.label() }));
+    // A TTL set by another client that is not a preset still shows as selected.
+    if (!TTL_PRESETS.some((p) => p.ttl === ttl)) {
+        definitions.push({ value: String(ttl), label: formatTtl(ttl) });
+    }
+
+    const onChange = async (value: string): Promise<void> => {
+        const next = Number(value);
+        setPending(next);
+        try {
+            // Ruma/Matrix custom state type; js-sdk types it as a known key only.
+            await client.sendStateEvent(room.roomId, DISAPPEARING_EVENT_TYPE as any, { ttl: next }, "");
+        } catch (e) {
+            logger.error("FreeChat: failed to set disappearing TTL", e);
+            Modal.createDialog(ErrorDialog, {
+                title: ft("error_title"),
+                description: e instanceof Error ? e.message : String(e),
+            });
+        } finally {
+            setPending(null);
+        }
+    };
+
+    return (
+        <SettingsFieldset legend={ft("settings_legend")} description={ft("settings_description")}>
+            <StyledRadioGroup
+                name="freechatDisappearing"
+                value={String(pending ?? ttl)}
+                onChange={onChange}
+                disabled={!canChange || pending !== null}
+                definitions={definitions}
+            />
+        </SettingsFieldset>
+    );
+}
