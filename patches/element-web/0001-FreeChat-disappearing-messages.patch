+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: disappearing messages helpers.
+ */
+
+import { MatrixEvent } from "matrix-js-sdk/src/matrix";
+import { describe, it, expect } from "vitest";
+
+import { EXPIRED_KEY, formatTtl, isExpiredRedaction, textForDisappearingEvent } from "./disappearing";
+
+function redacted(redactionContent: Record<string, unknown>): MatrixEvent {
+    return new MatrixEvent({
+        type: "m.room.message",
+        event_id: "$msg",
+        sender: "@a:example.org",
+        content: {},
+        unsigned: {
+            redacted_because: {
+                type: "m.room.redaction",
+                event_id: "$redaction",
+                sender: "@a:example.org",
+                origin_server_ts: 0,
+                content: { redacts: "$msg", ...redactionContent },
+            } as any,
+        },
+    });
+}
+
+describe("isExpiredRedaction", () => {
+    it("is true for a server expiry redaction", () => {
+        expect(isExpiredRedaction(redacted({ [EXPIRED_KEY]: true }))).toBe(true);
+    });
+
+    it("is false for a manual redaction", () => {
+        expect(isExpiredRedaction(redacted({}))).toBe(false);
+    });
+
+    it("is false for a live message", () => {
+        const ev = new MatrixEvent({ type: "m.room.message", content: { body: "hi", msgtype: "m.text" } });
+        expect(isExpiredRedaction(ev)).toBe(false);
+    });
+});
+
+describe("formatTtl", () => {
+    it("uses preset labels", () => {
+        expect(formatTtl(3600)).toBe("1 hour");
+        expect(formatTtl(86400)).toBe("1 day");
+    });
+
+    it("falls back to the largest whole unit", () => {
+        expect(formatTtl(2 * 86400)).toBe("2 days");
+        expect(formatTtl(2 * 3600)).toBe("2 hours");
+        expect(formatTtl(300)).toBe("5 minutes");
+        expect(formatTtl(45)).toBe("45 seconds");
+    });
+});
+
+describe("textForDisappearingEvent", () => {
+    const stateEvent = (content: Record<string, unknown>): MatrixEvent =>
+        new MatrixEvent({
+            type: "com.freechat.disappearing",
+            state_key: "",
+            sender: "@alice:example.org",
+            content,
+        });
+
+    it("describes enabling", () => {
+        expect(textForDisappearingEvent(stateEvent({ ttl: 604800 }))!()).toBe(
+            "@alice:example.org set messages to auto-delete after 1 week.",
+        );
+    });
+
+    it("describes disabling, including invalid content", () => {
+        expect(textForDisappearingEvent(stateEvent({ ttl: 0 }))!()).toBe("@alice:example.org turned off auto-delete.");
+        expect(textForDisappearingEvent(stateEvent({ ttl: "x" }))!()).toBe(
+            "@alice:example.org turned off auto-delete.",
+        );
+    });
+});
diff --git a/apps/web/src/freechat/disappearing.ts b/apps/web/src/freechat/disappearing.ts
new file mode 100644
index 0000000000..f2d924bedc
--- /dev/null
+++ b/apps/web/src/freechat/disappearing.ts
@@ -0,0 +1,72 @@
+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: disappearing messages.
+ *
+ * The homeserver enforces expiry by redacting messages; the client only lets
+ * users pick a TTL, explains it, and hides expired messages without a
+ * "message deleted" placeholder.
+ */
+
+import { type MatrixEvent, type Room, type RoomState } from "matrix-js-sdk/src/matrix";
+
+import { ft } from "./i18n";
+
+export const DISAPPEARING_EVENT_TYPE = "com.freechat.disappearing";
+export const EXPIRED_KEY = "com.freechat.expired";
+export const MEDIA_KEY = "com.freechat.media";
+
+const HOUR = 3600;
+const DAY = 24 * HOUR;
+
+/** TTL presets offered in the UI, in seconds. Zero means off. */
+export const TTL_PRESETS: ReadonlyArray<{ ttl: number; label: () => string }> = [
+    { ttl: 0, label: () => ft("off") },
+    { ttl: HOUR, label: () => ft("hour") },
+    { ttl: DAY, label: () => ft("day") },
+    { ttl: 7 * DAY, label: () => ft("week") },
+    { ttl: 30 * DAY, label: () => ft("month") },
+];
+
+function ttlFromContent(content: Record<string, unknown> | undefined): number {
+    const ttl = content?.ttl;
+    return typeof ttl === "number" && Number.isFinite(ttl) && ttl > 0 ? Math.floor(ttl) : 0;
+}
+
+/** The room's current TTL in seconds, zero when disabled. */
+export function getStateTtl(state: RoomState): number {
+    return ttlFromContent(state.getStateEvents(DISAPPEARING_EVENT_TYPE, "")?.getContent());
+}
+
+export function getRoomTtl(room: Room): number {
+    return getStateTtl(room.currentState);
+}
+
+/** Human-readable duration, preferring the preset labels. */
+export function formatTtl(ttl: number): string {
+    const preset = TTL_PRESETS.find((p) => p.ttl === ttl);
+    if (preset) return preset.label();
+    if (ttl % DAY === 0) return ft("days", { count: ttl / DAY });
+    if (ttl % HOUR === 0) return ft("hours", { count: ttl / HOUR });
+    if (ttl % 60 === 0) return ft("minutes", { count: ttl / 60 });
+    return ft("seconds", { count: ttl });
+}
+
+/** True for a message the server deleted because it expired. */
+export function isExpiredRedaction(ev: MatrixEvent): boolean {
+    if (!ev.isRedacted()) return false;
+    const because = ev.getUnsigned().redacted_because as { content?: Record<string, unknown> } | undefined;
+    return because?.content?.[EXPIRED_KEY] === true;
+}
+
+/** Timeline text for a TTL change. */
+export function textForDisappearingEvent(ev: MatrixEvent): (() => string) | null {
+    const sender = ev.sender?.name || ev.getSender() || "";
+    const ttl = ttlFromContent(ev.getContent());
+    return () => (ttl ? ft("changed", { sender, duration: formatTtl(ttl) }) : ft("disabled", { sender }));
+}
