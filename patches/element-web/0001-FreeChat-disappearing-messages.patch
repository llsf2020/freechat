+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: plaintext media hint on encrypted events.
+ *
+ * The homeserver cannot read the MXC URIs inside an encrypted attachment, so
+ * it could never delete the file when the message disappears. Before an
+ * encrypted event goes over the wire we list its MXCs under
+ * `com.freechat.media` in the plaintext envelope. Only the opaque media IDs
+ * are exposed; the files themselves stay encrypted.
+ *
+ * matrix-js-sdk has no public hook for this, so we wrap its private
+ * `sendEventHttpRequest`, the single point every send (direct or scheduled)
+ * goes through after encryption. If an upstream js-sdk update renames it, the
+ * wrapper logs a warning and sending keeps working without the hint.
+ */
+
+import { type MatrixClient, type MatrixEvent } from "matrix-js-sdk/src/matrix";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { MEDIA_KEY } from "./disappearing";
+
+type SendFn = (event: MatrixEvent, ...rest: unknown[]) => Promise<unknown>;
+
+/** MXC URIs an attachment-bearing content references. */
+export function contentMxcs(content: Record<string, any>): string[] {
+    const candidates = [content.url, content.file?.url, content.info?.thumbnail_url, content.info?.thumbnail_file?.url];
+    const mxcs = candidates.filter((u): u is string => typeof u === "string" && u.startsWith("mxc://"));
+    return [...new Set(mxcs)];
+}
+
+/** Adds the hint to an encrypted event's wire content, if it has media. */
+export function addMediaHint(event: MatrixEvent): void {
+    if (!event.isEncrypted()) return;
+    const mxcs = contentMxcs(event.getContent());
+    if (mxcs.length) event.getWireContent()[MEDIA_KEY] = mxcs;
+}
+
+const INSTALLED = Symbol("freechatMediaHint");
+
+export function installMediaHint(client: MatrixClient): void {
+    const target = client as unknown as { sendEventHttpRequest?: SendFn; [INSTALLED]?: boolean };
+    if (target[INSTALLED]) return;
+    target[INSTALLED] = true;
+
+    const original = target.sendEventHttpRequest;
+    if (typeof original !== "function") {
+        logger.warn("FreeChat: js-sdk sendEventHttpRequest not found; encrypted media will not be auto-deleted");
+        return;
+    }
+
+    target.sendEventHttpRequest = function (this: unknown, event: MatrixEvent, ...rest: unknown[]) {
+        try {
+            addMediaHint(event);
+        } catch (e) {
+            logger.warn("FreeChat: failed to add media hint", e);
+        }
+        return original.call(this, event, ...rest);
+    };
+}
