+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: plaintext media hint on encrypted events.
+ */
+
+import { MatrixEvent } from "matrix-js-sdk/src/matrix";
+import { describe, it, expect, vi } from "vitest";
+
+import { MEDIA_KEY } from "./disappearing";
+import { addMediaHint, contentMxcs, installMediaHint } from "./mediaHint";
+
+function encryptedEvent(clearContent: Record<string, unknown>): MatrixEvent {
+    const ev = new MatrixEvent({
+        type: "m.room.encrypted",
+        room_id: "!r:example.org",
+        content: { algorithm: "m.megolm.v1.aes-sha2", ciphertext: "AAAA" },
+    });
+    // Simulate a decrypted / just-encrypted local echo.
+    vi.spyOn(ev, "getContent").mockReturnValue(clearContent);
+    return ev;
+}
+
+describe("contentMxcs", () => {
+    it("collects attachment and thumbnail URIs, deduplicated", () => {
+        expect(
+            contentMxcs({
+                file: { url: "mxc://s/a" },
+                info: { thumbnail_file: { url: "mxc://s/t" }, thumbnail_url: "mxc://s/a" },
+            }),
+        ).toEqual(["mxc://s/a", "mxc://s/t"]);
+    });
+
+    it("ignores non-mxc values", () => {
+        expect(contentMxcs({ url: "https://x", body: "hi" })).toEqual([]);
+    });
+});
+
+describe("addMediaHint", () => {
+    it("adds the hint to encrypted media", () => {
+        const ev = encryptedEvent({ msgtype: "m.image", file: { url: "mxc://s/img" } });
+        addMediaHint(ev);
+        expect(ev.getWireContent()[MEDIA_KEY]).toEqual(["mxc://s/img"]);
+    });
+
+    it("leaves encrypted text alone", () => {
+        const ev = encryptedEvent({ msgtype: "m.text", body: "hi" });
+        addMediaHint(ev);
+        expect(ev.getWireContent()[MEDIA_KEY]).toBeUndefined();
+    });
+
+    it("leaves unencrypted events alone", () => {
+        const ev = new MatrixEvent({ type: "m.room.message", content: { url: "mxc://s/a" } });
+        addMediaHint(ev);
+        expect(ev.getWireContent()[MEDIA_KEY]).toBeUndefined();
+    });
+});
+
+describe("installMediaHint", () => {
+    it("wraps the send function once and passes arguments through", async () => {
+        const send = vi.fn().mockResolvedValue({ event_id: "$e" });
+        const client = { sendEventHttpRequest: send } as any;
+
+        installMediaHint(client);
+        installMediaHint(client);
+
+        const ev = encryptedEvent({ file: { url: "mxc://s/f" } });
+        await expect(client.sendEventHttpRequest(ev, { q: 1 })).resolves.toEqual({ event_id: "$e" });
+        expect(send).toHaveBeenCalledTimes(1);
+        expect(send).toHaveBeenCalledWith(ev, { q: 1 });
+        expect(ev.getWireContent()[MEDIA_KEY]).toEqual(["mxc://s/f"]);
+    });
+});
