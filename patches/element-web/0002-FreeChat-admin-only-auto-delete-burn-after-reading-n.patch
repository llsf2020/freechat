+        expect(isRoomAdmin(stateWith(50), "@a:x")).toBe(false);
+        expect(isRoomAdmin(stateWith(undefined), "@a:x")).toBe(false);
+    });
+});
+
+describe("read ttl helpers", () => {
+    const withContent = (content: Record<string, unknown> | undefined) =>
+        content === undefined ? undefined : new MatrixEvent({ type: "com.freechat.disappearing", content });
+
+    it("reads the global default, treating missing or invalid as off", () => {
+        expect(getGlobalReadTtl({ getAccountData: () => withContent({ read_ttl: 30 }) } as any)).toBe(30);
+        expect(getGlobalReadTtl({ getAccountData: () => withContent({ read_ttl: "30" }) } as any)).toBe(0);
+        expect(getGlobalReadTtl({ getAccountData: () => undefined } as any)).toBe(0);
+    });
+
+    it("distinguishes a room override from following the default", () => {
+        expect(getRoomReadTtl({ getAccountData: () => withContent({ read_ttl: 0 }) } as any)).toBe(0);
+        expect(getRoomReadTtl({ getAccountData: () => withContent({}) } as any)).toBeUndefined();
+        expect(getRoomReadTtl({ getAccountData: () => undefined } as any)).toBeUndefined();
+    });
+
+    it("formats delays", () => {
+        expect(formatReadTtl(0)).toBe("Off");
+        expect(formatReadTtl(5)).toBe("5 seconds");
+        expect(formatReadTtl(300)).toBe("5 minutes");
+        expect(formatReadTtl(3600)).toBe("1 hour");
+    });
+});
