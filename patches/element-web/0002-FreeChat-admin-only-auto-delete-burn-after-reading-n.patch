+
+/*
+ * FreeChat: personal burn-after-read settings.
+ *
+ * Stored as `com.freechat.disappearing` account data `{"read_ttl": seconds}`:
+ * globally as the default, and per room to override it. A room override
+ * without `read_ttl` follows the global default. The homeserver enforces it.
+ */
+
+import React, { type JSX, useCallback, useContext, useState } from "react";
+import { ClientEvent, type MatrixEvent, type Room, RoomEvent } from "matrix-js-sdk/src/matrix";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import MatrixClientContext from "../contexts/MatrixClientContext";
+import { useTypedEventEmitter } from "../hooks/useEventEmitter";
+import Modal from "../Modal";
+import ErrorDialog from "../components/views/dialogs/ErrorDialog";
+import StyledRadioGroup from "../components/views/elements/StyledRadioGroup";
+import SettingsFieldset from "../components/views/settings/SettingsFieldset";
+import {
+    DISAPPEARING_EVENT_TYPE,
+    READ_TTL_PRESETS,
+    formatReadTtl,
+    getGlobalReadTtl,
+    getRoomReadTtl,
+} from "./disappearing";
+import { ft } from "./i18n";
+
+const FOLLOW_GLOBAL = "global";
+
+function presetDefinitions(current: number): Array<{ value: string; label: string }> {
+    const ttls = READ_TTL_PRESETS.includes(current) ? READ_TTL_PRESETS : [...READ_TTL_PRESETS, current];
+    return ttls.map((ttl) => ({ value: String(ttl), label: formatReadTtl(ttl) }));
+}
+
+function showError(e: unknown): void {
+    logger.error("FreeChat: failed to save burn-after-read", e);
+    Modal.createDialog(ErrorDialog, {
+        title: ft("burn_error_title"),
+        description: e instanceof Error ? e.message : String(e),
+    });
+}
+
+/** The global default, re-read whenever account data changes. */
+function useGlobalReadTtl(): number {
+    const client = useContext(MatrixClientContext);
+    const [ttl, setTtl] = useState(() => getGlobalReadTtl(client));
+    const onAccountData = useCallback(
+        (event: MatrixEvent) => {
+            if (event.getType() === DISAPPEARING_EVENT_TYPE) setTtl(getGlobalReadTtl(client));
+        },
+        [client],
+    );
+    useTypedEventEmitter(client, ClientEvent.AccountData, onAccountData);
+    return ttl;
+}
+
+/** User settings: the default for every chat. */
+export function GlobalReadBurnSettings(): JSX.Element {
+    const client = useContext(MatrixClientContext);
+    const ttl = useGlobalReadTtl();
+    const [pending, setPending] = useState<number | null>(null);
+
+    const onChange = async (value: string): Promise<void> => {
+        const next = Number(value);
+        setPending(next);
+        try {
+            await client.setAccountData(DISAPPEARING_EVENT_TYPE as any, { read_ttl: next } as any);
+        } catch (e) {
+            showError(e);
+        } finally {
+            setPending(null);
+        }
+    };
+
+    return (
+        <SettingsFieldset legend={ft("burn_legend")} description={ft("burn_description")}>
+            <StyledRadioGroup
+                name="freechatReadBurnGlobal"
+                value={String(pending ?? ttl)}
+                onChange={onChange}
+                disabled={pending !== null}
+                definitions={presetDefinitions(ttl)}
+            />
+        </SettingsFieldset>
+    );
+}
+
+/** Room settings: override the default for this chat, or follow it. */
+export function RoomReadBurnSettings({ room }: { room: Room }): JSX.Element {
+    const client = useContext(MatrixClientContext);
+    const globalTtl = useGlobalReadTtl();
+    const [override, setOverride] = useState(() => getRoomReadTtl(room));
+    const [pending, setPending] = useState<string | null>(null);
+
+    const onRoomAccountData = useCallback(
+        (event: MatrixEvent) => {
+            if (event.getType() === DISAPPEARING_EVENT_TYPE) setOverride(getRoomReadTtl(room));
+        },
+        [room],
+    );
+    useTypedEventEmitter(room, RoomEvent.AccountData, onRoomAccountData);
+
+    const current = override === undefined ? FOLLOW_GLOBAL : String(override);
+    const definitions = [
+        { value: FOLLOW_GLOBAL, label: ft("burn_follow_global", { duration: formatReadTtl(globalTtl) }) },
+        ...presetDefinitions(override ?? 0),
+    ];
+
+    const onChange = async (value: string): Promise<void> => {
+        setPending(value);
+        try {
+            // An empty object clears the override (account data cannot be deleted).
+            const content = value === FOLLOW_GLOBAL ? {} : { read_ttl: Number(value) };
+            await client.setRoomAccountData(room.roomId, DISAPPEARING_EVENT_TYPE as any, content as any);
+        } catch (e) {
+            showError(e);
+        } finally {
+            setPending(null);
+        }
+    };
+
+    return (
+        <SettingsFieldset legend={ft("burn_room_legend")} description={ft("burn_description")}>
+            <StyledRadioGroup
+                name="freechatReadBurnRoom"
+                value={pending ?? current}
+                onChange={onChange}
+                disabled={pending !== null}
+                definitions={definitions}
+            />
+        </SettingsFieldset>
+    );
+}
