+/** Power level needed to change the room TTL; v12 creators count as Infinity. */
+const ADMIN_LEVEL = 100;
+
+/** Only room admins may change the room TTL; the server enforces this too. */
+export function isRoomAdmin(state: RoomState, userId: string): boolean {
+    return (state.getMember(userId)?.powerLevel ?? 0) >= ADMIN_LEVEL;
+}
+
+/** Personal burn-after-read presets in seconds, zero meaning off. */
+export const READ_TTL_PRESETS: readonly number[] = [0, 5, 30, 60, 5 * 60, HOUR];
+
+function readTtlFromContent(content: Record<string, unknown> | undefined): number | undefined {
+    const ttl = content?.read_ttl;
+    return typeof ttl === "number" && Number.isFinite(ttl) && ttl >= 0 ? Math.floor(ttl) : undefined;
+}
+
+/** The user's global burn-after-read delay, zero when off. */
+export function getGlobalReadTtl(client: MatrixClient): number {
+    return readTtlFromContent(client.getAccountData(DISAPPEARING_EVENT_TYPE as any)?.getContent()) ?? 0;
+}
+
+/** The user's per-room override, or undefined when the room follows the global setting. */
+export function getRoomReadTtl(room: Room): number | undefined {
+    return readTtlFromContent(room.getAccountData(DISAPPEARING_EVENT_TYPE)?.getContent());
+}
+
+export function formatReadTtl(ttl: number): string {
+    if (ttl <= 0) return ft("off");
+    if (ttl === HOUR) return ft("hour");
+    if (ttl % HOUR === 0) return ft("hours", { count: ttl / HOUR });
+    if (ttl % 60 === 0) return ft("minutes", { count: ttl / 60 });
+    return ft("seconds", { count: ttl });
+}
+
 /** True for a message the server deleted because it expired. */
 export function isExpiredRedaction(ev: MatrixEvent): boolean {
     if (!ev.isRedacted()) return false;
