+/** Which of the given events still exist on the server; purged ones are omitted. Members only. */
+export async function existingEvents(client: MatrixClient, roomId: string, eventIds: string[]): Promise<Set<string>> {
+    const res = await client.http.authedRequest<{ existing: string[] }>(
+        Method.Post,
+        roomPath(roomId, "existing_events"),
+        undefined,
+        { event_ids: eventIds },
+        { prefix: PREFIX },
+    );
+    return new Set(res.existing);
+}
