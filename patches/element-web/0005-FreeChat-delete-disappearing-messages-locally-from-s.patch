+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+import { MatrixEvent } from "matrix-js-sdk/src/matrix";
+import { describe, it, expect } from "vitest";
+
+import { EXPIRES_AT_KEY, READ_TTL_KEY, expiryOf, isExpired, isMarked } from "./expiry";
+
+function anEvent(unsigned: Record<string, unknown>, sender = "@a:x"): MatrixEvent {
+    return new MatrixEvent({
+        type: "m.room.message",
+        event_id: "$e",
+        room_id: "!r:x",
+        sender,
+        content: { msgtype: "m.text", body: "hi" },
+        unsigned: unsigned as any,
+    });
+}
+
+/** A room where `read` lists members who read the event, with receipt timestamps. */
+function aRoom(members: string[], read: Record<string, number>) {
+    return {
+        getJoinedMembers: () => members.map((userId) => ({ userId })),
+        hasUserReadEvent: (userId: string) => userId in read || userId === "@a:x",
+        getReadReceiptForUserId: (userId: string) => (userId in read ? { data: { ts: read[userId] } } : null),
+    } as any;
+}
+
+describe("expiry markers", () => {
+    it("recognises marked events", () => {
+        expect(isMarked(anEvent({ [EXPIRES_AT_KEY]: 1000 }))).toBe(true);
+        expect(isMarked(anEvent({ [READ_TTL_KEY]: 5 }))).toBe(true);
+        expect(isMarked(anEvent({}))).toBe(false);
+        expect(isMarked(anEvent({ [EXPIRES_AT_KEY]: "1000" }))).toBe(false);
+    });
+
+    it("uses the room expiry as is, which works offline", () => {
+        const ev = anEvent({ [EXPIRES_AT_KEY]: 5000 });
+        expect(expiryOf(ev, null)).toBe(5000);
+        expect(isExpired(ev, null, 4999)).toBe(false);
+        expect(isExpired(ev, null, 5000)).toBe(true);
+    });
+
+    it("starts burn after reading only once every other member read it", () => {
+        const ev = anEvent({ [READ_TTL_KEY]: 5 });
+        expect(expiryOf(ev, aRoom(["@a:x", "@b:x", "@c:x"], { "@b:x": 1000 }))).toBeNull();
+        expect(expiryOf(ev, aRoom(["@a:x", "@b:x", "@c:x"], { "@b:x": 1000, "@c:x": 3000 }))).toBe(8000);
+    });
+
+    it("does not burn while nobody else is in the room", () => {
+        expect(expiryOf(anEvent({ [READ_TTL_KEY]: 5 }), aRoom(["@a:x"], {}))).toBeNull();
+    });
+
+    it("takes whichever comes first", () => {
+        const ev = anEvent({ [EXPIRES_AT_KEY]: 4000, [READ_TTL_KEY]: 5 });
+        expect(expiryOf(ev, aRoom(["@a:x", "@b:x"], { "@b:x": 1000 }))).toBe(4000);
+        expect(expiryOf(ev, aRoom(["@a:x", "@b:x"], { "@b:x": -3000 }))).toBe(2000);
+    });
+});
diff --git a/apps/web/src/freechat/expiry.ts b/apps/web/src/freechat/expiry.ts
new file mode 100644
index 0000000000..4e0794c712
--- /dev/null
+++ b/apps/web/src/freechat/expiry.ts
@@ -0,0 +1,157 @@
+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: delete disappearing messages locally.
+ *
+ * The server purges expired messages without leaving a redaction, so devices
+ * delete their own copies:
+ *  - `unsigned.com.freechat.expires_at` (room auto-delete) gives the exact time,
+ *    which works offline;
+ *  - `unsigned.com.freechat.read_ttl` (burn after reading) starts once every
+ *    other member has read the message, as far as this device can tell from
+ *    public receipts;
+ *  - while online, the device asks the server which marked messages still
+ *    exist and drops the rest (covers private read receipts and any drift).
+ */
+
+import { ClientEvent, type MatrixClient, type MatrixEvent, type Room, SyncState } from "matrix-js-sdk/src/matrix";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { existingEvents } from "./api";
+
+export const EXPIRES_AT_KEY = "com.freechat.expires_at";
+export const READ_TTL_KEY = "com.freechat.read_ttl";
+
+/** How often online devices check which marked messages the server purged. */
+const CHECK_INTERVAL_MS = 30_000;
+/** Most event IDs per server check, matching the server limit. */
+const CHECK_BATCH = 500;
+
+function positive(value: unknown): number | null {
+    return typeof value === "number" && Number.isFinite(value) && value > 0 ? value : null;
+}
+
+/** Whether the server marked this event as disappearing. */
+export function isMarked(ev: MatrixEvent): boolean {
+    const unsigned = ev.getUnsigned() as Record<string, unknown>;
+    return positive(unsigned[EXPIRES_AT_KEY]) !== null || positive(unsigned[READ_TTL_KEY]) !== null;
+}
+
+/** When this device should delete the event, in ms since the epoch, or null if not (yet) known. */
+export function expiryOf(ev: MatrixEvent, room: Room | null | undefined): number | null {
+    const unsigned = ev.getUnsigned() as Record<string, unknown>;
+    let at = positive(unsigned[EXPIRES_AT_KEY]);
+
+    const readTtl = positive(unsigned[READ_TTL_KEY]);
+    const eventId = ev.getId();
+    if (readTtl !== null && room && eventId) {
+        const others = room
+            .getJoinedMembers()
+            .map((m) => m.userId)
+            .filter((userId) => userId !== ev.getSender());
+        if (others.length > 0 && others.every((userId) => room.hasUserReadEvent(userId, eventId))) {
+            const readAt = Math.max(
+                ...others.map((userId) => room.getReadReceiptForUserId(userId, true)?.data.ts ?? Date.now()),
+            );
+            const burnAt = readAt + readTtl * 1000;
+            at = at === null ? burnAt : Math.min(at, burnAt);
+        }
+    }
+
+    return at;
+}
+
+export function isExpired(ev: MatrixEvent, room: Room | null | undefined, now = Date.now()): boolean {
+    const at = expiryOf(ev, room);
+    return at !== null && at <= now;
+}
+
+/** Keeps removing expired and purged messages from the rooms this client holds. */
+export class ExpiryManager {
+    private timer: ReturnType<typeof setTimeout> | null = null;
+    private checking = false;
+
+    public constructor(private readonly client: MatrixClient) {}
+
+    public start(): void {
+        this.client.on(ClientEvent.Sync, this.onSync);
+        this.schedule(0);
+    }
+
+    public stop(): void {
+        this.client.off(ClientEvent.Sync, this.onSync);
+        if (this.timer) clearTimeout(this.timer);
+        this.timer = null;
+    }
+
+    private readonly onSync = (state: SyncState, prev: SyncState | null): void => {
+        // Right after (re)connecting, catch up with what the server purged meanwhile.
+        if (state === SyncState.Syncing && prev !== SyncState.Syncing) this.schedule(0);
+    };
+
+    private schedule(delayMs: number): void {
+        if (this.timer) clearTimeout(this.timer);
+        this.timer = setTimeout(() => void this.sweep(), delayMs);
+    }
+
+    /** Removes what expired locally, asks the server about the rest, then sleeps until the next expiry. */
+    public async sweep(): Promise<void> {
+        if (this.checking) return;
+        this.checking = true;
+        let next = CHECK_INTERVAL_MS;
+        try {
+            const now = Date.now();
+            for (const room of this.client.getRooms()) {
+                const marked = room
+                    .getLiveTimeline()
+                    .getEvents()
+                    .filter((ev) => isMarked(ev) && ev.getId() && !ev.getId()!.startsWith("~"));
+                if (marked.length === 0) continue;
+
+                const pending: MatrixEvent[] = [];
+                for (const ev of marked) {
+                    const at = expiryOf(ev, room);
+                    if (at !== null && at <= now) {
+                        room.removeEvent(ev.getId()!);
+                    } else {
+                        pending.push(ev);
+                        if (at !== null) next = Math.min(next, Math.max(at - now, 250));
+                    }
+                }
+
+                if (pending.length > 0 && this.client.getSyncState() === SyncState.Syncing) {
+                    await this.dropPurged(room, pending);
+                }
+            }
+        } catch (e) {
+            logger.warn("FreeChat: disappearing messages sweep failed", e);
+        } finally {
+            this.checking = false;
+            this.schedule(next);
+        }
+    }
+
+    private async dropPurged(room: Room, events: MatrixEvent[]): Promise<void> {
+        for (let i = 0; i < events.length; i += CHECK_BATCH) {
+            const batch = events.slice(i, i + CHECK_BATCH).map((ev) => ev.getId()!);
+            const existing = await existingEvents(this.client, room.roomId, batch);
+            for (const eventId of batch) {
+                if (!existing.has(eventId)) room.removeEvent(eventId);
+            }
+        }
+    }
+}
+
+const MANAGERS = new WeakMap<MatrixClient, ExpiryManager>();
+
+export function installExpiry(client: MatrixClient): void {
+    if (MANAGERS.has(client)) return;
+    const manager = new ExpiryManager(client);
+    MANAGERS.set(client, manager);
+    manager.start();
+}
