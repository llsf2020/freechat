 import PlatformPeg from "./PlatformPeg";
 import * as TextForEvent from "./TextForEvent";
 import * as Avatar from "./Avatar";
@@ -270,6 +271,13 @@ export default class Notifier extends TypedEventEmitter<keyof EmittedEvents, Emi
             avatarUrl = Avatar.avatarUrlForMember(ev.sender, 40, 40, "crop");
         }
 
+        // FreeChat: without the message, say nothing about who wrote it or where either.
+        if (!this.isBodyEnabled()) {
+            title = SdkConfig.get().brand;
+            msg = ft("notification_new_messages");
+            avatarUrl = null;
+        }
+
         const notif = plaf.displayNotification(title, msg, avatarUrl, room, ev);
 
         // if displayNotification returns non-null,  the platform supports
