From 04e8b398a54743986f43c4bc28dd806e1919240a Mon Sep 17 00:00:00 2001
From: sjcsf <346224915+llsf2020@users.noreply.github.com>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH 09/12] FreeChat: notifications only say there are new messages

Showing the message in notifications is now off by default, and while it is
off the notification names neither the sender nor the room either.
---
 apps/web/src/Notifier.test.ts      | 15 +++++++++++++++
 apps/web/src/Notifier.ts           |  8 ++++++++
 apps/web/src/freechat/i18n.ts      |  3 +++
 apps/web/src/settings/Settings.tsx |  3 ++-
 4 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/apps/web/src/Notifier.test.ts b/apps/web/src/Notifier.test.ts
index 39866dd7fe..2fc55cd2cf 100644
--- a/apps/web/src/Notifier.test.ts
+++ b/apps/web/src/Notifier.test.ts
@@ -48,6 +48,7 @@ import { mkThread } from "test-utils/threads";
 import { waitFor } from "test-utils-rtl";
 
 import type BasePlatform from "./BasePlatform";
+import SdkConfig from "./SdkConfig";
 import Notifier, { NOTIFICATION_SOUND_THROTTLE_MS } from "./Notifier";
 import SettingsStore from "./settings/SettingsStore";
 import ToastStore from "./stores/ToastStore";
@@ -299,6 +300,20 @@ describe("Notifier", () => {
             expect(MockPlatform.displayNotification).toHaveBeenCalledWith(testRoom.name, "hey", null, testRoom, event);
         });
 
+        it("FreeChat: says only that there are new messages when the message body is off", () => {
+            vi.mocked(notifier.isBodyEnabled).mockReturnValue(false);
+            mockClient!.emit(ClientEvent.Sync, SyncState.Syncing, null);
+            emitLiveEvent(event);
+
+            expect(MockPlatform.displayNotification).toHaveBeenCalledWith(
+                SdkConfig.get().brand,
+                "You have new messages",
+                null,
+                testRoom,
+                event,
+            );
+        });
+
         it("closes a desktop notification when room is marked read", () => {
             mockClient!.emit(ClientEvent.Sync, SyncState.Syncing, null);
             emitLiveEvent(event);
