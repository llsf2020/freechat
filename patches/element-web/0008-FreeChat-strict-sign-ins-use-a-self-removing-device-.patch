  * chosen time, signs out on the server, so no orphaned device keeps receiving keys. Signing in
  * again takes the password and the recovery key.
  *
+ * The homeserver backs this up: strict sign-ins use a device ID that tells it to delete the device
+ * once it has been idle for the chosen time (see `strictDeviceId`).
+ *
  * The choice itself (on/off and the idle time) is stored in localStorage: it says nothing about
  * the user. It applies from the next sign-in; turning it on signs out right away.
  */
@@ -51,6 +54,18 @@ export function setStrictMode(mode: StrictMode): void {
     );
 }
 
+/**
+ * Device ID for a strict sign-in: `FCS<idle minutes>_<random>`. The homeserver deletes such a
+ * device once its token has been unused for that long, which covers a browser that crashed or
+ * was killed before it could sign out.
+ */
+export function strictDeviceId(): string {
+    const random = Array.from(crypto.getRandomValues(new Uint8Array(8)), (b) => b.toString(16).padStart(2, "0")).join(
+        "",
+    );
+    return `FCS${getStrictMode().idleMinutes}_${random}`;
+}
