+const MANAGERS = new WeakMap<MatrixClient, ExpiryManager>();
+
+/**
+ * Bumped whenever something that decides burn after reading changes in a room: a
+ * read receipt, a membership or a new event. Only kept for clients with an
+ * {@link ExpiryManager}, which listens for those changes.
+ */
+const ROOM_VERSIONS = new WeakMap<Room, number>();
+/** The last burn-after-reading answer per event, valid while its room's version is unchanged. */
+const BURN_CACHE = new WeakMap<MatrixEvent, { room: Room; version: number; at: number | null }>();
+
+function bumpRoom(room: Room | null | undefined): void {
+    if (room) ROOM_VERSIONS.set(room, (ROOM_VERSIONS.get(room) ?? 0) + 1);
+}
+
+/**
+ * When every other member read the event, plus its read TTL; null while someone
+ * has not read it, or when a receipt carries no time (the server check decides).
+ */
+function burnAt(ev: MatrixEvent, eventId: string, room: Room, readTtl: number): number | null {
+    const others = room
+        .getJoinedMembers()
+        .map((m) => m.userId)
+        .filter((userId) => userId !== ev.getSender());
+    if (others.length === 0 || !others.every((userId) => room.hasUserReadEvent(userId, eventId))) return null;
+
+    const times = others.map((userId) => room.getReadReceiptForUserId(userId, true)?.data.ts);
+    if (times.some((ts) => typeof ts !== "number")) return null;
+    return Math.max(...(times as number[])) + readTtl * 1000;
+}
+
 /** When this device should delete the event, in ms since the epoch, or null if not (yet) known. */
 export function expiryOf(ev: MatrixEvent, room: Room | null | undefined): number | null {
     const unsigned = ev.getUnsigned() as Record<string, unknown>;
-    let at = positive(unsigned[EXPIRES_AT_KEY]);
+    const at = positive(unsigned[EXPIRES_AT_KEY]);
 
     const readTtl = positive(unsigned[READ_TTL_KEY]);
     const eventId = ev.getId();
-    if (readTtl !== null && room && eventId) {
-        const others = room
-            .getJoinedMembers()
-            .map((m) => m.userId)
-            .filter((userId) => userId !== ev.getSender());
-        if (others.length > 0 && others.every((userId) => room.hasUserReadEvent(userId, eventId))) {
-            const readAt = Math.max(
-                ...others.map((userId) => room.getReadReceiptForUserId(userId, true)?.data.ts ?? Date.now()),
-            );
-            const burnAt = readAt + readTtl * 1000;
-            at = at === null ? burnAt : Math.min(at, burnAt);
-        }
+    if (readTtl === null || !room || !eventId) return at;
+
+    // Timelines are re-rendered often; walking every member's receipts each time is slow in big rooms.
+    const tracked = !!room.client && MANAGERS.has(room.client);
+    const version = ROOM_VERSIONS.get(room) ?? 0;
+    const cached = tracked ? BURN_CACHE.get(ev) : undefined;
+    let burn: number | null;
+    if (cached && cached.room === room && cached.version === version) {
+        burn = cached.at;
+    } else {
+        burn = burnAt(ev, eventId, room, readTtl);
+        if (tracked) BURN_CACHE.set(ev, { room, version, at: burn });
     }
 
-    return at;
+    if (burn === null) return at;
+    return at === null ? burn : Math.min(at, burn);
 }
 
