+
+describe("burn after reading without a receipt time", () => {
+    it("is left to the server instead of moving with the clock", () => {
+        const ev = anEvent({ [READ_TTL_KEY]: 5 });
+        const room = aRoom(["@a:x", "@b:x"], {});
+        room.hasUserReadEvent = () => true; // read, but the receipt has no timestamp
+        expect(expiryOf(ev, room)).toBeNull();
+        expect(expiryOf(anEvent({ [EXPIRES_AT_KEY]: 9000, [READ_TTL_KEY]: 5 }), room)).toBe(9000);
+    });
+});
+
+describe("burn after reading cache", () => {
+    /** A room of a client with an expiry manager, counting how often receipts are looked at. */
+    function aTrackedRoom(read: Record<string, number>) {
+        const client = Object.assign(new TypedEventEmitter<any, any>(), {
+            getRooms: () => [],
+            getRoom: () => room,
+            getSyncState: () => SyncState.Prepared,
+        });
+        const room = { ...aRoom(["@a:x", "@b:x"], read), roomId: "!r:x", client };
+        room.hasUserReadEvent = vi.fn(room.hasUserReadEvent);
+        installExpiry(client as any);
+        return { client, room };
+    }
+
+    it("reuses the answer until a receipt, membership or event changes the room", () => {
+        const read: Record<string, number> = {};
+        const { client, room } = aTrackedRoom(read);
+        const ev = anEvent({ [READ_TTL_KEY]: 5 });
+
+        expect(expiryOf(ev, room)).toBeNull();
+        expect(expiryOf(ev, room)).toBeNull();
+        expect(room.hasUserReadEvent).toHaveBeenCalledTimes(1);
+
+        read["@b:x"] = 1000;
+        client.emit(RoomEvent.Receipt, ev, room);
+        expect(expiryOf(ev, room)).toBe(6000);
+        expect(expiryOf(ev, room)).toBe(6000);
+        expect(room.hasUserReadEvent).toHaveBeenCalledTimes(2);
+
+        client.emit(RoomMemberEvent.Membership, ev, { roomId: "!r:x" });
+        expect(expiryOf(ev, room)).toBe(6000);
+        client.emit(RoomEvent.Timeline, ev, room);
+        expect(expiryOf(ev, room)).toBe(6000);
+        expect(room.hasUserReadEvent).toHaveBeenCalledTimes(4);
+    });
+
+    it("does not cache rooms nobody listens to", () => {
+        const room = aRoom(["@a:x", "@b:x"], { "@b:x": 1000 });
+        room.hasUserReadEvent = vi.fn(room.hasUserReadEvent);
+        const ev = anEvent({ [READ_TTL_KEY]: 5 });
+        expiryOf(ev, room);
+        expiryOf(ev, room);
+        expect(room.hasUserReadEvent).toHaveBeenCalledTimes(2);
+    });
+});
