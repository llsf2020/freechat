 apps/web/src/createRoom.test.ts                 | 13 +++++++++++++
 apps/web/src/createRoom.ts                      | 12 ++++++++++++
 apps/web/src/freechat/i18n.ts                   |  6 ++++++
 4 files changed, 48 insertions(+)

