diff --git a/apps/web/src/createRoom.ts b/apps/web/src/createRoom.ts
index d83db68304..3135f2f08b 100644
--- a/apps/web/src/createRoom.ts
+++ b/apps/web/src/createRoom.ts
@@ -82,6 +82,8 @@ export interface IOpts {
     // contextually only makes sense if parentSpace is specified, if true then will be added to parentSpace as suggested
     suggested?: boolean;
     joinRule?: JoinRule;
+    /** FreeChat: only moderators and admins post; everyone can still react. */
+    channel?: boolean;
 }
 
 /**
@@ -205,6 +207,16 @@ export default async function createRoom(client: MatrixClient, opts: IOpts): Pro
         };
     }
 
+    // FreeChat: in a channel only moderators and admins post; everyone can still react.
+    if (opts.channel) {
+        const override = createOpts.power_level_content_override ?? {};
+        createOpts.power_level_content_override = {
+            ...override,
+            events_default: 50,
+            events: { ...DEFAULT_EVENTS_POWER_LEVEL, ...override.events, [EventType.Reaction]: 0 },
+        };
+    }
+
     // By default, view the room after creating it
     if (opts.andView === undefined) {
         opts.andView = true;
