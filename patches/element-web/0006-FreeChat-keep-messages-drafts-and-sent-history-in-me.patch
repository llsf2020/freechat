+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { draftStorage, purgePersistedMessages } from "./localPrivacy";
+
+describe("localPrivacy", () => {
+    afterEach(() => {
+        localStorage.clear();
+        vi.unstubAllGlobals();
+    });
+
+    it("keeps drafts in memory, not in localStorage", () => {
+        draftStorage.setItem("mx_cider_state_!room:x", "secret draft");
+        expect(draftStorage.getItem("mx_cider_state_!room:x")).toBe("secret draft");
+        expect(localStorage.getItem("mx_cider_state_!room:x")).toBeNull();
+        draftStorage.removeItem("mx_cider_state_!room:x");
+        expect(draftStorage.getItem("mx_cider_state_!room:x")).toBeNull();
+    });
+
+    it("deletes drafts and the sync store an older build left on disk", () => {
+        const deleteDatabase = vi.fn();
+        vi.stubGlobal("indexedDB", { deleteDatabase });
+        localStorage.setItem("mx_cider_state_!a:x", "old");
+        localStorage.setItem("mx_wysiwyg_state_!a:x", "old");
+        localStorage.setItem("mx_edit_room_!a:x_Room", "$ev");
+        localStorage.setItem("mx_edit_state_$ev", "old");
+        localStorage.setItem("mx_access_token", "keep");
+
+        purgePersistedMessages();
+
+        expect(deleteDatabase).toHaveBeenCalledWith("riot-web-sync");
+        expect(localStorage.length).toBe(1);
+        expect(localStorage.getItem("mx_access_token")).toBe("keep");
+    });
+});
diff --git a/apps/web/src/freechat/localPrivacy.ts b/apps/web/src/freechat/localPrivacy.ts
