@@ -0,0 +1,67 @@
+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: keep message content off the device's disk.
+ *
+ * - The sync store (rooms, timelines, latest messages) lives in memory only; every launch
+ *   starts from a fresh sync. Only the crypto store (keys) is persisted.
+ * - Composer drafts and the sent-message history (arrow-up recall) live in memory only.
+ * - Data an older build may have written (the IndexedDB sync store, drafts in localStorage)
+ *   is deleted at startup.
+ */
+
+import { logger } from "matrix-js-sdk/src/logger";
+
+const LEGACY_SYNC_STORE = "riot-web-sync";
+const DRAFT_PREFIXES = ["mx_cider_state_", "mx_wysiwyg_state_", "mx_edit_room_", "mx_edit_state_"];
+
+class MemoryStorage {
+    private readonly items = new Map<string, string>();
+
+    public getItem(key: string): string | null {
+        return this.items.get(key) ?? null;
+    }
+
+    public setItem(key: string, value: string): void {
+        this.items.set(key, String(value));
+    }
+
+    public removeItem(key: string): void {
+        this.items.delete(key);
+    }
+
+    public keys(): string[] {
+        return [...this.items.keys()];
+    }
+
+    public clear(): void {
+        this.items.clear();
+    }
+}
+
+/** Replaces `localStorage` / `sessionStorage` for drafts and sent history. Cleared on logout and reload. */
+export const draftStorage = new MemoryStorage();
+
+/** Removes message content an earlier build left on disk. Safe to call on every start. */
+export function purgePersistedMessages(): void {
+    try {
+        globalThis.indexedDB?.deleteDatabase(LEGACY_SYNC_STORE);
+    } catch (e) {
+        logger.warn("FreeChat: could not delete the legacy sync store", e);
+    }
+    try {
+        const stale: string[] = [];
+        for (let i = 0; i < localStorage.length; i++) {
+            const key = localStorage.key(i);
+            if (key && DRAFT_PREFIXES.some((prefix) => key.startsWith(prefix))) stale.push(key);
+        }
+        stale.forEach((key) => localStorage.removeItem(key));
+    } catch (e) {
+        logger.warn("FreeChat: could not clear stored drafts", e);
+    }
+}
