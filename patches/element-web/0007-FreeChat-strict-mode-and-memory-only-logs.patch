+
+/*
+ * FreeChat: the strict mode switch in Security & Privacy. See strictMode.ts.
+ */
+
+import React, { type JSX, useState } from "react";
+
+import Modal from "../Modal";
+import QuestionDialog from "../components/views/dialogs/QuestionDialog";
+import LogoutDialog from "../components/views/dialogs/LogoutDialog";
+import AccessibleButton from "../components/views/elements/AccessibleButton";
+import StyledRadioGroup from "../components/views/elements/StyledRadioGroup";
+import SettingsFieldset from "../components/views/settings/SettingsFieldset";
+import { IDLE_PRESETS_MINUTES, getStrictMode, isStrictSession, setStrictMode } from "./strictMode";
+import { ft } from "./i18n";
+
+async function turnOn(idleMinutes: number): Promise<void> {
+    const { finished } = Modal.createDialog(QuestionDialog, {
+        title: ft("strict_confirm_title"),
+        description: ft("strict_confirm_body"),
+        button: ft("strict_confirm_button"),
+        danger: true,
+    });
+    const [confirmed] = await finished;
+    if (!confirmed) return;
+
+    setStrictMode({ enabled: true, idleMinutes });
+    // The upstream dialog warns if the keys are not backed up, then signs out.
+    const [signedOut] = await Modal.createDialog(LogoutDialog).finished;
+    if (!signedOut) setStrictMode({ enabled: false, idleMinutes });
+}
+
+export function StrictModeSettings(): JSX.Element {
+    const [mode, setMode] = useState(getStrictMode);
+    const strictNow = isStrictSession();
+
+    const update = (next: typeof mode): void => {
+        setStrictMode(next);
+        setMode(next);
+    };
+
+    let body: JSX.Element;
+    if (strictNow && mode.enabled) {
+        body = (
+            <>
+                <p>{ft("strict_on")}</p>
+                <StyledRadioGroup
+                    name="freechatStrictIdle"
+                    value={String(mode.idleMinutes)}
+                    onChange={(value) => update({ ...mode, idleMinutes: Number(value) })}
+                    definitions={IDLE_PRESETS_MINUTES.map((minutes) => ({
+                        value: String(minutes),
+                        label: ft("minutes", { count: minutes }),
+                    }))}
+                />
+                <AccessibleButton kind="secondary" onClick={() => update({ ...mode, enabled: false })}>
+                    {ft("strict_disable")}
+                </AccessibleButton>
+            </>
+        );
+    } else if (strictNow) {
+        body = <p>{ft("strict_disabled_pending")}</p>;
+    } else {
+        body = (
+            <AccessibleButton kind="danger_outline" onClick={() => void turnOn(mode.idleMinutes)}>
+                {ft("strict_enable")}
+            </AccessibleButton>
+        );
+    }
+
+    return (
+        <SettingsFieldset legend={ft("strict_legend")} description={ft("strict_description")}>
+            {strictNow && mode.enabled && <h4>{ft("strict_idle_legend")}</h4>}
+            {body}
+        </SettingsFieldset>
+    );
+}
