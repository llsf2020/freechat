+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { type MatrixClient } from "matrix-js-sdk/src/matrix";
+
+import {
+    DEFAULT_IDLE_MINUTES,
+    beginSession,
+    endSession,
+    getStrictMode,
+    isStrictSession,
+    keepStrictModeChoice,
+    setStrictMode,
+    watchStrictSession,
+} from "./strictMode";
+
+const client = {
+    baseUrl: "https://chat.example",
+    getAccessToken: () => "secret-token",
+} as unknown as MatrixClient;
+
+function setVisibility(state: "visible" | "hidden"): void {
+    Object.defineProperty(document, "visibilityState", { configurable: true, get: () => state });
+    document.dispatchEvent(new Event("visibilitychange"));
+}
+
+describe("strict mode", () => {
+    beforeEach(() => localStorage.clear());
+    afterEach(() => {
+        endSession();
+        setVisibility("visible");
+        vi.useRealTimers();
+        vi.unstubAllGlobals();
+    });
+
+    it("is off by default and tolerates junk", () => {
+        expect(getStrictMode()).toEqual({ enabled: false, idleMinutes: DEFAULT_IDLE_MINUTES });
+        localStorage.setItem("freechat_strict_mode", "{not json");
+        expect(getStrictMode().enabled).toBe(false);
+        localStorage.setItem("freechat_strict_mode", JSON.stringify({ enabled: "yes", idleMinutes: -3 }));
+        expect(getStrictMode()).toEqual({ enabled: false, idleMinutes: DEFAULT_IDLE_MINUTES });
+    });
+
+    it("fixes the session's mode at sign-in", () => {
+        setStrictMode({ enabled: true, idleMinutes: 1 });
+        expect(beginSession()).toBe(true);
+        setStrictMode({ enabled: false, idleMinutes: 1 });
+        expect(isStrictSession()).toBe(true);
+        endSession();
+        expect(isStrictSession()).toBe(false);
+    });
+
+    it("survives a wipe of localStorage", () => {
+        setStrictMode({ enabled: true, idleMinutes: 15 });
+        const restore = keepStrictModeChoice();
+        localStorage.clear();
+        restore();
+        expect(getStrictMode()).toEqual({ enabled: true, idleMinutes: 15 });
+    });
+
+    it("signs out after the idle time in the background", () => {
+        vi.useFakeTimers();
+        setStrictMode({ enabled: true, idleMinutes: 5 });
+        const logout = vi.fn();
+        watchStrictSession(client, logout);
+
+        setVisibility("hidden");
+        vi.advanceTimersByTime(4 * 60_000);
+        setVisibility("visible");
+        expect(logout).not.toHaveBeenCalled();
+
+        setVisibility("hidden");
+        vi.advanceTimersByTime(5 * 60_000);
+        expect(logout).toHaveBeenCalledTimes(1);
+        setVisibility("visible");
+        expect(logout).toHaveBeenCalledTimes(1);
+    });
+
+    it("signs out when coming back after the timer was frozen", () => {
+        vi.useFakeTimers();
+        setStrictMode({ enabled: true, idleMinutes: 1 });
+        const logout = vi.fn();
+        watchStrictSession(client, logout);
+
+        setVisibility("hidden");
+        vi.setSystemTime(Date.now() + 2 * 60_000); // the clock moves, timers do not fire
+        setVisibility("visible");
+        expect(logout).toHaveBeenCalledTimes(1);
+    });
+
+    it("signs out on the server and wipes localStorage when the page goes away", () => {
+        const fetch = vi.fn().mockResolvedValue(undefined);
+        vi.stubGlobal("fetch", fetch);
+        setStrictMode({ enabled: true, idleMinutes: 5 });
+        localStorage.setItem("mx_local_settings", '{"language":"zh-hans"}');
+        localStorage.setItem("mx_last_room_id", "!secret:chat.example");
+        watchStrictSession(client, vi.fn());
+
+        window.dispatchEvent(new Event("pagehide"));
+
+        expect(fetch).toHaveBeenCalledWith(
+            "https://chat.example/_matrix/client/v3/logout",
+            expect.objectContaining({
+                method: "POST",
+                keepalive: true,
+                headers: expect.objectContaining({ Authorization: "Bearer secret-token" }),
+            }),
+        );
+        expect(localStorage.getItem("mx_last_room_id")).toBeNull();
+        expect(localStorage.getItem("mx_local_settings")).toBe('{"language":"zh-hans"}');
+        expect(getStrictMode().enabled).toBe(true);
+    });
+
+    it("stops watching on sign-out", () => {
+        vi.useFakeTimers();
+        const logout = vi.fn();
+        beginSession();
+        watchStrictSession(client, logout);
+        endSession();
+        setVisibility("hidden");
+        vi.advanceTimersByTime(60 * 60_000);
+        expect(logout).not.toHaveBeenCalled();
+    });
+});
