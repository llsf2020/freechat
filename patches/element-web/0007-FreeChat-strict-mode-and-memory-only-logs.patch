+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: strict mode, a per-device choice to leave nothing on the device.
+ *
+ * While it is on, a session is never written to disk: the login is not persisted and the crypto
+ * store is in memory. Closing or reloading the page, or leaving it in the background for the
+ * chosen time, signs out on the server, so no orphaned device keeps receiving keys. Signing in
+ * again takes the password and the recovery key.
+ *
+ * The choice itself (on/off and the idle time) is stored in localStorage: it says nothing about
+ * the user. It applies from the next sign-in; turning it on signs out right away.
+ */
+
+import { type MatrixClient } from "matrix-js-sdk/src/matrix";
+import { logger } from "matrix-js-sdk/src/logger";
+
+const STORAGE_KEY = "freechat_strict_mode";
+
+export const IDLE_PRESETS_MINUTES = [1, 5, 15, 30, 60];
+export const DEFAULT_IDLE_MINUTES = 5;
+
+export interface StrictMode {
+    enabled: boolean;
+    idleMinutes: number;
+}
+
+function validIdle(value: unknown): number {
+    return typeof value === "number" && Number.isInteger(value) && value > 0 ? value : DEFAULT_IDLE_MINUTES;
+}
+
+export function getStrictMode(): StrictMode {
+    try {
+        const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "null");
+        if (parsed && typeof parsed === "object") {
+            return { enabled: parsed.enabled === true, idleMinutes: validIdle(parsed.idleMinutes) };
+        }
+    } catch {}
+    return { enabled: false, idleMinutes: DEFAULT_IDLE_MINUTES };
+}
+
+export function setStrictMode(mode: StrictMode): void {
+    localStorage.setItem(
+        STORAGE_KEY,
+        JSON.stringify({ enabled: mode.enabled, idleMinutes: validIdle(mode.idleMinutes) }),
+    );
+}
+
+/**
+ * Whether the session currently running is a strict one. Fixed at sign-in, so turning strict mode
+ * off mid-session does not suddenly start persisting an in-memory session.
+ */
+let strictSession = false;
+
+let stopWatching: (() => void) | undefined;
+
+/** Called once per sign-in, before the session is persisted or crypto starts. */
+export function beginSession(): boolean {
+    endSession();
+    strictSession = getStrictMode().enabled;
+    return strictSession;
+}
+
+/** Called on sign-out. */
+export function endSession(): void {
+    stopWatching?.();
+    stopWatching = undefined;
+    strictSession = false;
+}
+
+/** Keeps the strict mode choice across a wipe of localStorage. Returns the function that puts it back. */
+export function keepStrictModeChoice(): () => void {
+    let saved: string | null = null;
+    try {
+        saved = localStorage.getItem(STORAGE_KEY);
+    } catch {}
+    return () => {
+        if (saved !== null) localStorage.setItem(STORAGE_KEY, saved);
+    };
+}
+
+export function isStrictSession(): boolean {
+    return strictSession;
+}
+
+/** Device preferences (language, theme) that say nothing about the user and survive a wipe. */
+const KEPT_KEYS = [STORAGE_KEY, "mx_local_settings"];
+
+/**
+ * Clears localStorage synchronously, for the moment the page goes away when there is no time for
+ * the app's full sign-out. The next start finishes the job (see `loadSession`).
+ */
+function wipeLocalStorage(): void {
+    try {
+        const kept = KEPT_KEYS.map((key) => [key, localStorage.getItem(key)] as const);
+        localStorage.clear();
+        for (const [key, value] of kept) if (value !== null) localStorage.setItem(key, value);
+    } catch (e) {
+        logger.warn("FreeChat: strict mode could not clear localStorage", e);
+    }
+}
+
+/** Signs out on the server while the page unloads; `fetch` with `keepalive` outlives the page. */
+function logoutOnUnload(client: MatrixClient): void {
+    const token = client.getAccessToken();
+    if (!token) return;
+    try {
+        void fetch(`${client.baseUrl}/_matrix/client/v3/logout`, {
+            method: "POST",
+            keepalive: true,
+            headers: { "Authorization": `Bearer ${token}`, "Content-Type": "application/json" },
+            body: "{}",
+        });
+    } catch (e) {
+        logger.warn("FreeChat: strict mode could not sign out on unload", e);
+    }
+}
+
+/**
+ * Watches a strict session: signs out when the page goes away or stays hidden for the idle time.
+ * `logout` is the app's normal sign-out, which also clears local storage.
+ * Returns a function that stops watching.
+ */
+export function watchStrictSession(client: MatrixClient, logout: () => void): () => void {
+    // Read on every use so a new idle time applies straight away.
+    const idleMs = (): number => getStrictMode().idleMinutes * 60_000;
+    let hiddenAt: number | null = null;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let stopped = false;
+
+    const signOut = (): void => {
+        if (stopped) return;
+        stop();
+        logger.info("FreeChat: strict mode signing out after being in the background");
+        logout();
+    };
+    const onVisibility = (): void => {
+        if (document.visibilityState === "hidden") {
+            hiddenAt = Date.now();
+            clearTimeout(timer);
+            timer = setTimeout(signOut, idleMs());
+        } else {
+            clearTimeout(timer);
+            // Timers in background tabs can be throttled or frozen, so check the clock as well.
+            if (hiddenAt !== null && Date.now() - hiddenAt >= idleMs()) signOut();
+            hiddenAt = null;
+        }
+    };
+    const onPageHide = (): void => {
+        if (stopped) return;
+        stop();
+        logoutOnUnload(client);
+        wipeLocalStorage();
+    };
+    function stop(): void {
+        stopped = true;
+        clearTimeout(timer);
+        document.removeEventListener("visibilitychange", onVisibility);
+        window.removeEventListener("pagehide", onPageHide);
+    }
+
+    stopWatching?.();
+    stopWatching = stop;
+    document.addEventListener("visibilitychange", onVisibility);
+    window.addEventListener("pagehide", onPageHide);
+    return stop;
+}
