+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+import { Method } from "matrix-js-sdk/src/matrix";
+import { describe, it, expect, vi } from "vitest";
+
+import { hasJoinPassword, joinWithPassword, setJoinPassword } from "./api";
+
+function aClient(response: unknown = {}) {
+    return {
+        http: { authedRequest: vi.fn().mockResolvedValue(response) },
+        joinRoom: vi.fn().mockResolvedValue({}),
+    } as any;
+}
+
+const PREFIX = { prefix: "/_matrix/client/unstable/com.freechat" };
+
+describe("FreeChat join password API", () => {
+    it("reads whether a password is set", async () => {
+        const client = aClient({ enabled: true });
+        await expect(hasJoinPassword(client, "!r:x")).resolves.toBe(true);
+        expect(client.http.authedRequest).toHaveBeenCalledWith(
+            Method.Get,
+            "/rooms/!r%3Ax/join_password",
+            undefined,
+            undefined,
+            PREFIX,
+        );
+    });
+
+    it("sets and removes the password", async () => {
+        const client = aClient();
+        await setJoinPassword(client, "!r:x", "s3cret-pass");
+        await setJoinPassword(client, "!r:x", null);
+        expect(client.http.authedRequest).toHaveBeenNthCalledWith(
+            1,
+            Method.Put,
+            "/rooms/!r%3Ax/join_password",
+            undefined,
+            { password: "s3cret-pass" },
+            PREFIX,
+        );
+        expect(client.http.authedRequest).toHaveBeenNthCalledWith(
+            2,
+            Method.Put,
+            "/rooms/!r%3Ax/join_password",
+            undefined,
+            {},
+            PREFIX,
+        );
+    });
+
+    it("joins only after the password is accepted", async () => {
+        const client = aClient();
+        await joinWithPassword(client, "!r:x", "pw");
+        expect(client.http.authedRequest).toHaveBeenCalledWith(
+            Method.Post,
+            "/rooms/!r%3Ax/join_with_password",
+            undefined,
+            { password: "pw" },
+            PREFIX,
+        );
+        expect(client.joinRoom).toHaveBeenCalledWith("!r:x");
+
+        const rejecting = aClient();
+        rejecting.http.authedRequest.mockRejectedValue(new Error("403"));
+        await expect(joinWithPassword(rejecting, "!r:x", "bad")).rejects.toThrow();
+        expect(rejecting.joinRoom).not.toHaveBeenCalled();
+    });
+});
diff --git a/apps/web/src/freechat/api.ts b/apps/web/src/freechat/api.ts
new file mode 100644
index 0000000000..a835685880
--- /dev/null
+++ b/apps/web/src/freechat/api.ts
@@ -0,0 +1,56 @@
+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: homeserver API extensions under /_matrix/client/unstable/com.freechat.
+ */
+
+import { Method, type MatrixClient } from "matrix-js-sdk/src/matrix";
+
+const PREFIX = "/_matrix/client/unstable/com.freechat";
+
+function roomPath(roomId: string, rest: string): string {
+    return `/rooms/${encodeURIComponent(roomId)}/${rest}`;
+}
+
+/** Whether the room has a join password. Room admins only. */
+export async function hasJoinPassword(client: MatrixClient, roomId: string): Promise<boolean> {
+    const res = await client.http.authedRequest<{ enabled: boolean }>(
+        Method.Get,
+        roomPath(roomId, "join_password"),
+        undefined,
+        undefined,
+        { prefix: PREFIX },
+    );
+    return res.enabled;
+}
+
+/** Sets the room's join password, or removes it with null. Room admins only. */
+export async function setJoinPassword(client: MatrixClient, roomId: string, password: string | null): Promise<void> {
+    await client.http.authedRequest(
+        Method.Put,
+        roomPath(roomId, "join_password"),
+        undefined,
+        password === null ? {} : { password },
+        { prefix: PREFIX },
+    );
+}
+
+/** Gets invited with the password, then joins the room normally. */
+export async function joinWithPassword(client: MatrixClient, roomId: string, password: string): Promise<void> {
+    await client.http.authedRequest(
+        Method.Post,
+        roomPath(roomId, "join_with_password"),
+        undefined,
+        { password },
+        { prefix: PREFIX },
+    );
+    await client.joinRoom(roomId);
+}
+
+/** Minimum length the server accepts. */
+export const MIN_JOIN_PASSWORD_LENGTH = 6;
