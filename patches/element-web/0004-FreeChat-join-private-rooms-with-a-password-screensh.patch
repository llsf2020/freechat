+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: room admin settings for private rooms (join password, invite link)
+ * and screenshot blocking.
+ */
+
+import React, { type JSX, useContext, useEffect, useState } from "react";
+import { type Room } from "matrix-js-sdk/src/matrix";
+import { logger } from "matrix-js-sdk/src/logger";
+import { SettingsToggleInput } from "@vector-im/compound-web";
+
+import MatrixClientContext from "../contexts/MatrixClientContext";
+import { useRoomState } from "../hooks/useRoomState";
+import Modal from "../Modal";
+import ErrorDialog from "../components/views/dialogs/ErrorDialog";
+import AccessibleButton from "../components/views/elements/AccessibleButton";
+import Field from "../components/views/elements/Field";
+import SettingsFieldset from "../components/views/settings/SettingsFieldset";
+import { copyPlaintext } from "../utils/strings";
+import { MIN_JOIN_PASSWORD_LENGTH, hasJoinPassword, setJoinPassword } from "./api";
+import { PRIVACY_EVENT_TYPE, isRoomAdmin } from "./disappearing";
+import { ft } from "./i18n";
+
+function showError(title: string, e: unknown): void {
+    logger.error(`FreeChat: ${title}`, e);
+    Modal.createDialog(ErrorDialog, { title, description: e instanceof Error ? e.message : String(e) });
+}
+
+/** The link that opens this room; with the password it lets people join. */
+export function roomLink(roomId: string): string {
+    return `${window.location.origin}${window.location.pathname}#/room/${encodeURIComponent(roomId)}`;
+}
+
+export default function PrivateRoomSettings({ room }: { room: Room }): JSX.Element | null {
+    const client = useContext(MatrixClientContext);
+    const { isAdmin, blockScreenshots } = useRoomState(room, (state) => ({
+        isAdmin: isRoomAdmin(state, client.getSafeUserId()),
+        blockScreenshots: state.getStateEvents(PRIVACY_EVENT_TYPE, "")?.getContent()?.block_screenshots === true,
+    }));
+    const [enabled, setEnabled] = useState<boolean | null>(null);
+    const [password, setPassword] = useState("");
+    const [busy, setBusy] = useState(false);
+    const [copied, setCopied] = useState(false);
+
+    useEffect(() => {
+        if (!isAdmin) return;
+        hasJoinPassword(client, room.roomId)
+            .then(setEnabled)
+            .catch((e) => logger.warn("FreeChat: cannot read join password state", e));
+    }, [client, room.roomId, isAdmin]);
+
+    if (!isAdmin) return null;
+
+    const save = async (next: string | null): Promise<void> => {
+        setBusy(true);
+        try {
+            await setJoinPassword(client, room.roomId, next);
+            setEnabled(next !== null);
+            setPassword("");
+        } catch (e) {
+            showError(ft("pw_error_title"), e);
+        } finally {
+            setBusy(false);
+        }
+    };
+
+    const toggleScreenshots = async (on: boolean): Promise<void> => {
+        try {
+            await client.sendStateEvent(room.roomId, PRIVACY_EVENT_TYPE as any, { block_screenshots: on }, "");
+        } catch (e) {
+            showError(ft("privacy_error_title"), e);
+        }
+    };
+
+    const copyLink = async (): Promise<void> => {
+        setCopied(await copyPlaintext(roomLink(room.roomId)));
+    };
+
+    return (
+        <>
+            <SettingsFieldset legend={ft("pw_settings_legend")} description={ft("pw_settings_description")}>
+                <p>{enabled === null ? "…" : enabled ? ft("pw_status_on") : ft("pw_status_off")}</p>
+                <Field
+                    type="password"
+                    autoComplete="new-password"
+                    label={enabled ? ft("pw_new_label") : ft("pw_label")}
+                    value={password}
+                    onChange={(ev: React.ChangeEvent<HTMLInputElement>) => setPassword(ev.target.value)}
+                    disabled={busy}
+                />
+                <AccessibleButton
+                    kind="primary_sm"
+                    disabled={busy || password.length < MIN_JOIN_PASSWORD_LENGTH}
+                    onClick={() => void save(password)}
+                >
+                    {ft("pw_save")}
+                </AccessibleButton>{" "}
+                {enabled && (
+                    <AccessibleButton kind="danger_sm" disabled={busy} onClick={() => void save(null)}>
+                        {ft("pw_remove")}
+                    </AccessibleButton>
+                )}
+                <p>
+                    {ft("pw_link_label")} <code>{roomLink(room.roomId)}</code>{" "}
+                    <AccessibleButton kind="link_inline" onClick={() => void copyLink()}>
+                        {copied ? ft("copied") : ft("copy")}
+                    </AccessibleButton>
+                </p>
+            </SettingsFieldset>
+            <SettingsFieldset legend={ft("privacy_legend")}>
+                <SettingsToggleInput
+                    name="freechat-block-screenshots"
+                    checked={blockScreenshots}
+                    onChange={(ev) => void toggleScreenshots(ev.target.checked)}
+                    label={ft("block_screenshots_label")}
+                    helpMessage={ft("block_screenshots_help")}
+                />
+            </SettingsFieldset>
+        </>
+    );
+}
diff --git a/apps/web/src/freechat/api.test.ts b/apps/web/src/freechat/api.test.ts
