diff --git a/apps/web/src/freechat/PasswordJoin.tsx b/apps/web/src/freechat/PasswordJoin.tsx
new file mode 100644
index 0000000000..7ee051bcc8
--- /dev/null
+++ b/apps/web/src/freechat/PasswordJoin.tsx
@@ -0,0 +1,91 @@
+/*
+Copyright 2026 FreeChat contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+ * FreeChat: "join with password" for private rooms opened from a link.
+ */
+
+import React, { type JSX, useContext, useState } from "react";
+import { MatrixError } from "matrix-js-sdk/src/matrix";
+
+import MatrixClientContext from "../contexts/MatrixClientContext";
+import Modal from "../Modal";
+import BaseDialog from "../components/views/dialogs/BaseDialog";
+import DialogButtons from "../components/views/elements/DialogButtons";
+import Field from "../components/views/elements/Field";
+import AccessibleButton from "../components/views/elements/AccessibleButton";
+import dis from "../dispatcher/dispatcher";
+import { Action } from "../dispatcher/actions";
+import { joinWithPassword } from "./api";
+import { ft } from "./i18n";
+
+interface DialogProps {
+    roomId: string;
+    onFinished: (joined?: boolean) => void;
+}
+
+export function JoinWithPasswordDialog({ roomId, onFinished }: DialogProps): JSX.Element {
+    const client = useContext(MatrixClientContext);
+    const [password, setPassword] = useState("");
+    const [busy, setBusy] = useState(false);
+    const [error, setError] = useState<string | null>(null);
+
+    const onSubmit = async (e?: React.FormEvent): Promise<void> => {
+        e?.preventDefault();
+        if (!password || busy) return;
+        setBusy(true);
+        setError(null);
+        try {
+            await joinWithPassword(client, roomId, password);
+            dis.dispatch({ action: Action.ViewRoom, room_id: roomId, metricsTrigger: undefined });
+            onFinished(true);
+        } catch (err) {
+            const code = err instanceof MatrixError ? err.httpStatus : undefined;
+            setError(code === 429 ? ft("pw_join_locked") : ft("pw_join_wrong"));
+            setBusy(false);
+        }
+    };
+
+    return (
+        <BaseDialog title={ft("pw_join_title")} onFinished={() => onFinished(false)} fixedWidth={false}>
+            <form onSubmit={onSubmit}>
+                <p>{ft("pw_join_description")}</p>
+                <Field
+                    type="password"
+                    autoComplete="off"
+                    label={ft("pw_label")}
+                    value={password}
+                    onChange={(ev: React.ChangeEvent<HTMLInputElement>) => setPassword(ev.target.value)}
+                    autoFocus
+                />
+                {error && <p className="mx_Field_invalid">{error}</p>}
+            </form>
+            <DialogButtons
+                primaryButton={busy ? ft("pw_joining") : ft("pw_join_button")}
+                onPrimaryButtonClick={() => void onSubmit()}
+                primaryDisabled={!password || busy}
+                onCancel={() => onFinished(false)}
+            />
+        </BaseDialog>
+    );
+}
+
+/** Shown on the preview of a room the user cannot see or join. */
+export function JoinWithPasswordButton({ roomId }: { roomId?: string }): JSX.Element | null {
+    // Private rooms have no alias, so links carry the room ID.
+    if (!roomId?.startsWith("!")) return null;
+    return (
+        <AccessibleButton
+            kind="link_inline"
+            onClick={() => {
+                Modal.createDialog(JoinWithPasswordDialog, { roomId });
+            }}
+        >
+            {ft("pw_join_link")}
+        </AccessibleButton>
+    );
+}
diff --git a/apps/web/src/freechat/PrivateRoomSettings.tsx b/apps/web/src/freechat/PrivateRoomSettings.tsx
