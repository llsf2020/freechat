+/// Media referenced by the messages of `room_id` strictly before `until`, with
+/// their senders, including what clients reported for them.
+#[implement(Service)]
+async fn history_media(&self, room_id: &RoomId, until: PduCount) -> Vec<(String, OwnedUserId)> {
+	// Only IDs are kept, not whole events: the first sweep after the cap is set
+	// can cover a long history.
+	let messages: Vec<(OwnedEventId, OwnedUserId, Vec<String>)> = self
+		.services
+		.timeline
+		.pdus(None, room_id, None)
+		.ready_take_while(|item| item.as_ref().is_ok_and(|(count, _)| *count < until))
+		.ready_filter_map(Result::ok)
+		.ready_filter_map(|(_, pdu)| {
+			is_expirable(&pdu).then(|| {
+				(pdu.event_id().to_owned(), pdu.sender().to_owned(), media_mxcs(&pdu))
+			})
+		})
+		.collect()
+		.await;
+
+	let mut media = Vec::new();
+	for (event_id, sender, mut mxcs) in messages {
+		mxcs.extend(self.take_event_media(&event_id).await);
+		media.extend(mxcs.into_iter().map(|mxc| (mxc, sender.clone())));
+	}
+
+	media
+}
