+//! FreeChat client API extensions, under `/_matrix/client/unstable/com.freechat/`.
+//!
+//! Plain axum handlers: ruma's endpoint macros need crate features this crate
+//! does not define, so the access token is checked here the same way the
+//! router does for typed routes.
+
+use std::time::SystemTime;
+
+use axum::{
+	Json,
+	extract::{Path, State},
+	response::IntoResponse,
+};
+use axum_extra::{
+	TypedHeader,
+	headers::{Authorization, authorization::Bearer},
+};
+use ruma::{OwnedRoomId, OwnedUserId};
+use serde::Deserialize;
+use serde_json::json;
+use tuwunel_core::{Err, Result};
+
+/// `GET /_matrix/client/unstable/com.freechat/rooms/{roomId}/join_password`
+///
+/// Reports whether the room has a join password. Room admins only.
+pub(crate) async fn get_join_password_route(
+	State(services): State<crate::State>,
+	TypedHeader(Authorization(bearer)): TypedHeader<Authorization<Bearer>>,
+	Path(room_id): Path<OwnedRoomId>,
+) -> Result<impl IntoResponse> {
+	let user = authenticate(&services, bearer.token()).await?;
+	let enabled = services
+		.disappearing
+		.has_join_password(&user, &room_id)
+		.await?;
+
+	Ok(Json(json!({ "enabled": enabled })))
+}
+
+#[derive(Deserialize)]
+pub(crate) struct SetJoinPassword {
+	/// The new password; absent or null removes it.
+	#[serde(default)]
+	password: Option<String>,
+}
+
+/// `PUT /_matrix/client/unstable/com.freechat/rooms/{roomId}/join_password`
+///
+/// Sets the room's join password, or removes it. Room admins only.
+pub(crate) async fn set_join_password_route(
+	State(services): State<crate::State>,
+	TypedHeader(Authorization(bearer)): TypedHeader<Authorization<Bearer>>,
+	Path(room_id): Path<OwnedRoomId>,
+	Json(body): Json<SetJoinPassword>,
+) -> Result<impl IntoResponse> {
+	let user = authenticate(&services, bearer.token()).await?;
+	services
+		.disappearing
+		.set_join_password(&user, &room_id, body.password.as_deref())
+		.await?;
+
+	Ok(Json(json!({})))
+}
+
+#[derive(Deserialize)]
+pub(crate) struct JoinWithPassword {
+	password: String,
+}
+
+/// `POST /_matrix/client/unstable/com.freechat/rooms/{roomId}/join_with_password`
+///
+/// Invites the caller into the room when the password matches; the caller then
+/// joins with the regular join endpoint.
+pub(crate) async fn join_with_password_route(
+	State(services): State<crate::State>,
+	TypedHeader(Authorization(bearer)): TypedHeader<Authorization<Bearer>>,
+	Path(room_id): Path<OwnedRoomId>,
+	Json(body): Json<JoinWithPassword>,
+) -> Result<impl IntoResponse> {
+	let user = authenticate(&services, bearer.token()).await?;
+	services
+		.disappearing
+		.join_with_password(&user, &room_id, &body.password)
+		.await?;
+
+	Ok(Json(json!({ "room_id": room_id })))
+}
+
+/// Resolves an access token to an active local user, like the router's auth.
+async fn authenticate(services: &crate::State, token: &str) -> Result<OwnedUserId> {
+	let Ok((user_id, _device_id, expires_at)) = services.users.find_from_token(token).await
+	else {
+		return Err!(Request(Unauthorized("Unknown access token.")));
+	};
+
+	if expires_at.is_some_and(|expires_at| expires_at < SystemTime::now()) {
+		return Err!(Request(Unauthorized("Access token has expired.")));
+	}
+
+	if services.users.is_deactivated(&user_id).await.unwrap_or(true) {
+		return Err!(Request(UserDeactivated("This account is deactivated.")));
+	}
+
+	Ok(user_id)
+}
