@@ -0,0 +1,224 @@
+//! FreeChat: join a private room with a link and a password.
+//!
+//! A room admin sets a password; only its argon2 hash is stored, server-side
+//! in `roomid_joinpassword` and never in room state, so members cannot read
+//! it either. Anyone holding the room link and the password is invited by the
+//! server on behalf of a member who may invite, then joins normally. The room
+//! keeps its invite-only join rule, so without the password nothing about it
+//! is visible. Failed attempts are limited per user and room.
+
+use std::{
+	collections::HashMap,
+	sync::Mutex,
+	time::{Duration, Instant},
+};
+
+use futures::StreamExt;
+use http::StatusCode;
+use ruma::{
+	OwnedRoomId, OwnedUserId, RoomId, UserId,
+	api::error::{ErrorKind, LimitExceededErrorData},
+};
+use serde::{Deserialize, Serialize};
+use tuwunel_core::{
+	Err, Error, Result, implement, info,
+	utils::hash::{password as hash_password, verify_password},
+	warn,
+};
+use tuwunel_database::{Deserialized, Json};
+
+/// Shortest password accepted; hashes make offline guessing slow, the limit
+/// below makes online guessing slow.
+pub const MIN_PASSWORD_LEN: usize = 6;
+
+/// Failed attempts allowed per user and room before a lockout.
+const MAX_FAILURES: u32 = 5;
+
+/// How long a user is locked out of a room after too many failures.
+const LOCKOUT: Duration = Duration::from_secs(15 * 60);
+
+#[derive(Default)]
+pub(super) struct Attempts(Mutex<HashMap<(OwnedRoomId, OwnedUserId), Failures>>);
+
+struct Failures {
+	count: u32,
+	since: Instant,
+}
+
+#[derive(Deserialize, Serialize)]
+struct Stored {
+	hash: String,
+	set_by: OwnedUserId,
+}
+
+/// Sets or, with `None`, removes the room's join password. Admins only.
+#[implement(super::Service)]
+pub async fn set_join_password(
+	&self,
+	sender: &UserId,
+	room_id: &RoomId,
+	password: Option<&str>,
+) -> Result {
+	self.check_can_change(sender, room_id).await?;
+
+	let Some(password) = password else {
+		self.roomid_joinpassword.remove(room_id);
+		info!(%room_id, %sender, "Join password removed");
+		return Ok(());
+	};
+
+	if password.chars().count() < MIN_PASSWORD_LEN {
+		return Err!(Request(InvalidParam(
+			"The password must be at least {MIN_PASSWORD_LEN} characters."
+		)));
+	}
+
+	let hash = hash_password(password, self.services.server.config.password_hash_cost())?;
+	let stored = Stored { hash: hash.to_string(), set_by: sender.to_owned() };
+	// Room IDs are raw keys: the key serializer refuses top-level strings.
+	self.roomid_joinpassword
+		.raw_put(room_id, Json(&stored));
+
+	info!(%room_id, %sender, "Join password set");
+	Ok(())
+}
+
+/// Whether the room has a join password. Admins only, so the setting does not
+/// leak to anyone who merely knows the room ID.
+#[implement(super::Service)]
+pub async fn has_join_password(&self, sender: &UserId, room_id: &RoomId) -> Result<bool> {
+	self.check_can_change(sender, room_id).await?;
+
+	Ok(self.stored_password(room_id).await.is_some())
+}
+
+/// Invites `user_id` into `room_id` when `password` matches.
+///
+/// Every failure, including a room without a password or that does not exist,
+/// answers the same way so the endpoint cannot be used to probe for rooms.
+#[implement(super::Service)]
+pub async fn join_with_password(
+	&self,
+	user_id: &UserId,
+	room_id: &RoomId,
+	password: &str,
+) -> Result {
+	self.check_not_locked_out(room_id, user_id)?;
+
+	let verified = self
+		.stored_password(room_id)
+		.await
+		.filter(|stored| verify_password(password, &stored.hash).is_ok());
+
+	let Some(stored) = verified else {
+		self.record_failure(room_id, user_id);
+		return Err!(Request(Forbidden("Wrong password or no such room.")));
+	};
+
+	self.clear_failures(room_id, user_id);
+
+	if self
+		.services
+		.state_cache
+		.is_joined(user_id, room_id)
+		.await
+	{
+		return Ok(());
+	}
+
+	let Some(inviter) = self.inviter(room_id, &stored.set_by).await else {
+		warn!(%room_id, "Join password matched but no member can invite");
+		return Err!(Request(Forbidden("Nobody in this room can invite you right now.")));
+	};
+
+	self.services
+		.membership
+		.invite(&inviter, user_id, room_id, None, false)
+		.await
+}
+
+#[implement(super::Service)]
+async fn stored_password(&self, room_id: &RoomId) -> Option<Stored> {
+	self.roomid_joinpassword
+		.get(room_id)
+		.await
+		.deserialized::<Json<Stored>>()
+		.map(|Json(stored)| stored)
+		.ok()
+}
+
+/// The admin who set the password while they still can invite, otherwise any
+/// joined local member who can.
+#[implement(super::Service)]
+async fn inviter(&self, room_id: &RoomId, set_by: &UserId) -> Option<OwnedUserId> {
+	let power_levels = self
+		.services
+		.state_accessor
+		.get_power_levels(room_id)
+		.await
+		.ok()?;
+
+	let can_invite = async |user: &UserId| {
+		self.services
+			.state_cache
+			.is_joined(user, room_id)
+			.await && power_levels.user_can_invite(user)
+	};
+
+	if self.services.globals.user_is_local(set_by) && can_invite(set_by).await {
+		return Some(set_by.to_owned());
+	}
+
+	let members: Vec<OwnedUserId> = self
+		.services
+		.state_cache
+		.local_users_in_room(room_id)
+		.map(ToOwned::to_owned)
+		.collect()
+		.await;
+
+	for member in members {
+		if can_invite(&member).await {
+			return Some(member);
+		}
+	}
+
+	None
+}
+
+#[implement(super::Service)]
+fn check_not_locked_out(&self, room_id: &RoomId, user_id: &UserId) -> Result {
+	let mut attempts = self.join_attempts.0.lock().expect("locked");
+	let key = (room_id.to_owned(), user_id.to_owned());
+	match attempts.get(&key) {
+		| Some(f) if f.since.elapsed() >= LOCKOUT => {
+			attempts.remove(&key);
+			Ok(())
+		},
+		| Some(f) if f.count >= MAX_FAILURES => Err(Error::Request(
+			ErrorKind::LimitExceeded(LimitExceededErrorData { retry_after: None }),
+			"Too many wrong passwords. Try again later.".into(),
+			StatusCode::TOO_MANY_REQUESTS,
+		)),
+		| _ => Ok(()),
+	}
+}
+
+#[implement(super::Service)]
+fn record_failure(&self, room_id: &RoomId, user_id: &UserId) {
+	let mut attempts = self.join_attempts.0.lock().expect("locked");
+	let entry = attempts
+		.entry((room_id.to_owned(), user_id.to_owned()))
+		.or_insert(Failures { count: 0, since: Instant::now() });
+	entry.count = entry.count.saturating_add(1);
+	entry.since = Instant::now();
+}
+
+#[implement(super::Service)]
+fn clear_failures(&self, room_id: &RoomId, user_id: &UserId) {
+	self.join_attempts
+		.0
+		.lock()
+		.expect("locked")
+		.remove(&(room_id.to_owned(), user_id.to_owned()));
+}
