+//! FreeChat: media of encrypted messages that clients report after sending.
+//!
+//! Element X encrypts attachments inside matrix-rust-sdk, so it cannot add the
+//! plaintext [`super::MEDIA_KEY`] list to the event. Once the message is sent
+//! it reports the MXCs it shows for it instead, and they are deleted when the
+//! message expires. Only the sender may report, only for a message carrying
+//! expiry markers, and only media that sender uploaded; nothing is recorded
+//! for messages that never expire.
+//!
+//! Rows are `(event_id, mxc) -> sender`. Rows whose event was removed some
+//! other way (the retention sweep, a room purge) are swept hourly, and their
+//! media deleted with them.
+
+use futures::StreamExt;
+use ruma::{EventId, Mxc, OwnedEventId, OwnedUserId, RoomId, UserId};
+use tuwunel_core::{Err, Result, debug_info, implement, matrix::event::Event};
+use tuwunel_database::Interfix;
+
+use super::{EXPIRES_AT_KEY, READ_TTL_KEY};
+
+/// Most MXCs one message may report: a gallery's files and thumbnails.
+pub const MAX_EVENT_MEDIA: usize = 64;
+
+/// Records the media of the caller's own disappearing message, returning how
+/// many MXCs were kept.
+///
+/// MXCs that are malformed, remote or uploaded by someone else are skipped.
+/// An event that is missing, in another room or sent by someone else is
+/// reported as not found.
+#[implement(super::Service)]
+pub async fn claim_event_media(
+	&self,
+	user: &UserId,
+	room_id: &RoomId,
+	event_id: &EventId,
+	mxcs: &[String],
+) -> Result<usize> {
+	if mxcs.len() > MAX_EVENT_MEDIA {
+		return Err!(Request(InvalidParam("Too many media IDs.")));
+	}
+
+	let Ok(pdu) = self.services.timeline.get_pdu(event_id).await else {
+		return Err!(Request(NotFound("Event not found.")));
+	};
+
+	if pdu.room_id() != room_id || pdu.sender() != user {
+		return Err!(Request(NotFound("Event not found.")));
+	}
+
+	let marked = pdu.get_unsigned_property::<u64>(EXPIRES_AT_KEY).is_ok()
+		|| pdu.get_unsigned_property::<u64>(READ_TTL_KEY).is_ok();
+	if !marked {
+		return Ok(0);
+	}
+
+	let mut kept = 0_usize;
+	for mxc in mxcs {
+		let Ok(parsed) = Mxc::try_from(mxc.as_str()) else {
+			continue;
+		};
+
+		if !self.services.globals.server_is_ours(parsed.server_name) {
+			continue;
+		}
+
+		let uploader = self
+			.services
+			.media
+			.media_entry(&parsed)
+			.await
+			.and_then(|entry| entry.user_id);
+
+		if uploader.as_deref() != Some(user) {
+			continue;
+		}
+
+		self.eventid_media
+			.put_raw((event_id, mxc.as_str()), user.as_bytes());
+		kept = kept.saturating_add(1);
+	}
+
+	Ok(kept)
+}
+
+/// Removes and returns the media recorded for `event_id`.
+#[implement(super::Service)]
+pub(super) async fn take_event_media(&self, event_id: &EventId) -> Vec<String> {
+	let prefix = (event_id, Interfix);
+	let mxcs: Vec<String> = self
+		.eventid_media
+		.keys_prefix::<(&EventId, &str), _>(&prefix)
+		.filter_map(async |key| key.ok().map(|(_, mxc)| mxc.to_owned()))
+		.collect()
+		.await;
+
+	for mxc in &mxcs {
+		self.eventid_media.del((event_id, mxc.as_str()));
+	}
+
+	mxcs
+}
+
+/// Deletes the media of recorded events that no longer exist.
+#[implement(super::Service)]
+pub(super) async fn sweep_event_media(&self) {
+	let rows: Vec<(OwnedEventId, String, OwnedUserId)> = self
+		.eventid_media
+		.stream::<(&EventId, &str), &str>()
+		.filter_map(async |row| {
+			let ((event_id, mxc), sender) = row.ok()?;
+			Some((event_id.to_owned(), mxc.to_owned(), UserId::parse(sender).ok()?))
+		})
+		.collect()
+		.await;
+
+	let mut swept = 0_usize;
+	for (event_id, mxc, sender) in rows {
+		if self.services.timeline.get_pdu_id(&event_id).await.is_ok() {
+			continue;
+		}
+
+		self.delete_media(&mxc, &sender).await;
+		self.eventid_media.del((&*event_id, mxc.as_str()));
+		swept = swept.saturating_add(1);
+	}
+
+	if swept > 0 {
+		debug_info!(swept, "Deleted media of messages removed elsewhere");
+	}
+}
