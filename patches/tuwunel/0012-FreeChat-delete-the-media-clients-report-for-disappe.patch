+/// `POST /_matrix/client/unstable/com.freechat/rooms/{roomId}/event_media`
+///
+/// Records the media of the caller's own disappearing message, for clients
+/// that cannot list it in the event's plaintext, so it is deleted with the
+/// message. Ignored for messages that never expire.
+pub(crate) async fn event_media_route(
+	State(services): State<crate::State>,
+	TypedHeader(Authorization(bearer)): TypedHeader<Authorization<Bearer>>,
+	Path(room_id): Path<OwnedRoomId>,
+	Json(body): Json<EventMedia>,
+) -> Result<impl IntoResponse> {
+	let user = authenticate(&services, bearer.token()).await?;
+	let kept = services
+		.disappearing
+		.claim_event_media(&user, &room_id, &body.event_id, &body.mxcs)
+		.await?;
+
+	Ok(Json(json!({ "kept": kept })))
+}
