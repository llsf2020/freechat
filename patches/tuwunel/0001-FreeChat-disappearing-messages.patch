--- /dev/null
+++ b/src/service/rooms/disappearing/tests.rs
@@ -0,0 +1,58 @@
+use ruma::CanonicalJsonObject;
+use serde_json::json;
+
+use super::{Content, content_mxcs};
+
+fn object(value: serde_json::Value) -> CanonicalJsonObject {
+	serde_json::from_value(value).expect("valid canonical object")
+}
+
+#[test]
+fn plain_image_with_thumbnail() {
+	let content = object(json!({
+		"msgtype": "m.image",
+		"body": "a.png",
+		"url": "mxc://example.org/main",
+		"info": { "thumbnail_url": "mxc://example.org/thumb" },
+	}));
+
+	assert_eq!(content_mxcs(&content), ["mxc://example.org/main", "mxc://example.org/thumb"]);
+}
+
+#[test]
+fn encrypted_file_fields() {
+	let content = object(json!({
+		"msgtype": "m.file",
+		"file": { "url": "mxc://example.org/file" },
+		"info": { "thumbnail_file": { "url": "mxc://example.org/thumbfile" } },
+	}));
+
+	assert_eq!(content_mxcs(&content), ["mxc://example.org/file", "mxc://example.org/thumbfile"]);
+}
+
+#[test]
+fn plaintext_hint_on_encrypted_event() {
+	let content = object(json!({
+		"algorithm": "m.megolm.v1.aes-sha2",
+		"ciphertext": "AAAA",
+		"com.freechat.media": ["mxc://example.org/a", "mxc://example.org/a", 42, "https://x"],
+	}));
+
+	assert_eq!(content_mxcs(&content), ["mxc://example.org/a"]);
+}
+
+#[test]
+fn no_media() {
+	let content = object(json!({ "msgtype": "m.text", "body": "hi" }));
+
+	assert!(content_mxcs(&content).is_empty());
+}
+
+#[test]
+fn ttl_content_defaults_to_disabled() {
+	let content: Content = serde_json::from_value(json!({})).unwrap();
+	assert_eq!(content.ttl, 0);
+
+	let content: Content = serde_json::from_value(json!({ "ttl": 3600 })).unwrap();
+	assert_eq!(content.ttl, 3600);
+}
