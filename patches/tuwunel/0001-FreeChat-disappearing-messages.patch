+//! FreeChat: disappearing messages.
+//!
+//! A room opts in by setting the `com.freechat.disappearing` state event
+//! (state key `""`) with content `{"ttl": <seconds>}`; a missing event or a
+//! `ttl` of zero disables the feature. The TTL in effect when a message is
+//! appended applies to that message, so changing it never shortens or extends
+//! messages already sent.
+//!
+//! When a message expires the server redacts it as its original sender, which
+//! every client applies to its local store, then deletes the media it
+//! referenced. Clients may list media MXCs under `com.freechat.media` in the
+//! plaintext content of encrypted events so it can be found and removed.
+
+#[cfg(test)]
+mod tests;
+
+use std::{sync::Arc, time::Duration};
+
+use async_trait::async_trait;
+use futures::{StreamExt, TryStreamExt};
+use ruma::{
+	CanonicalJsonObject, CanonicalJsonValue, EventId, Mxc, OwnedEventId, OwnedUserId, UserId,
+	events::{StateEventType, TimelineEventType},
+};
+use serde::Deserialize;
+use serde_json::{json, value::to_raw_value};
+use tuwunel_core::{
+	Result, debug, debug_info, implement,
+	matrix::{
+		event::Event,
+		pdu::{PduBuilder, PduEvent},
+	},
+	utils::{ReadyExt, time::now},
+	warn,
+};
+use tuwunel_database::Map;
+
+/// State event type that configures a room's disappearing-message TTL.
+pub const STATE_TYPE: &str = "com.freechat.disappearing";
+
+/// Plaintext content key on which clients list media MXCs of an event.
+pub const MEDIA_KEY: &str = "com.freechat.media";
+
+/// Content key marking a redaction issued by this service, so clients can
+/// hide the event entirely instead of showing a "message deleted" notice.
+pub const EXPIRED_KEY: &str = "com.freechat.expired";
+
+/// How often the worker checks for expired messages.
+const INTERVAL: Duration = Duration::from_secs(5);
+
+pub struct Service {
+	services: Arc<crate::services::OnceServices>,
+	expiresat_eventid: Arc<Map>,
+}
+
+#[derive(Clone, Copy, Debug, Default, Deserialize)]
+pub struct Content {
+	#[serde(default)]
+	pub ttl: u64,
+}
+
+#[async_trait]
+impl crate::Service for Service {
+	fn build(args: &crate::Args<'_>) -> Result<Arc<Self>> {
+		Ok(Arc::new(Self {
+			services: args.services.clone(),
+			expiresat_eventid: args.db["expiresat_eventid"].clone(),
+		}))
+	}
+
+	async fn worker(self: Arc<Self>) -> Result {
+		loop {
+			if let Err(e) = self.expire_due().await {
+				warn!("Disappearing messages sweep failed: {e}");
+			}
+
+			tokio::select! {
+				() = tokio::time::sleep(INTERVAL) => {},
+				() = self.services.server.until_shutdown() => return Ok(())
+			};
+		}
+	}
+
+	fn name(&self) -> &str { crate::service::make_name(std::module_path!()) }
+}
+
+/// Schedules a freshly appended event for expiry if its room has a TTL set.
+///
+/// Called from the timeline append path while the room's state lock is held.
+#[implement(Service)]
+pub async fn schedule(&self, pdu: &PduEvent) {
+	if !is_expirable(pdu) {
+		return;
+	}
+
+	let ttl = self.room_ttl(pdu.room_id()).await;
+	if ttl == 0 {
+		return;
+	}
+
+	let sent_secs = u64::from(pdu.origin_server_ts().as_secs());
+	let expires_at = sent_secs.saturating_add(ttl);
+
+	self.expiresat_eventid
+		.put_raw((expires_at, pdu.event_id()), []);
+}
+
+/// Returns the room's current TTL in seconds, zero when disabled.
+#[implement(Service)]
+pub async fn room_ttl(&self, room_id: &ruma::RoomId) -> u64 {
+	self.services
+		.state_accessor
+		.room_state_get_content::<Content>(room_id, &StateEventType::from(STATE_TYPE), "")
+		.await
+		.map(|content| content.ttl)
+		.unwrap_or(0)
+}
+
+/// Redacts every scheduled event whose expiry time has passed.
+#[implement(Service)]
+async fn expire_due(&self) -> Result {
+	let now = now().as_secs();
+	let due: Vec<(u64, OwnedEventId)> = self
+		.expiresat_eventid
+		.keys::<(u64, &EventId)>()
+		.ready_take_while(|res| res.as_ref().is_ok_and(|(at, _)| *at <= now))
+		.map_ok(|(at, event_id)| (at, event_id.to_owned()))
+		.try_collect()
+		.await?;
+
+	if due.is_empty() {
+		return Ok(());
+	}
+
+	debug_info!(count = due.len(), "Expiring disappearing messages");
+
+	for (at, event_id) in due {
+		if let Err(e) = self.expire(&event_id).await {
+			warn!(%event_id, "Failed to expire disappearing message: {e}");
+		}
+
+		self.expiresat_eventid.del((at, &*event_id));
+	}
+
+	Ok(())
+}
+
+/// Redacts one expired event and deletes the media it referenced.
+#[implement(Service)]
+async fn expire(&self, event_id: &EventId) -> Result {
+	let Ok(pdu) = self.services.timeline.get_pdu(event_id).await else {
+		debug!(%event_id, "Expired event no longer exists");
+		return Ok(());
+	};
+
+	if pdu.is_redacted() {
+		return Ok(());
+	}
+
+	// Collect media before redaction strips the content.
+	let mxcs = media_mxcs(&pdu);
+
+	let room_id = pdu.room_id();
+	let Some(redactor) = self.redactor(&pdu).await else {
+		warn!(%event_id, %room_id, "No local member can redact expired message");
+		return Ok(());
+	};
+
+	let content = to_raw_value(&json!({
+		"redacts": event_id,
+		EXPIRED_KEY: true,
+	}))?;
+
+	let state_lock = self.services.state.mutex.lock(room_id).await;
+	self.services
+		.timeline
+		.build_and_append_pdu(
+			PduBuilder {
+				event_type: TimelineEventType::RoomRedaction,
+				content: content.into(),
+				redacts: Some(event_id.to_owned()),
+				..PduBuilder::default()
+			},
+			&redactor,
+			room_id,
+			&state_lock,
+		)
+		.await?;
+	drop(state_lock);
+
+	for mxc in mxcs {
+		self.delete_media(&mxc, pdu.sender()).await;
+	}
+
+	Ok(())
+}
+
+/// Picks the user to issue the redaction: the original sender while they are
+/// still joined, otherwise any joined local user allowed to redact it.
+#[implement(Service)]
+async fn redactor(&self, pdu: &PduEvent) -> Option<OwnedUserId> {
+	let room_id = pdu.room_id();
+	let event_id = pdu.event_id();
+	let can_redact = async |user: &UserId| {
+		self.services
+			.state_cache
+			.is_joined(user, room_id)
+			.await && self
+			.services
+			.state_accessor
+			.user_can_redact(event_id, user, room_id, false)
+			.await
+			.unwrap_or(false)
+	};
+
+	if self.services.globals.user_is_local(pdu.sender()) && can_redact(pdu.sender()).await {
+		return Some(pdu.sender().to_owned());
+	}
+
+	let members: Vec<OwnedUserId> = self
+		.services
+		.state_cache
+		.local_users_in_room(room_id)
+		.map(ToOwned::to_owned)
+		.collect()
+		.await;
+
+	for user in members {
+		if can_redact(&user).await {
+			return Some(user);
+		}
+	}
+
+	None
+}
+
+/// Deletes media only when it was uploaded by the message's sender, so an
+/// event cannot be used to remove someone else's file.
+#[implement(Service)]
+async fn delete_media(&self, mxc: &str, sender: &UserId) {
+	let Ok(parsed) = Mxc::try_from(mxc) else {
+		return;
+	};
+
+	let uploader = self
+		.services
+		.media
+		.media_entry(&parsed)
+		.await
+		.and_then(|entry| entry.user_id);
+
+	if uploader.as_deref() != Some(sender) {
+		debug!(%mxc, "Skipping media not uploaded by the sender");
+		return;
+	}
+
+	if let Err(e) = self.services.media.delete(&parsed).await {
+		debug!(%mxc, "Failed to delete expired media: {e}");
+	}
+}
+
+/// Message-like events expire; state events and redactions do not.
+fn is_expirable(pdu: &PduEvent) -> bool {
+	pdu.state_key().is_none() && *pdu.kind() != TimelineEventType::RoomRedaction
+}
+
+fn media_mxcs(pdu: &PduEvent) -> Vec<String> {
+	pdu.get_content::<CanonicalJsonObject>()
+		.map(|content| content_mxcs(&content))
+		.unwrap_or_default()
+}
+
+/// MXC URIs referenced by an event's content, including the FreeChat
+/// plaintext list used for encrypted events.
+fn content_mxcs(content: &CanonicalJsonObject) -> Vec<String> {
+	let str_at = |obj: &CanonicalJsonObject, path: &[&str]| -> Option<String> {
+		let (last, parents) = path.split_last()?;
+		let mut cur = obj;
+		for key in parents {
+			cur = cur.get(*key)?.as_object()?;
+		}
+
+		cur.get(*last)?.as_str().map(ToOwned::to_owned)
+	};
+
+	let mut mxcs: Vec<String> = [
+		&["url"][..],
+		&["file", "url"],
+		&["info", "thumbnail_url"],
+		&["info", "thumbnail_file", "url"],
+	]
+	.into_iter()
+	.filter_map(|path| str_at(content, path))
+	.collect();
+
+	if let Some(CanonicalJsonValue::Array(list)) = content.get(MEDIA_KEY) {
+		mxcs.extend(
+			list.iter()
+				.filter_map(CanonicalJsonValue::as_str)
+				.map(ToOwned::to_owned),
+		);
+	}
+
+	mxcs.retain(|mxc| mxc.starts_with("mxc://"));
+	mxcs.sort();
+	mxcs.dedup();
+	mxcs
+}
