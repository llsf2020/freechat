diff --git a/src/service/rooms/disappearing/read_burn.rs b/src/service/rooms/disappearing/read_burn.rs
new file mode 100644
index 000000000..01e0a4e9d
--- /dev/null
+++ b/src/service/rooms/disappearing/read_burn.rs
@@ -0,0 +1,225 @@
+//! FreeChat: burn your own messages once they have been read.
+//!
+//! A user sets `com.freechat.disappearing` account data with content
+//! `{"read_ttl": <seconds>}`: globally as their default, and in a room to
+//! override it there (`"read_ttl": 0` turns it off in that room; content
+//! without `read_ttl` follows the global default).
+//!
+//! Each message sent while it is on waits in `readburn_pending` until every
+//! other joined member has read it, meaning their read receipt or private read
+//! marker reached it or a later event. It then expires `read_ttl` seconds
+//! later through the regular expiry index. Read positions are tracked in
+//! `readburn_readpos` from the moment this feature saw them.
+
+use futures::StreamExt;
+use ruma::{
+	EventId, OwnedUserId, RoomId, UserId,
+	events::receipt::{ReceiptEvent, ReceiptType},
+};
+use serde::Deserialize;
+use tuwunel_core::{
+	debug, implement,
+	matrix::{
+		event::Event,
+		pdu::{PduCount, PduEvent, PduId, RawPduId},
+	},
+	utils::{ReadyExt, time::now},
+};
+use tuwunel_database::{Deserialized, Interfix};
+
+use super::STATE_TYPE;
+
+#[derive(Deserialize)]
+struct AccountDataEvent {
+	#[serde(default)]
+	content: Personal,
+}
+
+#[derive(Default, Deserialize)]
+struct Personal {
+	read_ttl: Option<u64>,
+}
+
+/// The sender's effective read-burn delay in seconds, zero when off.
+#[implement(super::Service)]
+pub async fn personal_read_ttl(&self, room_id: &RoomId, user_id: &UserId) -> u64 {
+	match self.read_ttl_setting(Some(room_id), user_id).await {
+		| Some(ttl) => ttl,
+		| None => self
+			.read_ttl_setting(None, user_id)
+			.await
+			.unwrap_or(0),
+	}
+}
+
+/// The `read_ttl` stored in room (or global, when `room_id` is none) account
+/// data, if that data sets one.
+#[implement(super::Service)]
+async fn read_ttl_setting(&self, room_id: Option<&RoomId>, user_id: &UserId) -> Option<u64> {
+	self.services
+		.account_data
+		.get_raw(room_id, user_id, STATE_TYPE)
+		.await
+		.deserialized::<AccountDataEvent>()
+		.ok()
+		.and_then(|event| event.content.read_ttl)
+}
+
+/// Queues a freshly appended local message for burning after read.
+#[implement(super::Service)]
+pub(super) async fn schedule_read_burn(&self, pdu: &PduEvent) {
+	if !self.services.globals.user_is_local(pdu.sender()) {
+		return;
+	}
+
+	let ttl = self
+		.personal_read_ttl(pdu.room_id(), pdu.sender())
+		.await;
+	if ttl == 0 {
+		return;
+	}
+
+	let Some(PduId { shortroomid, count: PduCount::Normal(count) }) =
+		self.pdu_id(pdu.event_id()).await
+	else {
+		return;
+	};
+
+	self.readburn_pending
+		.put((shortroomid, count), ttl);
+}
+
+/// Records that `user_id` has read up to the event at `count` in `room_id`.
+#[implement(super::Service)]
+pub async fn note_read(&self, room_id: &RoomId, user_id: &UserId, count: u64) {
+	if count <= self.read_position(room_id, user_id).await {
+		return;
+	}
+
+	self.readburn_readpos
+		.put((room_id, user_id), count);
+
+	self.release_read(room_id, count).await;
+}
+
+/// Records the reads carried by a public receipt from `user_id`.
+#[implement(super::Service)]
+pub async fn note_receipt(&self, user_id: &UserId, room_id: &RoomId, receipt: &ReceiptEvent) {
+	for (event_id, receipts) in &receipt.content.0 {
+		let by_user = [ReceiptType::Read, ReceiptType::ReadPrivate]
+			.iter()
+			.filter_map(|kind| receipts.get(kind))
+			.any(|users| users.contains_key(user_id));
+
+		if by_user {
+			self.note_read_event(room_id, user_id, event_id)
+				.await;
+		}
+	}
+}
+
+#[implement(super::Service)]
+async fn note_read_event(&self, room_id: &RoomId, user_id: &UserId, event_id: &EventId) {
+	let Ok(shortroomid) = self.services.short.get_shortroomid(room_id).await else {
+		return;
+	};
+
+	if let Some(PduId { shortroomid: event_room, count: PduCount::Normal(count) }) =
+		self.pdu_id(event_id).await
+		&& event_room == shortroomid
+	{
+		self.note_read(room_id, user_id, count).await;
+	}
+}
+
+/// Starts the countdown for every pending message up to `up_to` that all
+/// other joined members have now read.
+#[implement(super::Service)]
+async fn release_read(&self, room_id: &RoomId, up_to: u64) {
+	let Ok(shortroomid) = self.services.short.get_shortroomid(room_id).await else {
+		return;
+	};
+
+	let pending: Vec<((u64, u64), u64)> = self
+		.readburn_pending
+		.stream_prefix(&(shortroomid, Interfix))
+		.ready_filter_map(Result::ok)
+		.collect()
+		.await;
+
+	let pending: Vec<(u64, u64)> = pending
+		.into_iter()
+		.filter(|&((_, count), _)| count <= up_to)
+		.map(|((_, count), ttl)| (count, ttl))
+		.collect();
+
+	if pending.is_empty() {
+		return;
+	}
+
+	let members: Vec<OwnedUserId> = self
+		.services
+		.state_cache
+		.room_members(room_id)
+		.map(ToOwned::to_owned)
+		.collect()
+		.await;
+
+	for (count, ttl) in pending {
+		let pdu_id: RawPduId = PduId { shortroomid, count: PduCount::Normal(count) }.into();
+		let Ok(pdu) = self.services.timeline.get_pdu_from_id(&pdu_id).await else {
+			self.readburn_pending.del((shortroomid, count));
+			continue;
+		};
+
+		if self.read_by_all_others(room_id, &members, pdu.sender(), count).await {
+			debug!(event_id = %pdu.event_id(), ttl, "Read by everyone; burning after delay");
+			self.expire_at(now().as_secs().saturating_add(ttl), pdu.event_id());
+			self.readburn_pending.del((shortroomid, count));
+		}
+	}
+}
+
+/// Whether every member except `sender` has read up to `count`. False when
+/// nobody else is in the room yet.
+#[implement(super::Service)]
+async fn read_by_all_others(
+	&self,
+	room_id: &RoomId,
+	members: &[OwnedUserId],
+	sender: &UserId,
+	count: u64,
+) -> bool {
+	let mut anyone_else = false;
+	for member in members {
+		if member == sender {
+			continue;
+		}
+
+		anyone_else = true;
+		if self.read_position(room_id, member).await < count {
+			return false;
+		}
+	}
+
+	anyone_else
+}
+
+#[implement(super::Service)]
+async fn read_position(&self, room_id: &RoomId, user_id: &UserId) -> u64 {
+	self.readburn_readpos
+		.qry(&(room_id, user_id))
+		.await
+		.deserialized()
+		.unwrap_or(0)
+}
+
+#[implement(super::Service)]
+async fn pdu_id(&self, event_id: &EventId) -> Option<PduId> {
+	self.services
+		.timeline
+		.get_pdu_id(event_id)
+		.await
+		.ok()
+		.map(PduId::from)
+}
