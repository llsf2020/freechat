-		key.push(0xFF);
-		key.extend_from_slice(pdu_id.as_ref()); // TODO: currently we save the room id a second time here
-		key
-	});
-
-	for token in batch {
-		if self.db.tokenids.exists_blocking(&token).is_ok() {
-			self.db.tokenids.remove(&token);
-		}
-	}
+	let _ = (self, shortroomid, pdu_id, message_body);
 }
 
