--- /dev/null
+++ b/src/service/migrations/freechat_clear_search_index.rs
@@ -0,0 +1,23 @@
+use tuwunel_core::{Result, warn};
+
+use crate::Services;
+
+pub(super) const MARKER: &str = "freechat_clear_search_index";
+
+/// FreeChat: empties the full-text search index once.
+///
+/// Nothing has been indexed since FreeChat dropped server-side search (see
+/// `rooms::search::index_pdu`), but a database from an earlier build may still
+/// hold the words of plaintext messages here. Clearing it lets deindexing skip
+/// the per-word lookups, and the compaction afterwards drops those words from
+/// the database files too.
+pub(super) async fn clear_search_index(services: &Services) -> Result {
+	let db = &services.db;
+	let tokenids = db["tokenids"].clone();
+
+	warn!("Clearing the full-text search index");
+	tokenids.clear().await;
+
+	db["global"].insert(MARKER, []);
+	tokenids.sort()
+}
