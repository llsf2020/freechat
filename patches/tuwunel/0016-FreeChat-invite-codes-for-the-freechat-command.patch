+
+// Registration invites for the `freechat` command on the server, under `/_freechat/admin/`. Caddy only proxies
+// `/_matrix/` to the internet, and these routes only answer requests carrying the `FREECHAT_ADMIN_SECRET` the
+// installer generated; without it set they refuse everything.
+
+/// Longest an invite may stay valid: a year.
+const MAX_INVITE_AGE: Duration = Duration::from_secs(366 * 24 * 3600);
+
+#[derive(Deserialize)]
+pub(crate) struct IssueInvite {
+	/// How many accounts it may create; absent means any number until it expires.
+	#[serde(default)]
+	max_uses: Option<u64>,
+	/// Seconds until it expires; absent means it does not expire by time.
+	#[serde(default)]
+	max_age_secs: Option<u64>,
+}
+
+/// `POST /_freechat/admin/invites`
+///
+/// Issues a registration token limited in uses and/or time. Answers with the token on the first line and a
+/// description of its limits on the second, as plain text for the shell.
+pub(crate) async fn issue_invite_route(
+	State(services): State<crate::State>,
+	TypedHeader(Authorization(bearer)): TypedHeader<Authorization<Bearer>>,
+	Json(body): Json<IssueInvite>,
+) -> Result<String> {
+	check_admin_secret(bearer.token())?;
+	if body.max_uses == Some(0) {
+		return Err!(Request(InvalidParam("max_uses must be at least 1")));
+	}
+	let max_age = match body.max_age_secs {
+		| None => None,
+		| Some(secs) if secs == 0 || Duration::from_secs(secs) > MAX_INVITE_AGE =>
+			return Err!(Request(InvalidParam("max_age_secs must be between 1 and a year"))),
+		| Some(secs) => SystemTime::now().checked_add(Duration::from_secs(secs)),
+	};
+	let expires = TokenExpires { max_uses: body.max_uses, max_age };
+	let (token, info) = services
+		.registration_tokens
+		.create_token(None, None, expires)
+		.await?;
+
+	Ok(format!("{token}\n{info}\n"))
+}
+
+/// `GET /_freechat/admin/invites`
+///
+/// Lists the invites that can still be used, one per line: the token, then its uses and limits. The
+/// registration token of the configuration file is left out.
+pub(crate) async fn list_invites_route(
+	State(services): State<crate::State>,
+	TypedHeader(Authorization(bearer)): TypedHeader<Authorization<Bearer>>,
+) -> Result<String> {
+	check_admin_secret(bearer.token())?;
+	let tokens: Vec<_> = services
+		.registration_tokens
+		.iterate_tokens()
+		.await
+		.collect()
+		.await;
+
+	Ok(tokens
+		.into_iter()
+		.filter_map(|valid| match valid.info {
+			| TokenInfo::Config => None,
+			| TokenInfo::Database(info) => Some(format!("{}  {info}\n", valid.token)),
+		})
+		.collect())
+}
+
+/// `DELETE /_freechat/admin/invites/{token}`
+///
+/// Revokes an invite so it can no longer create accounts. Accounts it created stay.
+pub(crate) async fn revoke_invite_route(
+	State(services): State<crate::State>,
+	TypedHeader(Authorization(bearer)): TypedHeader<Authorization<Bearer>>,
+	Path(token): Path<String>,
+) -> Result<String> {
+	check_admin_secret(bearer.token())?;
+	if matches!(services.registration_tokens.get_token_info(&token).await, Ok(TokenInfo::Config)) {
+		return Err!(Request(Forbidden("The registration token of the configuration file is not an invite")));
+	}
+	services
+		.registration_tokens
+		.revoke_token(&token)
+		.await?;
+
+	Ok(String::from("revoked\n"))
+}
+
+fn check_admin_secret(given: &str) -> Result {
+	let expected = std::env::var("FREECHAT_ADMIN_SECRET").unwrap_or_default();
+	// A missing or short secret must not let an empty or guessed one in.
+	if expected.len() < 32 || !constant_time_eq(expected.as_bytes(), given.as_bytes()) {
+		return Err!(Request(Forbidden("Not allowed.")));
+	}
+
+	Ok(())
+}
+
+/// Equal-length inputs take the same time whatever they hold; only the length can show.
+fn constant_time_eq(a: &[u8], b: &[u8]) -> bool {
+	a.len() == b.len() && a.iter().zip(b).fold(0_u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
+
+#[cfg(test)]
+mod tests {
+	use super::constant_time_eq;
+
+	#[test]
+	fn admin_secret_comparison() {
+		assert!(constant_time_eq(b"secret", b"secret"));
+		assert!(!constant_time_eq(b"secret", b"secreT"));
+		assert!(!constant_time_eq(b"secret", b"secret2"));
+		assert!(!constant_time_eq(b"secret", b""));
+	}
+}
