 src/service/rooms/disappearing/read_burn.rs   | 10 ++--------
 src/service/rooms/search/mod.rs               |  2 +-
 src/service/rooms/timeline/append.rs          |  2 +-
 6 files changed, 10 insertions(+), 22 deletions(-)

