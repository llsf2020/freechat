+
+#[test]
+fn expiry_takes_the_earlier_of_room_ttl_and_server_cap() {
+	assert_eq!(effective_ttl(0, 0), None);
+	assert_eq!(effective_ttl(60, 0), Some(60));
+	assert_eq!(effective_ttl(0, 3600), Some(3600));
+	assert_eq!(effective_ttl(60, 3600), Some(60));
+	assert_eq!(effective_ttl(7200, 3600), Some(3600));
+}
