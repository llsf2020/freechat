+/// FreeChat: rounds a timestamp down to the start of its UTC day.
+fn freechat_day(ts: MilliSecondsSinceUnixEpoch) -> MilliSecondsSinceUnixEpoch {
+	const DAY_MS: u64 = 24 * 60 * 60 * 1000;
+	let ms = u64::from(ts.get());
+	MilliSecondsSinceUnixEpoch(ruma::UInt::new_saturating(ms - ms % DAY_MS))
+}
