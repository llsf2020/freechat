+++ b/src/service/rooms/disappearing/scrub.rs
@@ -0,0 +1,94 @@
+//! FreeChat: make deleted messages unrecoverable from the database files.
+//!
+//! Deleting a key in RocksDB only writes a tombstone: the old value stays in
+//! the write-ahead log and the table files until a compaction rewrites them.
+//! After messages are purged, all memtables are flushed (so the write-ahead log
+//! holding them is dropped) and the maps holding events are compacted all the
+//! way down, at most once a day, so expired messages do not linger on disk.
+
+use std::{
+	sync::{
+		Arc, Mutex,
+		atomic::{AtomicBool, Ordering},
+	},
+	time::{Duration, Instant},
+};
+
+use tuwunel_core::{implement, info, warn};
+use tuwunel_database::{Map, compact::Options};
+
+/// Maps that hold event content or the words of plaintext messages.
+const SCRUBBED_MAPS: &[&str] = &["pduid_pdu", "eventid_pduid", "eventid_outlierpdu", "tokenids"];
+
+pub(super) struct Scrub {
+	maps: Vec<Arc<Map>>,
+	pending: AtomicBool,
+	last: Mutex<Instant>,
+}
+
+impl Scrub {
+	pub(super) fn new(map: impl Fn(&str) -> Arc<Map>) -> Self {
+		let interval = interval();
+		Self {
+			maps: SCRUBBED_MAPS.iter().map(|name| map(name)).collect(),
+			pending: AtomicBool::new(false),
+			// The first scrub runs an hour after start-up rather than slowing the start.
+			last: Mutex::new(
+				Instant::now()
+					.checked_sub(interval.saturating_sub(Duration::from_secs(3600).min(interval)))
+					.unwrap_or_else(Instant::now),
+			),
+		}
+	}
+
+	/// Notes that messages were purged and the maps need scrubbing.
+	pub(super) fn mark(&self) { self.pending.store(true, Ordering::Relaxed); }
+}
+
+/// How often at most to scrub; `FREECHAT_SCRUB_INTERVAL_SECS` shortens it for tests.
+fn interval() -> Duration {
+	std::env::var("FREECHAT_SCRUB_INTERVAL_SECS")
+		.ok()
+		.and_then(|secs| secs.trim().parse().ok())
+		.map_or(Duration::from_secs(24 * 60 * 60), Duration::from_secs)
+}
+
+/// Compacts the event maps when messages were purged since the last scrub and
+/// the interval has passed.
+#[implement(super::Service)]
+pub(super) async fn scrub_if_due(&self) {
+	let scrub = &self.scrub;
+	{
+		let mut last = scrub.last.lock().expect("locked");
+		if !scrub.pending.load(Ordering::Relaxed) || last.elapsed() < interval() {
+			return;
+		}
+		*last = Instant::now();
+	}
+	scrub.pending.store(false, Ordering::Relaxed);
+
+	let runtime = self.services.server.runtime().clone();
+
+	// The write-ahead log holds every map's recent writes and is only dropped once
+	// all memtables are flushed, so flush them all before compacting.
+	let engine = self.services.db.engine.clone();
+	match runtime.spawn_blocking(move || engine.sort()).await {
+		| Ok(Ok(())) => {},
+		| Ok(Err(e)) => warn!("Flushing before scrubbing failed: {e}"),
+		| Err(e) => warn!("Flushing before scrubbing panicked: {e}"),
+	}
+
+	for map in &scrub.maps {
+		let map = map.clone();
+		let options = Options { exhaustive: true, ..Options::default() };
+		match runtime
+			.spawn_blocking(move || map.compact_blocking(options))
+			.await
+		{
+			| Ok(Ok(())) => {},
+			| Ok(Err(e)) => warn!("Scrubbing deleted messages failed: {e}"),
+			| Err(e) => warn!("Scrubbing deleted messages panicked: {e}"),
+		}
+	}
+	info!("Scrubbed deleted messages from the database files");
+}
