From: sjcsf <346224915+llsf2020@users.noreply.github.com>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH 10/15] FreeChat: strict-mode devices remove themselves when
 idle

A device with ID FCS<minutes>_<random> is deleted once its token has not been
used for that long (plus a minute). Last use is tracked in memory only.
---
 src/api/router/auth.rs                        |  10 +-
 src/service/rooms/disappearing/mod.rs         |   6 ++
 .../rooms/disappearing/strict_device.rs       | 100 ++++++++++++++++++
 src/service/rooms/disappearing/tests.rs       |  19 ++++
 src/service/users/device.rs                   |   5 +
 5 files changed, 139 insertions(+), 1 deletion(-)
 create mode 100644 src/service/rooms/disappearing/strict_device.rs

diff --git a/src/api/router/auth.rs b/src/api/router/auth.rs
index 6b74dd5a1..f45d480bb 100644
--- a/src/api/router/auth.rs
+++ b/src/api/router/auth.rs
@@ -188,7 +188,15 @@ async fn find_token(services: &Services, token: Option<&str>) -> Result<Token> {
 	pin_mut!(user_token, appservice_token);
 	match select_ok([user_token.left_future(), appservice_token.right_future()]).await {
 		| Err(e) if !e.is_not_found() => Err(e),
-		| Ok((token, _)) => Ok(token),
+		| Ok((token, _)) => {
+			// FreeChat strict mode: keep idle strict devices from being removed.
+			if let Token::User((user_id, device_id, _)) = &token {
+				services
+					.disappearing
+					.note_device_use(user_id, device_id);
+			}
+			Ok(token)
+		},
 		| _ => Ok(Token::Invalid),
 	}
 }
