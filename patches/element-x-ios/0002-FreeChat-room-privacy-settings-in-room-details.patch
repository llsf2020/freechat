+/// FreeChat-only strings, kept out of the upstream Localizable files so syncing translations never conflicts.
+nonisolated enum FreeChatStrings {
+    enum Key: String {
+        case section, autoDelete, autoDeleteFooter, burn, burnFollowDefault, burnFooter, off
+        case blockScreenshots, blockScreenshotsFooter, joinPassword, joinPasswordSet, joinPasswordNotSet
+        case setPassword, removePassword, passwordPlaceholder, passwordTooShort, save, cancel, error
+        case joinWithPassword, joinWithPasswordMessage, wrongPassword, lockedOut
+        case burnDefault, alwaysBlockScreenshots, alwaysBlockScreenshotsFooter
+        case strictSection, strictTitle, strictFooter, strictOn, strictOffPending, strictIdle
+        case strictConfirmTitle, strictConfirmMessage, strictConfirmButton, strictTurnOff
+        case screenshotTaken, screenshotTakenMessage, screenHidden
+    }
+
+    static func string(_ key: Key) -> String {
+        table[key] ?? english[key] ?? key.rawValue
+    }
+
+    /// A duration in seconds as the largest whole unit, e.g. "5 minutes".
+    static func duration(_ seconds: UInt64) -> String {
+        guard seconds > 0 else { return string(.off) }
+        let (count, unit): (UInt64, TimeUnit) = switch seconds {
+        case let s where s % 86400 == 0: (s / 86400, .day)
+        case let s where s % 3600 == 0: (s / 3600, .hour)
+        case let s where s % 60 == 0: (s / 60, .minute)
+        default: (seconds, .second)
+        }
+        return unit.format(count, language: language)
+    }
+
+    // MARK: - Private
+
+    private enum Language { case english, simplified, traditional }
+
+    private enum TimeUnit {
+        case second, minute, hour, day
+
+        func format(_ count: UInt64, language: Language) -> String {
+            switch language {
+            case .simplified: "\(count) " + ["秒", "分钟", "小时", "天"][index]
+            case .traditional: "\(count) " + ["秒", "分鐘", "小時", "天"][index]
+            case .english: "\(count) " + (count == 1 ? ["second", "minute", "hour", "day"] : ["seconds", "minutes", "hours", "days"])[index]
+            }
+        }
+
+        private var index: Int {
+            switch self {
+            case .second: 0
+            case .minute: 1
+            case .hour: 2
+            case .day: 3
+            }
+        }
+    }
+
+    private static var language: Language {
+        let preferred = (Bundle.main.preferredLocalizations.first ?? Locale.preferredLanguages.first ?? "en").lowercased()
+        if preferred.hasPrefix("zh-hant") || preferred.hasPrefix("zh-tw") || preferred.hasPrefix("zh-hk") { return .traditional }
+        if preferred.hasPrefix("zh") { return .simplified }
+        return .english
+    }
+
+    private static var table: [Key: String] {
+        switch language {
+        case .english: english
+        case .simplified: simplified
+        case .traditional: traditional
+        }
+    }
