+import Compound
+import SwiftUI
+
+/// FreeChat settings of one room: auto-delete, my burn-after-read, screenshots and the join password.
+@Observable
+final class FreeChatRoomSettings {
+    private(set) var roomTTL: UInt64 = 0
+    private(set) var personal = FreeChat.Personal()
+    private(set) var blockScreenshots = false
+    private(set) var hasJoinPassword: Bool?
+    private(set) var isSaving = false
+    var hasError = false
+
+    /// Room admins change room settings; in a DM both members may change auto-delete.
+    let canEditRoomSettings: Bool
+    let canEditAutoDelete: Bool
+    let canManagePassword: Bool
+
+    var roomReadTTL: UInt64? {
+        personal.rooms[roomProxy.id]
+    }
+
+    private let roomProxy: JoinedRoomProxyProtocol
+    private let clientProxy: ClientProxyProtocol
+
+    init(roomProxy: JoinedRoomProxyProtocol, clientProxy: ClientProxyProtocol) {
+        self.roomProxy = roomProxy
+        self.clientProxy = clientProxy
+        let info = roomProxy.infoPublisher.value
+        let isAdmin = info.powerLevels?.canOwnUser(sendStateEvent: .roomPowerLevels) == true
+        canEditRoomSettings = isAdmin
+        canEditAutoDelete = isAdmin || info.isDirect
+        canManagePassword = isAdmin && !info.isDirect
+    }
+
+    func load() async {
+        if case .success(let json) = await roomProxy.freechatStateContent(type: FreeChat.disappearingStateType) {
+            roomTTL = FreeChat.roomTTL(fromContentJSON: json)
+        }
+        if case .success(let json) = await roomProxy.freechatStateContent(type: FreeChat.privacyStateType) {
+            blockScreenshots = FreeChat.blocksScreenshots(privacyContentJSON: json)
+        }
+        if case .success(let json) = await clientProxy.freechatAccountData(type: FreeChat.disappearingStateType) {
+            personal = FreeChat.personal(fromContentJSON: json)
+        }
+        if canManagePassword, let api = clientProxy.freechatAPI, case .success(let enabled) = await api.hasJoinPassword(roomID: roomProxy.id) {
+            hasJoinPassword = enabled
+        }
+    }
+
+    func setRoomTTL(_ ttl: UInt64) async {
+        await save {
+            await self.roomProxy.sendFreechatState(type: FreeChat.disappearingStateType, contentJSON: FreeChat.contentJSON(forRoomTTL: ttl))
+                .map { self.roomTTL = ttl }
+                .mapError { $0 as Error }
+        }
+    }
+
+    func setBlockScreenshots(_ block: Bool) async {
+        await save {
+            await self.roomProxy.sendFreechatState(type: FreeChat.privacyStateType, contentJSON: FreeChat.privacyContentJSON(blockScreenshots: block))
+                .map { self.blockScreenshots = block }
+                .mapError { $0 as Error }
+        }
+    }
+
+    /// `nil` follows my default.
+    func setRoomReadTTL(_ ttl: UInt64?) async {
+        await save {
+            // Re-read so changes made on another device are kept.
+            let latest = await self.clientProxy.freechatAccountData(type: FreeChat.disappearingStateType)
+            guard case .success(let json) = latest else { return .failure(FreeChatAPIError.invalidResponse) }
+            let updated = FreeChat.updatingPersonal(json, roomID: self.roomProxy.id, roomReadTTL: .some(ttl))
+            return await self.clientProxy.setFreechatAccountData(type: FreeChat.disappearingStateType, contentJSON: updated)
+                .map { self.personal = FreeChat.personal(fromContentJSON: updated) }
+                .mapError { $0 as Error }
+        }
+    }
+
+    /// `nil` removes the password.
+    func setJoinPassword(_ password: String?) async {
+        guard let api = clientProxy.freechatAPI else {
+            hasError = true
+            return
+        }
+        await save {
+            await api.setJoinPassword(roomID: self.roomProxy.id, password: password)
+                .map { self.hasJoinPassword = password != nil }
+                .mapError { $0 as Error }
+        }
+    }
+
+    private func save(_ operation: () async -> Result<Void, Error>) async {
+        isSaving = true
+        defer { isSaving = false }
+        if case .failure(let error) = await operation() {
+            MXLog.error("FreeChat: failed saving a room setting: \(error)")
+            hasError = true
+        }
+    }
+}
+
+/// The FreeChat section of the room details screen.
+struct FreeChatRoomSection: View {
+    let settings: FreeChatRoomSettings
+
+    @State private var isEditingPassword = false
+    @State private var newPassword = ""
+
+    var body: some View {
+        Section {
+            autoDeleteRow
+            burnRow
+            if settings.canEditRoomSettings {
+                ListRow(label: .default(title: FreeChatStrings.string(.blockScreenshots), icon: \.visibilityOff),
+                        kind: .toggle(Binding(get: { settings.blockScreenshots },
+                                              set: { block in Task { await settings.setBlockScreenshots(block) } })))
+            }
+            if settings.canManagePassword {
+                passwordRows
+            }
+        } header: {
+            Text(FreeChatStrings.string(.section))
+                .compoundListSectionHeader()
+        } footer: {
+            Text(FreeChatStrings.string(settings.canEditAutoDelete ? .autoDeleteFooter : .burnFooter))
+                .compoundListSectionFooter()
+        }
+        .disabled(settings.isSaving)
+        .task { await settings.load() }
+        .alert(FreeChatStrings.string(.error), isPresented: Binding(get: { settings.hasError }, set: { settings.hasError = $0 })) {
+            Button(FreeChatStrings.string(.cancel), role: .cancel) { }
+        }
+        .alert(FreeChatStrings.string(.setPassword), isPresented: $isEditingPassword) {
+            SecureField(FreeChatStrings.string(.passwordPlaceholder), text: $newPassword)
+            Button(FreeChatStrings.string(.save)) {
+                let password = newPassword
+                newPassword = ""
+                Task { await settings.setJoinPassword(password) }
+            }
+            .disabled(newPassword.count < FreeChatAPI.minimumJoinPasswordLength)
+            Button(FreeChatStrings.string(.cancel), role: .cancel) { newPassword = "" }
+        } message: {
+            Text(FreeChatStrings.string(.passwordTooShort))
+        }
+    }
+
+    // MARK: - Private
+
+    @ViewBuilder
+    private var autoDeleteRow: some View {
+        if settings.canEditAutoDelete {
+            ListRow(label: .default(title: FreeChatStrings.string(.autoDelete), icon: \.timer),
+                    kind: .picker(selection: Binding(get: { settings.roomTTL },
+                                                     set: { ttl in Task { await settings.setRoomTTL(ttl) } }),
+                                  items: choices(FreeChat.roomTTLPresets, current: settings.roomTTL)))
+        } else {
+            ListRow(label: .default(title: FreeChatStrings.string(.autoDelete), icon: \.timer),
+                    details: .title(FreeChatStrings.duration(settings.roomTTL)),
+                    kind: .label)
+        }
+    }
+
+    private var burnRow: some View {
+        let followDefault = UInt64.max
+        let current = settings.roomReadTTL ?? followDefault
+        let items = [(title: "\(FreeChatStrings.string(.burnFollowDefault)) (\(FreeChatStrings.duration(settings.personal.readTTL)))", tag: followDefault)]
+            + choices(FreeChat.readTTLPresets, current: settings.roomReadTTL ?? 0)
+        return ListRow(label: .default(title: FreeChatStrings.string(.burn), icon: \.visibilityOff),
+                       kind: .picker(selection: Binding(get: { current },
+                                                        set: { ttl in Task { await settings.setRoomReadTTL(ttl == followDefault ? nil : ttl) } }),
+                                     items: items))
+    }
+
+    @ViewBuilder
+    private var passwordRows: some View {
+        ListRow(label: .default(title: FreeChatStrings.string(.joinPassword), icon: \.lock),
+                details: settings.hasJoinPassword.map { .title(FreeChatStrings.string($0 ? .joinPasswordSet : .joinPasswordNotSet)) } ?? .isWaiting(true),
+                kind: .button { isEditingPassword = true })
+        if settings.hasJoinPassword == true {
+            ListRow(label: .action(title: FreeChatStrings.string(.removePassword), icon: \.delete, role: .destructive),
+                    kind: .button { Task { await settings.setJoinPassword(nil) } })
+        }
+    }
+
+    private func choices(_ presets: [UInt64], current: UInt64) -> [(title: String, tag: UInt64)] {
+        let values = presets.contains(current) ? presets : presets + [current]
+        return values.map { (title: FreeChatStrings.duration($0), tag: $0) }
+    }
+}
