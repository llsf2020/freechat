+//
+// Copyright 2026 FreeChat contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+// Please see LICENSE files in the repository root for full details.
+//
+
+import Foundation
+
+nonisolated enum FreeChatAPIError: Error, Equatable {
+    case http(statusCode: Int)
+    /// Too many wrong join passwords; the server locks the room for this user for a while.
+    case rateLimited
+    case invalidResponse
+    case network
+}
+
+/// FreeChat homeserver extensions under `/_matrix/client/unstable/com.freechat`.
+nonisolated struct FreeChatAPI: Sendable {
+    static let minimumJoinPasswordLength = 6
+
+    let homeserverURL: URL
+    let accessToken: String
+    var session: URLSession = .shared
+
+    /// Which of `eventIDs` still exist on the server; purged ones are left out. Members only, at most 500 per call.
+    func existingEvents(roomID: String, eventIDs: Set<String>) async -> Result<Set<String>, FreeChatAPIError> {
+        let body = ["event_ids": Array(eventIDs.prefix(500))]
+        return await request("POST", roomPath(roomID, "existing_events"), body: body).flatMap { json in
+            guard let existing = json["existing"] as? [String] else { return .failure(.invalidResponse) }
+            return .success(Set(existing))
+        }
+    }
+
+    /// Whether the room has a join password. Room admins only.
+    func hasJoinPassword(roomID: String) async -> Result<Bool, FreeChatAPIError> {
+        await request("GET", roomPath(roomID, "join_password"), body: nil).map { ($0["enabled"] as? Bool) == true }
+    }
+
+    /// Sets the room's join password, or removes it when `password` is nil. Room admins only.
+    func setJoinPassword(roomID: String, password: String?) async -> Result<Void, FreeChatAPIError> {
+        let body: [String: Any] = password.map { ["password": $0] } ?? [:]
+        return await request("PUT", roomPath(roomID, "join_password"), body: body).map { _ in }
+    }
+
+    /// Gets this user invited with `password`. The caller then joins the room normally.
+    func inviteWithPassword(roomID: String, password: String) async -> Result<Void, FreeChatAPIError> {
+        await request("POST", roomPath(roomID, "join_with_password"), body: ["password": password]).map { _ in }
+    }
+
+    // MARK: - Private
+
+    private func roomPath(_ roomID: String, _ endpoint: String) -> String {
+        let encoded = roomID.addingPercentEncoding(withAllowedCharacters: .alphanumerics) ?? roomID
+        return "/_matrix/client/unstable/com.freechat/rooms/\(encoded)/\(endpoint)"
+    }
+
+    private func request(_ method: String, _ path: String, body: [String: Any]?) async -> Result<[String: Any], FreeChatAPIError> {
+        guard let url = URL(string: homeserverURL.absoluteString.trimmingCharacters(in: CharacterSet(charactersIn: "/")) + path) else {
+            return .failure(.invalidResponse)
+        }
+        var request = URLRequest(url: url)
+        request.httpMethod = method
+        request.setValue("Bearer \(accessToken)", forHTTPHeaderField: "Authorization")
+        if let body {
+            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+            request.httpBody = try? JSONSerialization.data(withJSONObject: body)
+        }
+
+        do {
+            let (data, response) = try await session.data(for: request)
+            guard let status = (response as? HTTPURLResponse)?.statusCode else { return .failure(.invalidResponse) }
+            if status == 429 { return .failure(.rateLimited) }
+            guard (200..<300).contains(status) else { return .failure(.http(statusCode: status)) }
+            let json = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any]
+            return .success(json ?? [:])
+        } catch {
+            return .failure(.network)
+        }
+    }
+}
diff --git a/ElementX/Sources/FreeChat/FreeChatExpiry.swift b/ElementX/Sources/FreeChat/FreeChatExpiry.swift
new file mode 100644
index 000000000..e815deefa
--- /dev/null
+++ b/ElementX/Sources/FreeChat/FreeChatExpiry.swift
@@ -0,0 +1,94 @@
+//
+// Copyright 2026 FreeChat contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+// Please see LICENSE files in the repository root for full details.
+//
+
+import Foundation
+import MatrixRustSDK
+import Synchronization
+
+/// The signed-in session's FreeChat API, for code far from the `ClientProxy` (timelines).
+/// Element X iOS runs one account at a time.
+nonisolated enum FreeChatSession {
+    private static let currentAPI = Mutex<FreeChatAPI?>(nil)
+
+    static var api: FreeChatAPI? {
+        get { currentAPI.withLock { $0 } }
+        set { currentAPI.withLock { $0 = newValue } }
+    }
+}
+
+/// When a timeline last looked for expired and purged messages.
+nonisolated struct FreeChatExpiryChecks {
+    var last = Date.now
+    var lastExistence = Date.distantPast
+}
+
+/// FreeChat: removes disappearing messages from a timeline on this device.
+///
+/// The server purges expired messages without leaving a redaction. `com.freechat.expires_at` (room auto-delete
+/// and the server cap) is honoured to the second, even offline. Messages that burn after reading, whose expiry
+/// this device cannot compute, are dropped once the server says they no longer exist. Redacted messages are
+/// hidden as well: deleted messages leave no trace.
+nonisolated final class FreeChatExpiryTracker: Sendable {
+    private struct State {
+        var markers = [String: FreeChat.ExpiryMarkers]()
+        var purged = Set<String>()
+    }
+
+    private let state = Mutex(State())
+
+    /// Whether the item should not be shown at all.
+    func isHidden(_ item: EventTimelineItemProxy, now: Date = .now) -> Bool {
+        if case .msgLike(let content) = item.content, case .redacted = content.kind {
+            return true
+        }
+        guard let eventID = item.id.eventID else { return false }
+        if state.withLock({ $0.purged.contains(eventID) }) { return true }
+        return markers(for: item, eventID: eventID).isExpired(now: now)
+    }
+
+    /// Whether any of the items is shown but should not be any more, so the timeline needs rebuilding.
+    func hasNewlyHidden(in items: [TimelineItemProxy], since lastCheck: Date, now: Date = .now) -> Bool {
+        events(in: items).contains { item in
+            guard let eventID = item.id.eventID else { return false }
+            let markers = markers(for: item, eventID: eventID)
+            return markers.isExpired(now: now) && !markers.isExpired(now: lastCheck)
+        }
+    }
+
+    /// Marked messages that are shown and whose fate only the server knows.
+    func unresolvedEventIDs(in items: [TimelineItemProxy], now: Date = .now) -> Set<String> {
+        let purged = state.withLock { $0.purged }
+        return Set(events(in: items).compactMap { item -> String? in
+            guard let eventID = item.id.eventID, !purged.contains(eventID) else { return nil }
+            let markers = markers(for: item, eventID: eventID)
+            return markers.isMarked && !markers.isExpired(now: now) ? eventID : nil
+        })
+    }
+
+    /// Remembers messages the server no longer has. Returns whether there were any.
+    func markPurged(_ eventIDs: Set<String>) -> Bool {
+        guard !eventIDs.isEmpty else { return false }
+        state.withLock { $0.purged.formUnion(eventIDs) }
+        return true
+    }
+
+    // MARK: - Private
+
+    /// An event's original JSON never changes, so its markers are parsed once.
+    private func markers(for item: EventTimelineItemProxy, eventID: String) -> FreeChat.ExpiryMarkers {
+        if let cached = state.withLock({ $0.markers[eventID] }) { return cached }
+        let markers = FreeChat.expiryMarkers(fromEventJSON: item.item.lazyProvider.debugInfo().originalJson)
+        state.withLock { $0.markers[eventID] = markers }
+        return markers
+    }
+
+    private func events(in items: [TimelineItemProxy]) -> [EventTimelineItemProxy] {
+        items.compactMap { item in
+            if case .event(let event) = item { event } else { nil }
+        }
+    }
+}
