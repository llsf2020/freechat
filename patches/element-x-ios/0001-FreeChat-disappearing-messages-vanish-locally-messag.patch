diff --git a/ElementX/Sources/Services/Timeline/TimelineController/TimelineController.swift b/ElementX/Sources/Services/Timeline/TimelineController/TimelineController.swift
index 24c9201af..41511836e 100644
--- a/ElementX/Sources/Services/Timeline/TimelineController/TimelineController.swift
+++ b/ElementX/Sources/Services/Timeline/TimelineController/TimelineController.swift
@@ -493,6 +493,10 @@ class TimelineController: TimelineControllerProtocol {
     /// The controller is switching the `activeTimelineItemProvider`.
     private var isSwitchingTimelines = false
     
+    // FreeChat: disappearing messages vanish from the timeline on their own.
+    private nonisolated let freechatExpiry = FreeChatExpiryTracker()
+    private var freechatExpiryCancellable: AnyCancellable?
+    
     /// Configures the controller to listen to `activeTimeline` for events.
     /// - Parameter clearExistingItems: Whether or not to clear any existing items before loading the timeline's contents.
     private func configureActiveTimelineItemProvider() {
@@ -518,6 +522,39 @@ class TimelineController: TimelineControllerProtocol {
                 await self?.updateTimelineItems(itemProxies: items, paginationState: paginationState)
             }
         }.asCancellable()
+        
+        // Holds self only for one check at a time, so the controller can go away and cancel the loop.
+        freechatExpiryCancellable = Task { [weak self] in
+            var checks = FreeChatExpiryChecks()
+            while !Task.isCancelled {
+                try? await Task.sleep(for: .seconds(1))
+                guard let self else { return }
+                await refreshForExpiry(&checks)
+            }
+        }.asCancellable()
+    }
+    
+    /// FreeChat: rebuilds the timeline when a message expires, or the server says it was purged.
+    private func refreshForExpiry(_ checks: inout FreeChatExpiryChecks) async {
+        let provider = activeTimelineItemProvider
+        let now = Date.now
+        var changed = freechatExpiry.hasNewlyHidden(in: provider.itemProxies, since: checks.last, now: now)
+        checks.last = now
