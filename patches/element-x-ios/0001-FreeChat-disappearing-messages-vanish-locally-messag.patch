+@testable import ElementX
+import Foundation
+import Testing
+
+/// FreeChat JSON formats; the same cases are covered by the web and Android clients.
+struct FreeChatTests {
+    @Test
+    func roomTTLIsLenient() {
+        #expect(FreeChat.roomTTL(fromContentJSON: #"{"ttl":3600}"#) == 3600)
+        #expect(FreeChat.roomTTL(fromContentJSON: #"{"ttl":0}"#) == 0)
+        #expect(FreeChat.roomTTL(fromContentJSON: #"{"ttl":-5}"#) == 0)
+        #expect(FreeChat.roomTTL(fromContentJSON: #"{"ttl":"3600"}"#) == 0)
+        #expect(FreeChat.roomTTL(fromContentJSON: #"{"ttl":true}"#) == 0)
+        #expect(FreeChat.roomTTL(fromContentJSON: "not json") == 0)
+        #expect(FreeChat.roomTTL(fromContentJSON: nil) == 0)
+        #expect(FreeChat.contentJSON(forRoomTTL: 60) == #"{"ttl":60}"#)
+    }
+
+    @Test
+    func screenshotBlockingIsStrict() {
+        #expect(FreeChat.blocksScreenshots(privacyContentJSON: #"{"block_screenshots":true}"#))
+        #expect(!FreeChat.blocksScreenshots(privacyContentJSON: #"{"block_screenshots":"true"}"#))
+        #expect(!FreeChat.blocksScreenshots(privacyContentJSON: #"{"block_screenshots":1}"#))
+        #expect(!FreeChat.blocksScreenshots(privacyContentJSON: nil))
+    }
+
+    @Test
+    func personalSettingsKeepUnknownFields() {
+        let original = #"{"read_ttl":30,"rooms":{"!a:x":5},"future":"kept"}"#
+        let personal = FreeChat.personal(fromContentJSON: original)
+        #expect(personal.readTTL == 30)
+        #expect(personal.readTTL(in: "!a:x") == 5)
+        #expect(personal.readTTL(in: "!b:x") == 30)
+        #expect(!personal.blockScreenshots)
+
+        let updated = FreeChat.updatingPersonal(original, readTTL: 60, roomID: "!b:x", roomReadTTL: .some(.none), blockScreenshots: true)
+        let reparsed = FreeChat.personal(fromContentJSON: updated)
+        #expect(reparsed.readTTL == 60)
+        #expect(reparsed.rooms == ["!a:x": 5])
+        #expect(reparsed.blockScreenshots)
+        #expect(updated.contains(#""future":"kept""#))
+    }
+
+    @Test
+    func roomOverridesCanBeSetAndCleared() {
+        let set = FreeChat.updatingPersonal(nil, roomID: "!a:x", roomReadTTL: .some(5))
+        #expect(FreeChat.personal(fromContentJSON: set).rooms == ["!a:x": 5])
+        let cleared = FreeChat.updatingPersonal(set, roomID: "!a:x", roomReadTTL: .some(.none))
+        #expect(FreeChat.personal(fromContentJSON: cleared).rooms.isEmpty)
+    }
+
+    @Test
+    func expiryMarkers() {
+        let marked = FreeChat.expiryMarkers(fromEventJSON: #"{"unsigned":{"com.freechat.expires_at":1000,"com.freechat.read_ttl":30}}"#)
+        #expect(marked.expiresAt == 1000)
+        #expect(marked.readTTL == 30)
+        #expect(marked.isMarked)
+        #expect(marked.isExpired(now: Date(timeIntervalSince1970: 1)))
+        #expect(!marked.isExpired(now: Date(timeIntervalSince1970: 0.5)))
+
+        #expect(FreeChat.expiryMarkers(fromEventJSON: #"{"unsigned":{}}"#) == .none)
+        #expect(FreeChat.expiryMarkers(fromEventJSON: #"{"unsigned":{"com.freechat.expires_at":"1000"}}"#) == .none)
+        #expect(FreeChat.expiryMarkers(fromEventJSON: nil) == .none)
+        #expect(!FreeChat.ExpiryMarkers.none.isMarked)
+    }
+
+    @Test
+    func purgedEventsAreRemembered() {
+        let tracker = FreeChatExpiryTracker()
+        #expect(!tracker.markPurged([]))
+        #expect(tracker.markPurged(["$a"]))
+        #expect(tracker.unresolvedEventIDs(in: []).isEmpty)
+    }
+}
