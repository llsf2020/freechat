new file mode 100644
index 000000000..19c47ac36
--- /dev/null
+++ b/ElementX/Sources/FreeChat/FreeChat.swift
@@ -0,0 +1,135 @@
+//
+// Copyright 2026 FreeChat contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+// Please see LICENSE files in the repository root for full details.
+//
+
+import Foundation
+
+/// FreeChat protocol constants and the JSON formats shared with the web and Android clients.
+nonisolated enum FreeChat {
+    static let disappearingStateType = "com.freechat.disappearing"
+    static let privacyStateType = "com.freechat.privacy"
+    static let expiresAtKey = "com.freechat.expires_at"
+    static let readTTLKey = "com.freechat.read_ttl"
+    static let mediaKey = "com.freechat.media"
+
+    /// Power level needed to change room settings; the homeserver enforces it too.
+    static let adminPowerLevel: Int64 = 100
+
+    /// Room auto-delete presets in seconds. Zero means off.
+    static let roomTTLPresets: [UInt64] = [0, 3600, 86400, 7 * 86400, 30 * 86400]
+    /// Personal burn-after-read presets in seconds. Zero means off.
+    static let readTTLPresets: [UInt64] = [0, 5, 30, 60, 300, 3600]
+
+    // MARK: - Room auto-delete (`com.freechat.disappearing` state, `{"ttl": seconds}`)
+
+    static func roomTTL(fromContentJSON json: String?) -> UInt64 {
+        nonNegative(object(from: json)?["ttl"]) ?? 0
+    }
+
+    static func contentJSON(forRoomTTL ttl: UInt64) -> String {
+        "{\"ttl\":\(ttl)}"
+    }
+
+    // MARK: - Room privacy (`com.freechat.privacy` state, `{"block_screenshots": bool}`)
+
+    static func blocksScreenshots(privacyContentJSON json: String?) -> Bool {
+        isTrue(object(from: json)?["block_screenshots"])
+    }
+
+    static func privacyContentJSON(blockScreenshots: Bool) -> String {
+        "{\"block_screenshots\":\(blockScreenshots)}"
+    }
+
+    // MARK: - Personal settings (global `com.freechat.disappearing` account data)
+
+    /// `{"read_ttl": seconds, "rooms": {"<room id>": seconds}, "block_screenshots": bool}`.
+    struct Personal: Equatable {
+        var readTTL: UInt64 = 0
+        var rooms: [String: UInt64] = [:]
+        var blockScreenshots = false
+
+        func readTTL(in roomID: String) -> UInt64 {
+            rooms[roomID] ?? readTTL
+        }
+    }
+
+    static func personal(fromContentJSON json: String?) -> Personal {
+        guard let content = object(from: json) else { return Personal() }
+        var rooms = [String: UInt64]()
+        for (roomID, value) in content["rooms"] as? [String: Any] ?? [:] {
+            if let ttl = nonNegative(value) { rooms[roomID] = ttl }
+        }
+        return Personal(readTTL: nonNegative(content["read_ttl"]) ?? 0,
+                        rooms: rooms,
+                        blockScreenshots: isTrue(content["block_screenshots"]))
+    }
+
+    /// `json` with the given fields replaced and everything else kept, so settings written by newer clients survive.
+    static func updatingPersonal(_ json: String?,
+                                 readTTL: UInt64? = nil,
+                                 roomID: String? = nil,
+                                 roomReadTTL: UInt64?? = nil,
+                                 blockScreenshots: Bool? = nil) -> String {
+        var content = object(from: json) ?? [:]
+        if let readTTL { content["read_ttl"] = readTTL }
+        if let blockScreenshots { content["block_screenshots"] = blockScreenshots }
+        if let roomID, let roomReadTTL {
+            var rooms = content["rooms"] as? [String: Any] ?? [:]
+            if let ttl = roomReadTTL {
+                rooms[roomID] = ttl
+            } else {
+                rooms.removeValue(forKey: roomID)
+            }
+            content["rooms"] = rooms
+        }
+        guard let data = try? JSONSerialization.data(withJSONObject: content, options: [.sortedKeys]) else { return "{}" }
+        return String(decoding: data, as: UTF8.self)
+    }
+
+    // MARK: - Expiry markers (`unsigned` of each message)
+
+    struct ExpiryMarkers: Equatable {
+        static let none = ExpiryMarkers(expiresAt: nil, readTTL: nil)
+
+        /// When the message expires, in milliseconds since the epoch.
+        let expiresAt: UInt64?
+        /// Seconds after everyone else has read it.
+        let readTTL: UInt64?
+
+        var isMarked: Bool {
+            expiresAt != nil || readTTL != nil
+        }
+
+        func isExpired(now: Date) -> Bool {
+            guard let expiresAt else { return false }
+            return Double(expiresAt) <= now.timeIntervalSince1970 * 1000
+        }
+    }
+
+    static func expiryMarkers(fromEventJSON json: String?) -> ExpiryMarkers {
+        guard let unsigned = object(from: json)?["unsigned"] as? [String: Any] else { return .none }
+        return ExpiryMarkers(expiresAt: nonNegative(unsigned[expiresAtKey]), readTTL: nonNegative(unsigned[readTTLKey]))
+    }
+
+    // MARK: - Helpers
+
+    private static func object(from json: String?) -> [String: Any]? {
+        guard let data = json?.data(using: .utf8) else { return nil }
+        return (try? JSONSerialization.jsonObject(with: data)) as? [String: Any]
+    }
+
+    /// Only a JSON `true`: JSONSerialization also bridges the number 1 to `Bool`.
+    private static func isTrue(_ value: Any?) -> Bool {
+        guard let number = value as? NSNumber, CFGetTypeID(number) == CFBooleanGetTypeID() else { return false }
+        return number.boolValue
+    }
+
+    private static func nonNegative(_ value: Any?) -> UInt64? {
+        // JSONSerialization turns `true` into an NSNumber as well.
+        guard let number = value as? NSNumber, CFGetTypeID(number) != CFBooleanGetTypeID(), number.int64Value >= 0 else { return nil }
+        return number.uint64Value
+    }
+}
