From b2b69a937cb183efb1160a84fe2dcad511f4f95b Mon Sep 17 00:00:00 2001
From: sjcsf <346224915+llsf2020@users.noreply.github.com>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH 08/10] FreeChat: batch existence checks and refuse redirects
 on iOS

- Existence checks are sent in batches of 500. Before, only the first 500
  IDs were asked about and the rest were taken as purged and hidden.
- FreeChat requests do not follow redirects, so the access token cannot be
  sent to another host. Not yet built or tested on a Mac.
---
 ElementX/Sources/FreeChat/FreeChatAPI.swift | 33 +++++++++++++++++----
 1 file changed, 27 insertions(+), 6 deletions(-)

diff --git a/ElementX/Sources/FreeChat/FreeChatAPI.swift b/ElementX/Sources/FreeChat/FreeChatAPI.swift
index b696f75b0..89a3446df 100644
--- a/ElementX/Sources/FreeChat/FreeChatAPI.swift
+++ b/ElementX/Sources/FreeChat/FreeChatAPI.swift
@@ -23,13 +23,23 @@ nonisolated struct FreeChatAPI: Sendable {
     let accessToken: String
     var session: URLSession = .shared
 
-    /// Which of `eventIDs` still exist on the server; purged ones are left out. Members only, at most 500 per call.
+    /// Which of `eventIDs` still exist on the server; purged ones are left out. Members only. Asks in batches of
+    /// 500, the most the server takes at once, so every ID gets an answer.
     func existingEvents(roomID: String, eventIDs: Set<String>) async -> Result<Set<String>, FreeChatAPIError> {
-        let body = ["event_ids": Array(eventIDs.prefix(500))]
-        return await request("POST", roomPath(roomID, "existing_events"), body: body).flatMap { json in
-            guard let existing = json["existing"] as? [String] else { return .failure(.invalidResponse) }
-            return .success(Set(existing))
+        let ids = Array(eventIDs)
+        var existing = Set<String>()
+        for start in stride(from: 0, to: ids.count, by: 500) {
+            let body = ["event_ids": Array(ids[start..<min(start + 500, ids.count)])]
+            let batch = await request("POST", roomPath(roomID, "existing_events"), body: body).flatMap { json in
+                guard let found = json["existing"] as? [String] else { return Result<[String], FreeChatAPIError>.failure(.invalidResponse) }
+                return .success(found)
+            }
+            switch batch {
+            case .success(let found): existing.formUnion(found)
+            case .failure(let error): return .failure(error)
+            }
         }
+        return .success(existing)
     }
 
     /// Tells the server which media the user's own disappearing message uses, so the files are deleted when it
@@ -76,7 +86,8 @@ nonisolated struct FreeChatAPI: Sendable {
         }
 
         do {
-            let (data, response) = try await session.data(for: request)
+            // The access token must never follow a redirect to another host.
+            let (data, response) = try await session.data(for: request, delegate: FreeChatNoRedirects())
             guard let status = (response as? HTTPURLResponse)?.statusCode else { return .failure(.invalidResponse) }
             if status == 429 { return .failure(.rateLimited) }
             guard (200..<300).contains(status) else { return .failure(.http(statusCode: status)) }
@@ -87,3 +98,13 @@ nonisolated struct FreeChatAPI: Sendable {
         }
     }
 }
+
+/// Refuses HTTP redirects, so the bearer token only ever goes to the homeserver itself.
+private nonisolated final class FreeChatNoRedirects: NSObject, URLSessionTaskDelegate, Sendable {
+    func urlSession(_ session: URLSession,
+                    task: URLSessionTask,
+                    willPerformHTTPRedirection response: HTTPURLResponse,
+                    newRequest request: URLRequest) async -> URLRequest? {
+        nil
+    }
+}
