@@ -0,0 +1,58 @@
+//
+// Copyright 2026 FreeChat contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+// Please see LICENSE files in the repository root for full details.
+//
+
+import Foundation
+import Synchronization
+
+/// FreeChat strict mode: a per-device choice to leave nothing on the device.
+///
+/// A session signed in while it is on:
+/// - uses the SDK's in-memory store: nothing of it is written to disk, not even encrypted;
+/// - is never saved to the keychain, so the next launch starts signed out;
+/// - signs out when the app comes back after the chosen time in the background;
+/// - for password sign-ins, uses a device ID of the form `FCS<minutes>_<random>`, which the homeserver
+///   deletes once it has been idle for that long. That covers an app that was killed or suspended.
+nonisolated enum FreeChatStrictMode {
+    static let devicePrefix = "FCS"
+    static let defaultIdleMinutes = 5
+    static let idlePresetsMinutes = [1, 5, 15, 30, 60]
+
+    struct Settings: Equatable {
+        var isEnabled = false
+        var idleMinutes = FreeChatStrictMode.defaultIdleMinutes
+    }
+
+    /// The device's choice. It says nothing about the user, so it is kept in user defaults.
+    static var settings: Settings {
+        get {
+            let defaults = UserDefaults.standard
+            let idle = defaults.integer(forKey: idleKey)
+            return Settings(isEnabled: defaults.bool(forKey: enabledKey), idleMinutes: idle > 0 ? idle : defaultIdleMinutes)
+        }
+        set {
+            UserDefaults.standard.set(newValue.isEnabled, forKey: enabledKey)
+            UserDefaults.standard.set(max(newValue.idleMinutes, 1), forKey: idleKey)
+        }
+    }
+
+    /// Whether the authentication client being set up, and so the session it becomes, is a strict one.
+    static var isStrictClient: Bool {
+        get { strictClient.withLock { $0 } }
+        set { strictClient.withLock { $0 = newValue } }
+    }
+
+    static func deviceID(idleMinutes: Int) -> String {
+        let random = (0..<8).map { _ in String(format: "%02x", UInt8.random(in: 0...255)) }.joined()
+        return "\(devicePrefix)\(idleMinutes)_\(random)"
+    }
+
+    // MARK: - Private
+
+    private static let enabledKey = "freechat.strictMode.enabled"
+    private static let idleKey = "freechat.strictMode.idleMinutes"
+    private static let strictClient = Mutex(false)
+}
