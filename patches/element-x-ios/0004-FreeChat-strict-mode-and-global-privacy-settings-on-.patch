index 000000000..2977d967b
--- /dev/null
+++ b/ElementX/Sources/FreeChat/FreeChatGlobalSettings.swift
@@ -0,0 +1,163 @@
+//
+// Copyright 2026 FreeChat contributors
+//
+// SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only
+// Please see LICENSE files in the repository root for full details.
+//
+
+import Compound
+import SwiftUI
+
+/// FreeChat settings for every chat: my default burn-after-read, protection for every chat and strict mode.
+@Observable
+final class FreeChatGlobalSettings {
+    private(set) var personal = FreeChat.Personal()
+    private(set) var strictMode = FreeChatStrictMode.settings
+    private(set) var isSaving = false
+    var hasError = false
+
+    /// The running session was signed in with strict mode on.
+    let isStrictSession = FreeChatStrictMode.isStrictClient
+
+    private let clientProxy: ClientProxyProtocol
+    /// Starts the app's normal sign-out, which warns when the keys are not backed up.
+    private let signOut: () -> Void
+
+    init(clientProxy: ClientProxyProtocol, signOut: @escaping () -> Void) {
+        self.clientProxy = clientProxy
+        self.signOut = signOut
+    }
+
+    func load() async {
+        if case .success(let json) = await clientProxy.freechatAccountData(type: FreeChat.disappearingStateType) {
+            personal = FreeChat.personal(fromContentJSON: json)
+        }
+    }
+
+    func setDefaultReadTTL(_ ttl: UInt64) async {
+        await updatePersonal { FreeChat.updatingPersonal($0, readTTL: ttl) }
+    }
+
+    func setProtectEveryChat(_ protect: Bool) async {
+        await updatePersonal { FreeChat.updatingPersonal($0, blockScreenshots: protect) }
+    }
+
+    /// Strict mode applies from the next sign-in, so turning it on signs out right away.
+    func enableStrictModeAndSignOut() {
+        setStrictMode(FreeChatStrictMode.Settings(isEnabled: true, idleMinutes: strictMode.idleMinutes))
+        signOut()
+    }
+
+    func disableStrictMode() {
+        setStrictMode(FreeChatStrictMode.Settings(isEnabled: false, idleMinutes: strictMode.idleMinutes))
+    }
+
+    func setIdleMinutes(_ minutes: Int) {
+        setStrictMode(FreeChatStrictMode.Settings(isEnabled: strictMode.isEnabled, idleMinutes: minutes))
+    }
+
+    // MARK: - Private
+
+    private func setStrictMode(_ settings: FreeChatStrictMode.Settings) {
+        FreeChatStrictMode.settings = settings
+        strictMode = settings
+    }
+
+    private func updatePersonal(_ update: (String?) -> String) async {
+        isSaving = true
+        defer { isSaving = false }
+        // Re-read so changes made on another device are kept.
+        guard case .success(let latest) = await clientProxy.freechatAccountData(type: FreeChat.disappearingStateType) else {
+            hasError = true
+            return
+        }
+        let updated = update(latest)
+        switch await clientProxy.setFreechatAccountData(type: FreeChat.disappearingStateType, contentJSON: updated) {
+        case .success:
+            personal = FreeChat.personal(fromContentJSON: updated)
+        case .failure:
+            hasError = true
+        }
+    }
+}
+
+/// The FreeChat sections of the settings screen.
+struct FreeChatGlobalSections: View {
+    let settings: FreeChatGlobalSettings
+
+    @State private var isConfirmingStrictMode = false
+
+    var body: some View {
+        Section {
+            ListRow(label: .default(title: FreeChatStrings.string(.burnDefault), icon: \.visibilityOff),
+                    kind: .picker(selection: Binding(get: { settings.personal.readTTL },
+                                                     set: { ttl in Task { await settings.setDefaultReadTTL(ttl) } }),
+                                  items: choices(FreeChat.readTTLPresets, current: settings.personal.readTTL)))
+            ListRow(label: .default(title: FreeChatStrings.string(.alwaysBlockScreenshots), icon: \.lock),
+                    kind: .toggle(Binding(get: { settings.personal.blockScreenshots },
+                                          set: { protect in Task { await settings.setProtectEveryChat(protect) } })))
+        } header: {
+            Text(FreeChatStrings.string(.section))
+                .compoundListSectionHeader()
+        } footer: {
+            Text(FreeChatStrings.string(.alwaysBlockScreenshotsFooter))
+                .compoundListSectionFooter()
+        }
+        .disabled(settings.isSaving)
+        .task { await settings.load() }
+        .alert(FreeChatStrings.string(.error), isPresented: Binding(get: { settings.hasError }, set: { settings.hasError = $0 })) {
+            Button(FreeChatStrings.string(.cancel), role: .cancel) { }
+        }
+
+        Section {
+            strictModeRows
+        } header: {
+            Text(FreeChatStrings.string(.strictSection))
+                .compoundListSectionHeader()
+        } footer: {
+            Text(FreeChatStrings.string(.strictFooter))
+                .compoundListSectionFooter()
+        }
+        .alert(FreeChatStrings.string(.strictConfirmTitle), isPresented: $isConfirmingStrictMode) {
+            Button(FreeChatStrings.string(.strictConfirmButton), role: .destructive) { settings.enableStrictModeAndSignOut() }
+            Button(FreeChatStrings.string(.cancel), role: .cancel) { }
+        } message: {
+            Text(FreeChatStrings.string(.strictConfirmMessage))
+        }
+    }
+
+    // MARK: - Private
+
+    @ViewBuilder
+    private var strictModeRows: some View {
+        if settings.isStrictSession, settings.strictMode.isEnabled {
+            ListRow(label: .default(title: FreeChatStrings.string(.strictTitle), icon: \.lockSolid),
+                    details: .title(FreeChatStrings.string(.strictOn)),
+                    kind: .label)
+            ListRow(label: .default(title: FreeChatStrings.string(.strictIdle), icon: \.timer),
+                    kind: .picker(selection: Binding(get: { settings.strictMode.idleMinutes },
+                                                     set: { settings.setIdleMinutes($0) }),
+                                  items: idleChoices))
+            ListRow(label: .action(title: FreeChatStrings.string(.strictTurnOff), icon: \.lockOff),
+                    kind: .button { settings.disableStrictMode() })
+        } else if settings.isStrictSession {
+            ListRow(label: .default(title: FreeChatStrings.string(.strictTitle), icon: \.lockSolid),
+                    details: .title(FreeChatStrings.string(.strictOffPending)),
+                    kind: .label)
+        } else {
+            ListRow(label: .default(title: FreeChatStrings.string(.strictTitle), icon: \.lockSolid),
+                    kind: .button { isConfirmingStrictMode = true })
+        }
+    }
+
+    private var idleChoices: [(title: String, tag: Int)] {
+        let current = settings.strictMode.idleMinutes
+        let values = FreeChatStrictMode.idlePresetsMinutes.contains(current) ? FreeChatStrictMode.idlePresetsMinutes : FreeChatStrictMode.idlePresetsMinutes + [current]
+        return values.map { (title: FreeChatStrings.duration(UInt64($0) * 60), tag: $0) }
+    }
+
+    private func choices(_ presets: [UInt64], current: UInt64) -> [(title: String, tag: UInt64)] {
+        let values = presets.contains(current) ? presets : presets + [current]
+        return values.map { (title: FreeChatStrings.duration($0), tag: $0) }
+    }
+}
