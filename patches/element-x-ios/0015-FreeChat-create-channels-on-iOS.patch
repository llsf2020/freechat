+//
+
+import Foundation
+
+/// Channels: rooms where only moderators and admins post, while everyone can still react.
+nonisolated extension FreeChat {
+    static let powerLevelsStateType = "m.room.power_levels"
+    static let channelPostPowerLevel = 50
+
+    /// The room's power levels turned into a channel's, or nil when they cannot be read.
+    static func channelPowerLevelsJSON(from json: String?) -> String? {
+        guard let data = json?.data(using: .utf8),
+              var levels = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any] else {
+            return nil
+        }
+        levels["events_default"] = channelPostPowerLevel
+        var events = levels["events"] as? [String: Any] ?? [:]
+        events["m.reaction"] = 0
+        levels["events"] = events
+        guard let output = try? JSONSerialization.data(withJSONObject: levels, options: [.sortedKeys]) else { return nil }
+        return String(data: output, encoding: .utf8)
+    }
+
+    /// Makes a room the user just created a channel. The server applies the room's power levels at creation, so they
+    /// are changed right after.
+    @MainActor static func makeChannel(_ roomProxy: JoinedRoomProxyProtocol) async {
+        guard case .success(let json) = await roomProxy.freechatStateContent(type: powerLevelsStateType),
+              let channelJSON = channelPowerLevelsJSON(from: json) else {
+            MXLog.error("FreeChat: could not read the power levels of the new channel")
+            return
+        }
+        if case .failure(let error) = await roomProxy.sendFreechatState(type: powerLevelsStateType, contentJSON: channelJSON) {
+            MXLog.error("FreeChat: could not make the room a channel: \(error)")
+        }
+    }
+}
