@@ -316,6 +316,7 @@ class ClientProxy: ClientProxyProtocol {
         liveLocationOwnInfoUpdatesListenerTaskHandle = createLiveLocationOwnInfoUpdatesObserver()
         
         FreeChatSession.api = freechatAPI
+        FreeChatSession.client = client
     }
     
     var userID: String {
diff --git a/ElementX/Sources/Services/Timeline/TimelineController/TimelineController.swift b/ElementX/Sources/Services/Timeline/TimelineController/TimelineController.swift
index 2f976c997..ff6e55bf9 100644
--- a/ElementX/Sources/Services/Timeline/TimelineController/TimelineController.swift
+++ b/ElementX/Sources/Services/Timeline/TimelineController/TimelineController.swift
@@ -562,6 +562,10 @@ class TimelineController: TimelineControllerProtocol {
                 }
             }
         }
+        let toErase = freechatExpiry.eventIDsToErase(in: provider.itemProxies, now: now)
+        if !toErase.isEmpty {
+            await FreeChatSession.eraseEventsLocally(roomID: roomID, eventIDs: toErase)
+        }
         if changed {
             await updateTimelineItems(itemProxies: provider.itemProxies, paginationState: provider.paginationState)
         }
