+import Compound
+import Security
+import SwiftUI
+
+/// The emergency PIN of the app lock. Entered instead of the PIN, it signs out and erases this device at once, for
+/// when someone forces the user to unlock the app. Kept in the keychain like the PIN, on this device only.
+nonisolated enum FreeChatEmergencyPIN {
+    private static let service = "io.freechat.emergency-pin"
+    private static let account = "emergency-pin"
+
+    static var isSet: Bool { read() != nil }
+
+    static func matches(_ pinCode: String) -> Bool {
+        guard let stored = read() else { return false }
+        return stored == pinCode
+    }
+
+    /// Four digits, like the PIN; `isPIN` tells whether it is the PIN itself, which is refused.
+    static func set(_ pinCode: String, isPIN: (String) -> Bool) -> Bool {
+        guard pinCode.count == 4, pinCode.allSatisfy(\.isASCIINumber), !isPIN(pinCode) else { return false }
+        remove()
+        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword,
+                                    kSecAttrService as String: service,
+                                    kSecAttrAccount as String: account,
+                                    kSecAttrAccessible as String: kSecAttrAccessibleWhenUnlockedThisDeviceOnly,
+                                    kSecValueData as String: Data(pinCode.utf8)]
+        return SecItemAdd(query as CFDictionary, nil) == errSecSuccess
+    }
+
+    static func remove() {
+        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword,
+                                    kSecAttrService as String: service,
+                                    kSecAttrAccount as String: account]
+        SecItemDelete(query as CFDictionary)
+    }
+
+    private static func read() -> String? {
+        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword,
+                                    kSecAttrService as String: service,
+                                    kSecAttrAccount as String: account,
+                                    kSecReturnData as String: true,
+                                    kSecMatchLimit as String: kSecMatchLimitOne]
+        var result: CFTypeRef?
+        guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess, let data = result as? Data else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+}
+
+/// The emergency PIN rows of the app lock settings.
+struct FreeChatEmergencyPINSection: View {
+    /// Whether a code is the app lock's PIN, which the emergency PIN must differ from.
+    let isPIN: (String) -> Bool
+
+    @State private var isSet = FreeChatEmergencyPIN.isSet
+    @State private var isEditing = false
+    @State private var showsInvalid = false
+    @State private var code = ""
+
+    var body: some View {
+        Section {
+            ListRow(label: .plain(title: FreeChatStrings.string(isSet ? .emergencyPINChange : .emergencyPINSet)),
+                    kind: .button {
+                        code = ""
+                        isEditing = true
+                    })
+            if isSet {
+                ListRow(label: .plain(title: FreeChatStrings.string(.emergencyPINRemove), role: .destructive),
+                        kind: .button {
+                            FreeChatEmergencyPIN.remove()
+                            isSet = false
+                        })
+            }
+        } footer: {
+            Text(FreeChatStrings.string(.emergencyPINFooter))
+                .compoundListSectionFooter()
+        }
+        .alert(FreeChatStrings.string(.emergencyPINTitle), isPresented: $isEditing) {
+            // Plain state, never saved: the code is gone once the alert closes.
+            SecureField(FreeChatStrings.string(.emergencyPINPlaceholder), text: $code)
+                .keyboardType(.numberPad)
+            Button(FreeChatStrings.string(.save)) {
+                if FreeChatEmergencyPIN.set(code, isPIN: isPIN) {
+                    isSet = true
+                } else {
+                    showsInvalid = true
+                }
+                code = ""
+            }
+            Button(FreeChatStrings.string(.cancel), role: .cancel) { code = "" }
+        }
+        .alert(FreeChatStrings.string(.emergencyPINInvalid), isPresented: $showsInvalid) {
+            Button(FreeChatStrings.string(.cancel), role: .cancel) { }
+        }
+    }
+}
