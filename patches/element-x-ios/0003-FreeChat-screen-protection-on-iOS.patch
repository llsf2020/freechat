+//
+
+import Compound
+import SwiftUI
+
+/// Whether a room asks for screenshot protection: the room setting, or the user's own setting for every chat.
+@Observable
+final class FreeChatScreenPolicy {
+    private(set) var isProtected = false
+
+    private let roomProxy: JoinedRoomProxyProtocol
+    private let clientProxy: ClientProxyProtocol
+
+    init(roomProxy: JoinedRoomProxyProtocol, clientProxy: ClientProxyProtocol) {
+        self.roomProxy = roomProxy
+        self.clientProxy = clientProxy
+    }
+
+    func load() async {
+        var protected = false
+        if case .success(let json) = await roomProxy.freechatStateContent(type: FreeChat.privacyStateType) {
+            protected = FreeChat.blocksScreenshots(privacyContentJSON: json)
+        }
+        if !protected, case .success(let json) = await clientProxy.freechatAccountData(type: FreeChat.disappearingStateType) {
+            protected = FreeChat.personal(fromContentJSON: json).blockScreenshots
+        }
+        isProtected = protected
+    }
+}
+
+extension View {
+    /// iOS cannot block screenshots. Instead the content is hidden while the screen is recorded or mirrored,
+    /// and taking a screenshot shows a warning.
+    func freechatScreenProtection(_ policy: FreeChatScreenPolicy?) -> some View {
+        modifier(FreeChatScreenProtectionModifier(policy: policy))
+    }
+}
+
+private struct FreeChatScreenProtectionModifier: ViewModifier {
+    let policy: FreeChatScreenPolicy?
+
+    @State private var isCaptured = false
+    @State private var showsScreenshotWarning = false
+
+    private var isProtected: Bool {
+        policy?.isProtected == true
+    }
+
+    func body(content: Content) -> some View {
+        content
+            .overlay {
+                if isProtected, isCaptured {
+                    ZStack {
+                        Color.compound.bgCanvasDefault
+                        Label(FreeChatStrings.string(.screenHidden), icon: \.visibilityOff)
+                            .font(.compound.bodyLGSemibold)
+                            .foregroundStyle(.compound.textSecondary)
+                    }
+                    .ignoresSafeArea()
+                }
+            }
+            .task { await policy?.load() }
+            .onAppear { isCaptured = Self.isScreenCaptured }
+            .onReceive(NotificationCenter.default.publisher(for: UIScreen.capturedDidChangeNotification)) { _ in
+                isCaptured = Self.isScreenCaptured
+            }
+            .onReceive(NotificationCenter.default.publisher(for: UIApplication.userDidTakeScreenshotNotification)) { _ in
+                if isProtected { showsScreenshotWarning = true }
+            }
+            .alert(FreeChatStrings.string(.screenshotTaken), isPresented: $showsScreenshotWarning) {
+                Button(FreeChatStrings.string(.cancel), role: .cancel) { }
+            } message: {
+                Text(FreeChatStrings.string(.screenshotTakenMessage))
+            }
+    }
+
+    private static var isScreenCaptured: Bool {
+        UIApplication.shared.connectedScenes
+            .compactMap { ($0 as? UIWindowScene)?.screen }
+            .contains { $0.isCaptured }
+    }
+}
