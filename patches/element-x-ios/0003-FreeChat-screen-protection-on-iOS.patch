 .../FreeChat/FreeChatScreenProtection.swift   | 87 +++++++++++++++++++
 .../RoomScreen/RoomScreenCoordinator.swift    |  5 +-
 3 files changed, 109 insertions(+), 2 deletions(-)
 create mode 100644 ElementX/Sources/FreeChat/FreeChatScreenProtection.swift

diff --git a/ElementX/Sources/FlowCoordinators/AppLockFlowCoordinator.swift b/ElementX/Sources/FlowCoordinators/AppLockFlowCoordinator.swift
index f910f8474..b2cdfaecd 100644
--- a/ElementX/Sources/FlowCoordinators/AppLockFlowCoordinator.swift
+++ b/ElementX/Sources/FlowCoordinators/AppLockFlowCoordinator.swift
@@ -140,7 +140,8 @@ class AppLockFlowCoordinator: CoordinatorProtocol {
     
     private func configureStateMachine() {
         stateMachine.addRouteMapping { [weak self] event, fromState, _ in
-            guard let self, appLockService.isEnabled else { return fromState }
+            guard let self else { return fromState }
+            guard appLockService.isEnabled else { return Self.obscureOnlyRoute(from: fromState, event: event) }
             
             switch (fromState, event) {
             case (.initial, .start):
@@ -218,6 +219,22 @@ class AppLockFlowCoordinator: CoordinatorProtocol {
         stateMachine.tryEvent(.start)
     }
     
+    /// FreeChat: without app lock the app is still covered in the app switcher, whose snapshot iOS keeps on disk.
+    private static func obscureOnlyRoute(from state: State, event: Event?) -> State? {
+        switch (state, event) {
+        case (.initial, .willResignActive), (.unlocked, .willResignActive):
+            .appObscured
+        case (_, .didEnterBackground):
+            .backgrounded
+        case (_, .willEnterForeground):
+            .launching
+        case (.appObscured, .didBecomeActive), (.backgrounded, .didBecomeActive), (.launching, .didBecomeActive):
+            .unlocked
+        default:
+            state
+        }
+    }
+    
     // MARK: - App unlock
     
     /// Displays the unlock flow with the app's placeholder view to hide obscure the view hierarchy in the app switcher.
