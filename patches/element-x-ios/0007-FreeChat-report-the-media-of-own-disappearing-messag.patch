@@ -534,12 +534,22 @@ class TimelineController: TimelineControllerProtocol {
         }.asCancellable()
     }
     
-    /// FreeChat: rebuilds the timeline when a message expires, or the server says it was purged.
+    /// FreeChat: rebuilds the timeline when a message expires, or the server says it was purged, and reports the
+    /// media of the user's own disappearing messages.
     private func refreshForExpiry(_ checks: inout FreeChatExpiryChecks) async {
         let provider = activeTimelineItemProvider
         let now = Date.now
         var changed = freechatExpiry.hasNewlyHidden(in: provider.itemProxies, since: checks.last, now: now)
         checks.last = now
+        if let api = FreeChatSession.api {
+            for (eventID, mxcs) in freechatExpiry.mediaToReport(in: provider.itemProxies, now: now) {
+                if case .failure(let error) = await api.reportEventMedia(roomID: roomID, eventID: eventID, mxcs: mxcs) {
+                    // Retry on the next check only when the server was not reached; otherwise it refused for good.
+                    if error == .network { freechatExpiry.retryMediaReport(eventID) }
+                    MXLog.error("FreeChat: reporting media failed in \(roomID): \(error)")
+                }
+            }
+        }
         if now.timeIntervalSince(checks.lastExistence) >= 30, let api = FreeChatSession.api {
             checks.lastExistence = now
             let pending = freechatExpiry.unresolvedEventIDs(in: provider.itemProxies, now: now)
