From ae9c57d5f7693f80e8e4f4dcef7647cbba23fd05 Mon Sep 17 00:00:00 2001
From: sjcsf <346224915+llsf2020@users.noreply.github.com>
Date: Thu, 22 Oct 2026 00:00:00 +0000
Subject: [PATCH 05/11] FreeChat: join private rooms with a password on iOS

The password stays in the view bindings, out of the logged view actions.
Untested: needs a Mac to build.
---
 .../JoinRoomScreen/JoinRoomScreenModels.swift |  7 ++++++
 .../JoinRoomScreenViewModel.swift             | 23 +++++++++++++++++++
 .../JoinRoomScreen/View/JoinRoomScreen.swift  | 21 ++++++++++++++++-
 3 files changed, 50 insertions(+), 1 deletion(-)

diff --git a/ElementX/Sources/Screens/JoinRoomScreen/JoinRoomScreenModels.swift b/ElementX/Sources/Screens/JoinRoomScreen/JoinRoomScreenModels.swift
index 6209cd4da..a459fff1e 100644
--- a/ElementX/Sources/Screens/JoinRoomScreen/JoinRoomScreenModels.swift
+++ b/ElementX/Sources/Screens/JoinRoomScreen/JoinRoomScreenModels.swift
@@ -136,6 +136,10 @@ struct JoinRoomScreenViewState: BindableState {
 struct JoinRoomScreenViewStateBindings {
     var alertInfo: AlertInfo<JoinRoomScreenAlertType>?
     var knockMessage = ""
+    
+    // FreeChat: kept out of view actions, which are logged.
+    var freechatPassword = ""
+    var isPresentingFreechatPassword = false
 }
 
 enum JoinRoomScreenAlertType {
@@ -144,6 +148,7 @@ enum JoinRoomScreenAlertType {
     case cancelKnock
     case loadingError
     case invalidInvite
+    case freechatPasswordFailed
 }
 
 enum JoinRoomScreenViewAction {
@@ -155,4 +160,6 @@ enum JoinRoomScreenViewAction {
     case declineInviteAndBlock(userID: String)
     case forget
     case dismiss
+    /// FreeChat: join with the password in the bindings.
+    case freechatJoinWithPassword
 }
diff --git a/ElementX/Sources/Screens/JoinRoomScreen/JoinRoomScreenViewModel.swift b/ElementX/Sources/Screens/JoinRoomScreen/JoinRoomScreenViewModel.swift
index b24c47a66..42c4cfa0e 100644
--- a/ElementX/Sources/Screens/JoinRoomScreen/JoinRoomScreenViewModel.swift
+++ b/ElementX/Sources/Screens/JoinRoomScreen/JoinRoomScreenViewModel.swift
@@ -85,6 +85,29 @@ class JoinRoomScreenViewModel: JoinRoomScreenViewModelType, JoinRoomScreenViewMo
             actionsSubject.send(.dismiss)
         case .declineInviteAndBlock(let userID):
             Task { await showDeclineAndBlockConfirmationAlert(userID: userID) }
+        case .freechatJoinWithPassword:
+            Task { await joinWithPassword() }
+        }
+    }
+    
+    /// FreeChat: the server invites us when the password is right; then the room is joined normally.
+    private func joinWithPassword() async {
+        let password = state.bindings.freechatPassword
+        state.bindings.freechatPassword = ""
+        guard let api = clientProxy.freechatAPI else { return }
+        let (roomID, _) = source.roomIDAndVia()
+        
+        showLoadingIndicator()
+        let result = await api.inviteWithPassword(roomID: roomID, password: password)
+        hideLoadingIndicator()
+        
+        switch result {
+        case .success:
+            await joinRoom()
+        case .failure(let error):
+            MXLog.error("FreeChat: joining \(roomID) with a password failed: \(error)")
+            let message = FreeChatStrings.string(error == .rateLimited ? .lockedOut : .wrongPassword)
+            state.bindings.alertInfo = .init(id: .freechatPasswordFailed, title: L10n.dialogTitleError, message: message)
         }
     }
     
diff --git a/ElementX/Sources/Screens/JoinRoomScreen/View/JoinRoomScreen.swift b/ElementX/Sources/Screens/JoinRoomScreen/View/JoinRoomScreen.swift
index 02940f891..d73326160 100644
--- a/ElementX/Sources/Screens/JoinRoomScreen/View/JoinRoomScreen.swift
+++ b/ElementX/Sources/Screens/JoinRoomScreen/View/JoinRoomScreen.swift
@@ -38,6 +38,13 @@ struct JoinRoomScreen: View {
             bottomContent
         }
         .alert(item: $context.alertInfo)
+        .alert(FreeChatStrings.string(.joinWithPassword), isPresented: $context.isPresentingFreechatPassword) {
+            SecureField(FreeChatStrings.string(.passwordPlaceholder), text: $context.freechatPassword)
+            Button(L10n.actionJoin) { context.send(viewAction: .freechatJoinWithPassword) }
+            Button(L10n.actionCancel, role: .cancel) { context.freechatPassword = "" }
+        } message: {
+            Text(FreeChatStrings.string(.joinWithPasswordMessage))
+        }
         .background()
         .backgroundStyle(.compound.bgCanvasDefault)
         .toolbarRole(RoomHeaderView.toolbarRole)
@@ -183,7 +190,10 @@ struct JoinRoomScreen: View {
             Button(L10n.screenJoinRoomCancelKnockAction) { context.send(viewAction: .cancelKnock) }
                 .buttonStyle(.compound(.secondary))
         case .inviteRequired:
-            bottomNoticeMessage(L10n.screenJoinRoomInviteRequiredMessage)
+            VStack(spacing: 24) {
+                bottomNoticeMessage(L10n.screenJoinRoomInviteRequiredMessage)
+                freechatPasswordButton
+            }
         case .invited:
             ViewThatFits {
                 VStack(spacing: 24) {
@@ -220,6 +230,7 @@ struct JoinRoomScreen: View {
     private var forbiddenView: some View {
         VStack(spacing: 24) {
             bottomErrorMessage(title: L10n.screenJoinRoomFailMessage, subtitle: L10n.screenJoinRoomFailReason)
+            freechatPasswordButton
             Button(L10n.actionOk) {
                 context.send(viewAction: .dismiss)
             }
@@ -227,6 +238,14 @@ struct JoinRoomScreen: View {
         }
     }
     
+    /// FreeChat: private rooms can be joined with a password.
+    private var freechatPasswordButton: some View {
+        Button(FreeChatStrings.string(.joinWithPassword)) {
+            context.isPresentingFreechatPassword = true
+        }
+        .buttonStyle(.compound(.secondary))
+    }
+    
     func bottomNoticeMessage(_ notice: String) -> some View {
         Label(notice, icon: \.info)
             .labelStyle(.custom(spacing: 12, alignment: .top))
