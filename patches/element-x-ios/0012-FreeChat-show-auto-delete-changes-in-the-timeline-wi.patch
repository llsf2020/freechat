         case strictSection, strictTitle, strictFooter, strictOn, strictOffPending, strictIdle
         case strictConfirmTitle, strictConfirmMessage, strictConfirmButton, strictTurnOff
         case screenshotTaken, screenshotTakenMessage, screenHidden
+        case autoDeleteChanged, autoDeleteChangedByYou, autoDeleteSet, autoDeleteSetByYou
+        case autoDeleteTurnedOff, autoDeleteTurnedOffByYou
     }
 
     static func string(_ key: Key) -> String {
         table[key] ?? english[key] ?? key.rawValue
     }
 
+    /// The timeline notice for a change of the room's auto-delete TTL; `ttl` is nil when unknown.
+    static func autoDeleteChange(ttl: UInt64?, sender: String, isOutgoing: Bool) -> String {
+        let key: Key = switch (ttl, isOutgoing) {
+        case (nil, true): .autoDeleteChangedByYou
+        case (nil, false): .autoDeleteChanged
+        case (0, true): .autoDeleteTurnedOffByYou
+        case (0, false): .autoDeleteTurnedOff
+        case (_, true): .autoDeleteSetByYou
+        case (_, false): .autoDeleteSet
+        }
+        // The duration first, so a display name containing "{duration}" stays as it is.
+        return string(key)
+            .replacingOccurrences(of: "{duration}", with: duration(ttl ?? 0))
+            .replacingOccurrences(of: "{name}", with: sender)
+    }
+
     /// A duration in seconds as the largest whole unit, e.g. "5 minutes".
     static func duration(_ seconds: UInt64) -> String {
         guard seconds > 0 else { return string(.off) }
