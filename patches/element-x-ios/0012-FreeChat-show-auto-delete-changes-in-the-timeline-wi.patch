+    @Test
+    func roomTTLFromWholeEvent() {
+        #expect(FreeChat.roomTTL(fromEventJSON: #"{"type":"com.freechat.disappearing","content":{"ttl":3600}}"#) == 3600)
+        #expect(FreeChat.roomTTL(fromEventJSON: #"{"type":"com.freechat.disappearing","content":{}}"#) == 0)
+        #expect(FreeChat.roomTTL(fromEventJSON: #"{"type":"com.freechat.disappearing"}"#) == nil)
+        #expect(FreeChat.roomTTL(fromEventJSON: nil) == nil)
+    }
+
+    @Test
+    func autoDeleteNoticeNamesTheSenderAndDuration() {
+        let set = FreeChatStrings.autoDeleteChange(ttl: 3600, sender: "Alice", isOutgoing: false)
+        #expect(set.contains("Alice"))
+        #expect(set.contains(FreeChatStrings.duration(3600)))
+        #expect(!FreeChatStrings.autoDeleteChange(ttl: 3600, sender: "Alice", isOutgoing: true).contains("Alice"))
+        #expect(FreeChatStrings.autoDeleteChange(ttl: 0, sender: "Alice", isOutgoing: false) != set)
+        #expect(FreeChatStrings.autoDeleteChange(ttl: nil, sender: "Alice", isOutgoing: false) != set)
+        // Placeholders in a display name are left alone.
+        #expect(FreeChatStrings.autoDeleteChange(ttl: 60, sender: "{duration}", isOutgoing: false).contains("{duration}"))
+    }
+
