From 86b644d6471010b01c11004b82fd9b1aa81eccad Mon Sep 17 00:00:00 2001
From: sjcsf <346224915+llsf2020@users.noreply.github.com>
Date: Fri, 23 Oct 2026 00:00:00 +0000
Subject: [PATCH 12/12] FreeChat: show auto-delete changes in the timeline,
 with the duration

Custom state events were filtered out of the timeline. Changes of
com.freechat.disappearing are now shown, with the TTL read from the event's
original JSON since the SDK drops the content of custom state events.
---
 ElementX/Sources/FreeChat/FreeChat.swift      |  7 ++++
 .../Sources/FreeChat/FreeChatStrings.swift    | 42 +++++++++++++++++--
 .../RoomTimelineItemFactory.swift             |  7 ++++
 UnitTests/Sources/FreeChatTests.swift         | 20 +++++++++
 4 files changed, 73 insertions(+), 3 deletions(-)

diff --git a/ElementX/Sources/FreeChat/FreeChat.swift b/ElementX/Sources/FreeChat/FreeChat.swift
index 19c47ac36..175efddeb 100644
--- a/ElementX/Sources/FreeChat/FreeChat.swift
+++ b/ElementX/Sources/FreeChat/FreeChat.swift
@@ -29,6 +29,13 @@ nonisolated enum FreeChat {
         nonNegative(object(from: json)?["ttl"]) ?? 0
     }
 
+    /// The TTL from a whole `com.freechat.disappearing` event's JSON: the SDK drops the content of custom state events
+    /// from timeline items but keeps the original JSON. Nil when there is no content.
+    static func roomTTL(fromEventJSON json: String?) -> UInt64? {
+        guard let content = object(from: json)?["content"] as? [String: Any] else { return nil }
+        return nonNegative(content["ttl"]) ?? 0
+    }
+
     static func contentJSON(forRoomTTL ttl: UInt64) -> String {
         "{\"ttl\":\(ttl)}"
     }
