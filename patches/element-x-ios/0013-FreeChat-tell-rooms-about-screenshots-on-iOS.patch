 .../Sources/FreeChat/FreeChatStrings.swift    |  5 ++-
 .../ThreadTimelineScreenCoordinator.swift     |  5 ++-
 3 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/ElementX/Sources/FreeChat/FreeChatScreenProtection.swift b/ElementX/Sources/FreeChat/FreeChatScreenProtection.swift
