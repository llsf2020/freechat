--- a/ElementX/Sources/FreeChat/FreeChatScreenProtection.swift
+++ b/ElementX/Sources/FreeChat/FreeChatScreenProtection.swift
@@ -9,9 +9,16 @@ import Compound
 import SwiftUI
 
 /// Whether a room asks for screenshot protection: the room setting, or the user's own setting for every chat.
+/// Also tells the room when a screenshot is taken where that matters, since iOS cannot block them.
 @Observable
 final class FreeChatScreenPolicy {
     private(set) var isProtected = false
+    /// The room has auto-delete on.
+    private(set) var autoDeletes = false
+
+    /// At most one screenshot notice per room in this time, so a burst of screenshots does not flood it.
+    static let screenshotNoticeInterval: TimeInterval = 30
+    private static var lastScreenshotNotice: [String: Date] = [:]
 
     private let roomProxy: JoinedRoomProxyProtocol
     private let clientProxy: ClientProxyProtocol
@@ -30,12 +37,33 @@ final class FreeChatScreenPolicy {
             protected = FreeChat.personal(fromContentJSON: json).blockScreenshots
         }
         isProtected = protected
+        if case .success(let json) = await roomProxy.freechatStateContent(type: FreeChat.disappearingStateType) {
+            autoDeletes = FreeChat.roomTTL(fromContentJSON: json) > 0
+        }
+    }
+
+    /// In a protected room or one with auto-delete, sends "* Alice took a screenshot" as an emote that every
+    /// client shows and that expires like the other messages.
+    func screenshotTaken(now: Date = .now) {
+        guard isProtected || autoDeletes else { return }
+        let roomID = roomProxy.id
+        if let last = Self.lastScreenshotNotice[roomID], now.timeIntervalSince(last) < Self.screenshotNoticeInterval { return }
+        Self.lastScreenshotNotice[roomID] = now
+        let timeline = roomProxy.timeline
+        Task {
+            if case .failure(let error) = await timeline.sendMessage("/me " + FreeChatStrings.string(.screenshotAlert),
+                                                                     html: nil,
+                                                                     inReplyToEventID: nil,
+                                                                     intentionalMentions: .empty) {
+                MXLog.error("FreeChat: could not tell the room about a screenshot: \(error)")
+            }
+        }
     }
 }
 
 extension View {
     /// iOS cannot block screenshots. Instead the content is hidden while the screen is recorded or mirrored,
-    /// and taking a screenshot shows a warning.
+    /// taking a screenshot shows a warning, and the room is told about it (see `FreeChatScreenPolicy`).
     func freechatScreenProtection(_ policy: FreeChatScreenPolicy?) -> some View {
         modifier(FreeChatScreenProtectionModifier(policy: policy))
     }
@@ -71,6 +99,7 @@ private struct FreeChatScreenProtectionModifier: ViewModifier {
             }
             .onReceive(NotificationCenter.default.publisher(for: UIApplication.userDidTakeScreenshotNotification)) { _ in
                 if isProtected { showsScreenshotWarning = true }
+                policy?.screenshotTaken()
             }
             .alert(FreeChatStrings.string(.screenshotTaken), isPresented: $showsScreenshotWarning) {
                 Button(FreeChatStrings.string(.cancel), role: .cancel) { }
